<style>
  @keyframes announcement-ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .announcement-bar__ticker { display: contents; }

  .announcement-bar {
    background: var(--cm-navy);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 72px;
    height: 38px;
    position: relative;
  }

  .announcement-bar__message {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.18em;
    color: rgba(255,255,255,0.65);
    white-space: nowrap;
    font-family: var(--cm-font-sans);
    font-weight: 300;
  }

  .announcement-bar__message em {
    color: var(--cm-gold-h);
    font-style: normal;
    font-weight: 400;
  }

  @media (max-width: 767px) {
    .announcement-bar { padding: 0; justify-content: center; overflow: hidden; }
    .announcement-bar__message {
      position: static; transform: none;
      font-size: 10px; letter-spacing: 0.12em;
      white-space: nowrap; overflow: hidden; width: 100%;
    }
    .announcement-bar__ticker {
      display: inline-block;
      white-space: nowrap;
      padding-left: 20px;
      animation: announcement-ticker 18s linear infinite;
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .announcement-bar__ticker { animation: none; padding-left: 0; }
    .announcement-bar__message { text-align: center; overflow: visible; }
  }
</style>

{%- if section.settings.show_announcement -%}
  {%- assign country = localization.country.iso_code -%}
  {%- assign is_peninsula = false -%}
  {%- if country == 'ES' or country == 'PT' -%}
    {%- assign is_peninsula = true -%}
  {%- endif -%}

  {%- if is_peninsula -%}
    {%- assign bar_text = section.settings.announcement_text_peninsula -%}
  {%- else -%}
    {%- assign bar_text = section.settings.announcement_text_exterior -%}
  {%- endif -%}

<div class="announcement-bar" role="complementary" aria-label="{{ 'general.announcement_bar.label' | t }}">
  <p class="announcement-bar__message">
    <span class="announcement-bar__ticker">
      <span>{{ bar_text }}</span>
      <span aria-hidden="true">&nbsp;&nbsp;·&nbsp;&nbsp;{{ bar_text }}</span>
    </span>
  </p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Mostrar barra de anuncio",
      "default": true
    },
    {
      "type": "html",
      "id": "announcement_text_peninsula",
      "label": "Texto — Península (España y Portugal)",
      "default": "Envío gratis a partir de <em>€80</em> &nbsp;·&nbsp; Entrega en 24–72h &nbsp;·&nbsp; Ibéricos Seleccionados"
    },
    {
      "type": "html",
      "id": "announcement_text_exterior",
      "label": "Texto — Exterior (resto del mundo)",
      "default": "Envío internacional disponible &nbsp;·&nbsp; Entrega en 3–5 días &nbsp;·&nbsp; Ibéricos Seleccionados"
    }
  ],
  "presets": [
    {
      "name": "Barra de anuncio"
    }
  ]
}
{% endschema %}
