{% comment %}
  video-banner.liquid
  Banner plano con vídeo (sin botones). Vídeo subido a Shopify (Contenido > Archivos)
  y, opcionalmente, imagen de respaldo/póster y un titular superpuesto.
{% endcomment %}

<style>
  .vb-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ section.settings.height_mobile }}svh;
    min-height: 260px;
    overflow: hidden;
    background: var(--cm-navy);
  }

  @media (min-width: 768px) {
    .vb-{{ section.id }} { height: {{ section.settings.height_desktop }}svh; }
  }

  .vb__media-{{ section.id }},
  .vb__media-{{ section.id }} video,
  .vb__media-{{ section.id }} img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.pos_x }}% {{ section.settings.pos_y }}%;
  }

  .vb__overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    /* Degradado oscuro con tono dorado (más fuerte abajo) + velo negro uniforme */
    background:
      linear-gradient(180deg,
        rgba(70, 44, 6, {{ section.settings.tint_strength | divided_by: 200.0 }}) 0%,
        rgba(110, 72, 12, {{ section.settings.tint_strength | divided_by: 100.0 }}) 100%),
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .vb__content-{{ section.id }} {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
    color: var(--cm-white);
  }

  .vb__eyebrow-{{ section.id }} {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin-bottom: 14px;
  }

  .vb__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-weight: 400;
    font-size: clamp(34px, 6vw, 72px);
    line-height: 1.05;
    margin: 0;
  }
</style>

<section class="vb-{{ section.id }}" aria-label="{{ section.settings.heading | escape }}">
  <div class="vb__media-{{ section.id }}">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag:
          image_size: '1920x',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata'
      }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '800, 1200, 1600, 2400', sizes: '100vw', alt: section.settings.heading | escape }}
    {%- endif -%}
  </div>

  <div class="vb__overlay-{{ section.id }}"></div>

  {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <div class="vb__content-{{ section.id }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vb__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="vb__heading-{{ section.id }}">{{ section.settings.heading }}</h1>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner con vídeo",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo",
      "info": "Sube el vídeo en Shopify (se reproduce solo, en bucle y sin sonido). Mejor MP4 corto y ligero."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de respaldo",
      "info": "Se muestra si no hay vídeo."
    },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "Listo para disfrutar" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Loncheados Ibéricos" },
    { "type": "range", "id": "overlay_opacity", "label": "Oscurecer imagen/vídeo", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "range", "id": "tint_strength", "label": "Degradado dorado", "info": "Oscurece con un tono dorado, más intenso hacia abajo.", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "height_desktop", "label": "Alto en escritorio", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "range", "id": "height_mobile", "label": "Alto en móvil", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 45 },
    { "type": "range", "id": "pos_x", "label": "Encuadre horizontal", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "pos_y", "label": "Encuadre vertical", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 }
  ],
  "presets": [
    { "name": "Banner con vídeo" }
  ]
}
{% endschema %}
