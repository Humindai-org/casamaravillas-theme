<style>
  .newsletter-section {
    background: var(--cm-navy);
    padding: 100px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .newsletter-section__seal {
    border: 1.5px solid var(--cm-gold);
    max-width: 480px;
    width: 100%;
    padding: 56px 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .newsletter-section__seal::before,
  .newsletter-section__seal::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(196, 151, 58, 0.22);
    pointer-events: none;
  }

  .newsletter-section__seal::after {
    inset: 10px;
    border-color: rgba(196, 151, 58, 0.1);
  }

  .newsletter-section__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.52em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin-bottom: 20px;
  }

  .newsletter-section__divider {
    width: 48px;
    height: 1px;
    background: rgba(196, 151, 58, 0.45);
    margin: 0 auto 24px;
  }

  .newsletter-section__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(20px, 2.8vw, 28px);
    font-weight: 400;
    color: white;
    line-height: 1.35;
    margin-bottom: 16px;
  }

  .newsletter-section__title em { font-style: italic; }

  .newsletter-section__body {
    font-family: var(--cm-font-sans);
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 340px;
  }

  .newsletter-section__btn {
    display: inline-block;
    padding: 14px 36px;
    background: var(--cm-gold);
    color: white;
    border: none;
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.3s;
  }

  .newsletter-section__btn:hover { background: var(--cm-gold-h); }

  .newsletter-section__btn:focus-visible {
    outline: 2px solid white;
    outline-offset: 3px;
  }

  .newsletter-section__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .newsletter-section__input {
    width: 100%;
    padding: 13px 16px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: white;
    font-family: var(--cm-font-sans);
    font-size: 13px;
    box-sizing: border-box;
  }

  .newsletter-section__input::placeholder { color: rgba(255, 255, 255, 0.45); }

  .newsletter-section__input:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .newsletter-section__success,
  .newsletter-section__error {
    font-family: var(--cm-font-sans);
    font-size: 12px;
    margin-top: 4px;
  }

  .newsletter-section__success { color: var(--cm-gold); }
  .newsletter-section__error { color: #e7a1a1; }

  .newsletter-section__legal {
    font-family: var(--cm-font-sans);
    font-size: 11px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  .newsletter-section__legal a {
    color: inherit;
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .newsletter-section { padding: 72px 24px; }
    .newsletter-section__seal { padding: 48px 28px; }
  }
</style>

<section class="newsletter-section">
  <div class="newsletter-section__seal">
    <p class="newsletter-section__eyebrow">{{ section.settings.eyebrow | default: 'Club Casa Maravillas' }}</p>
    <div class="newsletter-section__divider"></div>
    <h2 class="newsletter-section__title">{{ section.settings.title | default: 'Curado por tres generaciones. <em>Recibido por la tuya.</em>' }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="newsletter-section__body">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.incentive_code != blank -%}
      <p class="newsletter-section__body" style="margin-top: -16px; margin-bottom: 24px; color: var(--cm-gold);">
        {{ section.settings.incentive_text | default: 'Código de bienvenida' }}: <strong>{{ section.settings.incentive_code }}</strong>
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'newsletter-form', class: 'newsletter-section__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="hidden" name="contact[accepts_marketing]" value="1">
      <label for="newsletter-email" class="visually-hidden">Correo electrónico</label>
      <input
        type="email"
        name="contact[email]"
        id="newsletter-email"
        class="newsletter-section__input"
        value="{{ form.email }}"
        placeholder="Tu correo electrónico"
        required
      >
      <button type="submit" class="newsletter-section__btn">
        {{ section.settings.cta_label | default: 'Unirme al club' }}
      </button>
      <p class="newsletter-section__legal">
        Al suscribirte aceptas recibir comunicaciones comerciales de Casa Maravillas y nuestra
        <a href="/pages/privacidad">Política de privacidad</a>. Puedes darte de baja cuando quieras.
      </p>

      {%- if form.posted_successfully? -%}
        <p class="newsletter-section__success">
          {{ section.settings.success_text | default: '¡Gracias por suscribirte! Te escribiremos pronto.' }}
        </p>
      {%- endif -%}
      {%- if form.errors -%}
        <p class="newsletter-section__error">{{ form.errors.messages['email'] | default: 'Revisa el correo e inténtalo de nuevo.' }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Club Casa Maravillas"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Suscríbete al placer de lo <em>auténtico.</em></p>"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Descripción",
      "default": "En Casa Maravillas seleccionamos por ti solo lo mejor. Recíbelo en casa, en el momento justo, con la calidad que nos define."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Quiero suscribirme"
    },
    {
      "type": "text",
      "id": "incentive_text",
      "label": "Texto del incentivo (opcional)",
      "default": "Código de bienvenida"
    },
    {
      "type": "text",
      "id": "incentive_code",
      "label": "Código de descuento a mostrar (opcional, se crea en Shopify Admin > Descuentos)"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Mensaje de confirmación",
      "default": "¡Gracias por suscribirte! Te escribiremos pronto."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
