{%- comment -%}
  Nosotros — El criterio
  Seis capítulos visuales, no seis tarjetas. Cada bloque elige su propio
  tamaño de imagen (solo texto, retrato, panorámica o detalle), si el lado
  alterna automáticamente o se fija a mano, y admite una o dos imágenes
  (la segunda se muestra en pareja junto a la primera, ambas al mismo tamaño).
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{% render 'cm-reveal' %}

<style>
  #cri-{{ section.id }} {
    background: {% if s.theme == 'dark' %}var(--cm-navy){% else %}var(--cm-white){% endif %};
    --cri-ink:   {% if s.theme == 'dark' %}var(--cm-off){% else %}var(--cm-navy){% endif %};
    --cri-muted: {% if s.theme == 'dark' %}rgba(250,246,239,0.6){% else %}var(--cm-text-mid){% endif %};
    padding-block: clamp(72px, 10vw, 150px);
    overflow: hidden;
  }

  #cri-{{ section.id }} .cri__wrap {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 72px);
  }

  #cri-{{ section.id }} .cri__head {
    max-width: 30ch;
    margin-bottom: clamp(56px, 9vw, 130px);
  }
  #cri-{{ section.id }} .cri__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 0 0 22px;
  }
  #cri-{{ section.id }} .cri__title {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(28px, 3.8vw, 54px);
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--cri-ink);
    margin: 0;
    text-wrap: balance;
  }
  #cri-{{ section.id }} .cri__title em { font-style: italic; color: var(--cm-gold); }

  /* ── Capítulos ── */
  #cri-{{ section.id }} .cri__items {
    display: grid;
    gap: clamp(64px, 11vw, 168px);
  }

  #cri-{{ section.id }} .cri__item {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 44px);
    row-gap: clamp(24px, 3vw, 40px);
    align-items: center;
  }

  #cri-{{ section.id }} .cri__num {
    display: block;
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(34px, 4.5vw, 62px);
    line-height: 1;
    color: var(--cm-gold);
    opacity: 0.55;
    margin-bottom: 18px;
    font-variant-numeric: tabular-nums;
  }

  #cri-{{ section.id }} .cri__name {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(24px, 2.9vw, 40px);
    line-height: 1.16;
    color: var(--cri-ink);
    margin: 0 0 18px;
    text-wrap: balance;
  }

  #cri-{{ section.id }} .cri__line {
    font-family: var(--cm-font-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--cri-muted);
    margin: 0;
    max-width: 44ch;
  }
  #cri-{{ section.id }} .cri__line p { margin: 0 0 1.1em; }
  #cri-{{ section.id }} .cri__line p:last-child { margin-bottom: 0; }

  #cri-{{ section.id }} .cri__meta {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 22px 0 0;
  }

  #cri-{{ section.id }} .cri__media img,
  #cri-{{ section.id }} .cri__media2 img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #cri-{{ section.id }} .cri__media,
  #cri-{{ section.id }} .cri__media2 {
    overflow: hidden;
  }
  #cri-{{ section.id }} .cri__media--dual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(8px, 1vw, 14px);
  }

  /* ── Composiciones ── */

  /* solo texto: columna estrecha, sin imagen */
  #cri-{{ section.id }} .cri--texto .cri__text { grid-column: 2 / span 6; }
  #cri-{{ section.id }} .cri--texto[data-side="right"] .cri__text { grid-column: 6 / span 6; }
  #cri-{{ section.id }} .cri--texto .cri__name { font-size: clamp(28px, 3.6vw, 52px); }

  /* retrato: imagen vertical junto al texto */
  #cri-{{ section.id }} .cri--retrato .cri__media { grid-column: 1 / span 5; aspect-ratio: 3 / 4; }
  #cri-{{ section.id }} .cri--retrato .cri__text  { grid-column: 7 / span 5; }
  #cri-{{ section.id }} .cri--retrato[data-side="right"] .cri__media { grid-column: 8 / span 5; grid-row: 1; }
  #cri-{{ section.id }} .cri--retrato[data-side="right"] .cri__text  { grid-column: 2 / span 5; grid-row: 1; }

  /* panorámica: imagen ancha, texto desplazado debajo */
  #cri-{{ section.id }} .cri--panorama .cri__media { grid-column: 1 / span 12; aspect-ratio: 21 / 9; }
  #cri-{{ section.id }} .cri--panorama .cri__text  { grid-column: 7 / span 5; }
  #cri-{{ section.id }} .cri--panorama[data-side="right"] .cri__text { grid-column: 1 / span 5; }

  /* detalle: imagen pequeña cuadrada, mucho aire */
  #cri-{{ section.id }} .cri--detalle .cri__media { grid-column: 2 / span 3; aspect-ratio: 1 / 1; }
  #cri-{{ section.id }} .cri--detalle .cri__text  { grid-column: 7 / span 5; }
  #cri-{{ section.id }} .cri--detalle[data-side="right"] .cri__media { grid-column: 8 / span 3; grid-row: 1; }
  #cri-{{ section.id }} .cri--detalle[data-side="right"] .cri__text  { grid-column: 2 / span 5; grid-row: 1; }

  /* flanqueo: imagen 1 panorámica arriba, imagen 2 junto al texto debajo */
  #cri-{{ section.id }} .cri--flanqueo .cri__media  { grid-column: 1 / span 12; grid-row: 1; aspect-ratio: 21 / 9; }
  #cri-{{ section.id }} .cri--flanqueo .cri__text   { grid-column: 1 / span 7; grid-row: 2; }
  #cri-{{ section.id }} .cri--flanqueo .cri__media2 { grid-column: 9 / span 4; grid-row: 2; aspect-ratio: 3 / 4; }
  #cri-{{ section.id }} .cri--flanqueo[data-side="right"] .cri__text   { grid-column: 6 / span 7; grid-row: 2; }
  #cri-{{ section.id }} .cri--flanqueo[data-side="right"] .cri__media2 { grid-column: 1 / span 4; grid-row: 2; }

  /* ancho completo: el texto ocupa las 12 columnas, debajo de la imagen si la hay.
     !important porque las reglas de cada composición (p.ej. .cri--texto .cri__text)
     son más específicas que esta al llevar dos clases bajo el mismo id. */
  #cri-{{ section.id }} .cri__text--full { grid-column: 1 / span 12 !important; }
  #cri-{{ section.id }} .cri__item:not(.cri--texto) .cri__text--full { grid-row: 2; }
  #cri-{{ section.id }} .cri__text--full .cri__line { max-width: 70ch; }

  /* ── Cierre ── */
  #cri-{{ section.id }} .cri__close {
    margin-top: clamp(72px, 11vw, 170px);
    text-align: center;
  }
  #cri-{{ section.id }} .cri__close span {
    display: block;
    width: 44px;
    height: 1px;
    background: var(--cm-gold);
    margin: 0 auto 32px;
  }
  #cri-{{ section.id }} .cri__close p {
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(25px, 3.6vw, 50px);
    line-height: 1.25;
    color: var(--cri-ink);
    margin: 0;
    text-wrap: balance;
  }

  @media (max-width: 860px) {
    #cri-{{ section.id }} .cri__items { gap: 56px; }
    #cri-{{ section.id }} .cri__item { grid-template-columns: 1fr; row-gap: 22px; }
    #cri-{{ section.id }} .cri__item .cri__media,
    #cri-{{ section.id }} .cri__item .cri__media2,
    #cri-{{ section.id }} .cri__item .cri__text {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    /* en móvil la imagen siempre va primero; en flanqueo, imagen-texto-imagen */
    #cri-{{ section.id }} .cri__media { order: 1; }
    #cri-{{ section.id }} .cri__text  { order: 2; }
    #cri-{{ section.id }} .cri__media2 { order: 3; }
    #cri-{{ section.id }} .cri--retrato .cri__media { aspect-ratio: 4 / 5; }
    #cri-{{ section.id }} .cri--panorama .cri__media { aspect-ratio: 16 / 9; }
    #cri-{{ section.id }} .cri--detalle .cri__media { aspect-ratio: 4 / 3; }
    #cri-{{ section.id }} .cri--flanqueo .cri__media  { aspect-ratio: 16 / 9; }
    #cri-{{ section.id }} .cri--flanqueo .cri__media2 { aspect-ratio: 4 / 5; }
    #cri-{{ section.id }} .cri__num { margin-bottom: 12px; }
  }

  #cri-{{ section.id }} .cri__anchor {
    display: block;
    height: 0;
    scroll-margin-top: 56px;
  }
</style>

<section id="cri-{{ section.id }}" class="cri">
  {%- if s.anchor != blank -%}<span id="{{ s.anchor }}" class="cri__anchor" aria-hidden="true"></span>{%- endif -%}
  <div class="cri__wrap">

    <header class="cri__head">
      {%- if s.eyebrow != blank -%}
        <p class="cri__eyebrow" data-cm-reveal>{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.title != blank -%}
        <h2 class="cri__title" data-cm-reveal data-cm-delay="1">{{ s.title }}</h2>
      {%- endif -%}
    </header>

    <div class="cri__items">
      {%- for block in section.blocks -%}
        {%- liquid
          assign layout = block.settings.layout
          assign parity = forloop.index0 | modulo: 2
          assign side = 'left'
          if parity == 1
            assign side = 'right'
          endif
          assign img1 = block.settings.image
          assign img2 = block.settings.image_2
          if img1 == blank and img2 != blank
            assign img1 = img2
            assign img2 = blank
          endif
          if img1 == blank
            assign layout = 'texto'
          endif
          assign text_full = false
          case block.settings.text_position
            when 'left'
              assign side = 'left'
            when 'right'
              assign side = 'right'
            when 'full'
              assign text_full = true
          endcase
          assign flanqueo = false
          if img1 != blank and img2 != blank and block.settings.two_image_layout == 'flanqueo'
            assign flanqueo = true
            assign layout = 'flanqueo'
          endif
        -%}
        {%- capture cri_text_block -%}
          <div class="cri__text{% if text_full %} cri__text--full{% endif %}">
            <span class="cri__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.name != blank -%}
              <h3 class="cri__name">{{ block.settings.name }}</h3>
            {%- endif -%}
            {%- if block.settings.line != blank -%}
              <div class="cri__line">{{ block.settings.line }}</div>
            {%- endif -%}
            {%- if block.settings.meta != blank -%}
              <p class="cri__meta">{{ block.settings.meta }}</p>
            {%- endif -%}
          </div>
        {%- endcapture -%}
        <article
          class="cri__item cri--{{ layout }}"
          data-side="{{ side }}"
          data-cm-reveal
          {{ block.shopify_attributes }}
        >
          {%- if flanqueo -%}
            <div class="cri__media">
              {{ img1
                | image_url: width: 2000, format: 'webp'
                | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 860px) 100vw, 1200px',
                    widths: '700, 1100, 1500, 2000',
                    alt: block.settings.name | escape
              }}
            </div>
            {{ cri_text_block }}
            <div class="cri__media2">
              {{ img2
                | image_url: width: 1200, format: 'webp'
                | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 860px) 100vw, 30vw',
                    widths: '400, 600, 900, 1200',
                    alt: block.settings.name | escape
              }}
            </div>
          {%- else -%}
            {%- if layout != 'texto' and img1 != blank -%}
              <div class="cri__media{% if img2 != blank %} cri__media--dual{% endif %}">
                {{ img1
                  | image_url: width: 1600, format: 'webp'
                  | image_tag:
                      loading: 'lazy',
                      sizes: '(max-width: 860px) 100vw, 45vw',
                      widths: '500, 800, 1100, 1600',
                      alt: block.settings.name | escape
                }}
                {%- if img2 != blank -%}
                  {{ img2
                    | image_url: width: 1600, format: 'webp'
                    | image_tag:
                        loading: 'lazy',
                        sizes: '(max-width: 860px) 100vw, 45vw',
                        widths: '500, 800, 1100, 1600',
                        alt: block.settings.name | escape
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}
            {{ cri_text_block }}
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>

    {%- if s.closing != blank -%}
      <div class="cri__close" data-cm-reveal>
        <span aria-hidden="true"></span>
        <p>{{ s.closing }}</p>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Nosotros — El criterio",
  "tag": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "principio",
      "name": "Principio",
      "settings": [
        { "type": "text", "id": "name", "label": "Título", "default": "Origen y raza" },
        {
          "type": "richtext",
          "id": "line",
          "label": "Frase",
          "info": "Puedes usar varios párrafos y negrita.",
          "default": "<p>De qué dehesa viene y qué porcentaje de ibérico tiene.</p>"
        },
        { "type": "text", "id": "meta", "label": "Dato / detalle", "info": "Opcional. En mayúsculas doradas." },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Opcional. Sin imagen, el capítulo queda solo tipográfico." },
        { "type": "image_picker", "id": "image_2", "label": "Imagen 2 (opcional)", "info": "Decide cómo se combina con la primera en «Composición con 2 imágenes», más abajo." },
        {
          "type": "select",
          "id": "two_image_layout",
          "label": "Composición con 2 imágenes",
          "info": "Solo aplica si has añadido una Imagen 2. «Panorámica + junto al texto» sustituye al tamaño de imagen elegido abajo: la Imagen 1 se muestra panorámica arriba y la Imagen 2, más pequeña, junto al texto debajo.",
          "options": [
            { "value": "pareja", "label": "Juntas, en pareja" },
            { "value": "flanqueo", "label": "Imagen 1 panorámica + Imagen 2 junto al texto" }
          ],
          "default": "pareja"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Tamaño de la imagen",
          "info": "Alterna entre composiciones para que no haya dos capítulos iguales. Con dos imágenes en pareja, ambas comparten este mismo tamaño.",
          "options": [
            { "value": "texto", "label": "Solo texto" },
            { "value": "retrato", "label": "Imagen vertical" },
            { "value": "panorama", "label": "Imagen panorámica" },
            { "value": "detalle", "label": "Detalle pequeño" }
          ],
          "default": "retrato"
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posición del texto (y del lado de la imagen)",
          "info": "Automático alterna izquierda/derecha según el orden del capítulo.",
          "options": [
            { "value": "auto", "label": "Automático (alterna)" },
            { "value": "left", "label": "Texto a la izquierda / imagen a la derecha" },
            { "value": "right", "label": "Texto a la derecha / imagen a la izquierda" },
            { "value": "full", "label": "Ancho completo de la sección" }
          ],
          "default": "auto"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Navegación"
    },
    { "type": "text", "id": "anchor", "label": "ID de ancla (para el índice)", "info": "Debe coincidir con el enlace del índice. Déjalo vacío si no se enlaza desde ahí.", "default": "criterio" },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "El criterio Casa Maravillas" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Qué miramos antes de <em>decir que sí</em></p>"
    },
    {
      "type": "text",
      "id": "closing",
      "label": "Frase de cierre",
      "default": "¿Lo pondríamos en nuestra propia mesa?"
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Fondo",
      "options": [
        { "value": "light", "label": "Blanco" },
        { "value": "dark", "label": "Navy" }
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Nosotros — El criterio",
      "blocks": [
        { "type": "principio", "settings": { "name": "Origen y raza", "line": "<p>De qué dehesa viene y qué porcentaje de ibérico tiene. Sin cruces que comprometan el resultado.</p>", "layout": "retrato" } },
        { "type": "principio", "settings": { "name": "Alimentación", "line": "<p>Montanera real: bellota y hierba en libertad durante la última fase de engorde.</p>", "layout": "panorama" } },
        { "type": "principio", "settings": { "name": "Curación", "line": "<p>El tiempo que cada pieza necesita en bodega. Ni un mes menos por acelerar la venta.</p>", "layout": "texto" } },
        { "type": "principio", "settings": { "name": "Conformación y grasa", "line": "<p>La forma de la pieza y cómo está infiltrada la grasa. Se ve mucho antes de probarla.</p>", "layout": "detalle" } },
        { "type": "principio", "settings": { "name": "Aroma, textura y sabor", "line": "<p>La cata. Aquí se confirma o se descarta lo que prometía todo lo anterior.</p>", "layout": "retrato" } },
        { "type": "principio", "settings": { "name": "Rendimiento y regularidad", "line": "<p>Cuánto aprovecha quien la compra, y que la siguiente pieza esté a la misma altura.</p>", "layout": "texto" } }
      ]
    }
  ]
}
{% endschema %}
