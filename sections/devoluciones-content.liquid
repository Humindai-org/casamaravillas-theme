<style>
  .devoluciones-section {
    padding: 80px 72px 96px;
    max-width: 780px;
    margin: 0 auto;
    background: var(--cm-white);
  }

  .devoluciones-section__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 400;
    color: var(--cm-navy);
    margin-bottom: 36px;
    line-height: 1.15;
    text-align: left;
  }

  .devoluciones-section__content {
    font-family: var(--cm-font-sans);
    font-size: 15px;
    line-height: 1.85;
    color: var(--cm-text-mid);
  }

  .devoluciones-section__content h2,
  .devoluciones-section__content h3 {
    font-family: var(--cm-font-serif);
    color: var(--cm-navy);
    margin: 2em 0 0.65em;
    font-size: 1.45em;
    font-weight: 400;
    line-height: 1.2;
    text-align: left;
  }

  .devoluciones-section__content h2:first-child { margin-top: 0; }

  .devoluciones-section__content p { margin-bottom: 1.1em; }

  .devoluciones-section__content a {
    color: var(--cm-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .devoluciones-section__content a:hover { color: var(--cm-gold-h); }

  .devoluciones-section__content ul,
  .devoluciones-section__content ol {
    margin: 0 0 1.2em 1.5em;
    padding-left: 0.25em;
  }

  .devoluciones-section__content ul { list-style: disc; }
  .devoluciones-section__content ol { list-style: decimal; }

  .devoluciones-section__content li { margin-bottom: 0.5em; }

  .devoluciones-section__content strong {
    color: var(--cm-navy);
    font-weight: 600;
  }

  .devoluciones-section__content em {
    font-style: italic;
    color: rgba(0,0,0,0.45);
    font-size: 0.9em;
  }

  .devoluciones-section__notice {
    background: rgba(var(--cm-gold-rgb, 180,140,80), 0.08);
    border-left: 3px solid var(--cm-gold);
    padding: 14px 20px;
    margin: 1.5em 0;
    border-radius: 0 4px 4px 0;
  }

  .devoluciones-section__notice p { margin-bottom: 0; }

  .devoluciones-section__cta {
    display: inline-block;
    margin: 1.25em 0 0.5em;
    padding: 14px 32px;
    background: var(--cm-navy);
    color: var(--cm-white) !important;
    font-family: var(--cm-font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none !important;
    border-radius: 2px;
    transition: background 0.2s, transform 0.15s;
  }

  .devoluciones-section__cta:hover {
    background: var(--cm-gold);
    color: var(--cm-white) !important;
    transform: translateY(-1px);
  }

  .devoluciones-section__cta:active {
    transform: translateY(0);
  }


  .devoluciones-section__form {
    margin: 1.5em 0;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 4px;
    background: var(--cm-white);
  }

  .devoluciones-section__form summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    font-family: var(--cm-font-serif);
    font-size: 1.15em;
    color: var(--cm-navy);
    border-radius: 4px;
  }

  .devoluciones-section__form summary::-webkit-details-marker { display: none; }

  .devoluciones-section__form summary::after {
    content: '+';
    font-family: var(--cm-font-sans);
    font-size: 1.4em;
    line-height: 1;
    color: var(--cm-gold);
    flex-shrink: 0;
  }

  .devoluciones-section__form[open] summary::after { content: '\2212'; }

  .devoluciones-section__form summary:hover { color: var(--cm-gold); }

  .devoluciones-section__form summary:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .devoluciones-section__form-body {
    padding: 4px 20px 20px;
    border-top: 1px solid rgba(0,0,0,0.08);
  }

  .devoluciones-section__form-body p { margin: 1em 0 0; }

  .devoluciones-section__form-fields {
    list-style: none !important;
    margin: 1em 0 0 !important;
    padding: 0 !important;
  }

  .devoluciones-section__form-fields li {
    padding: 10px 0;
    border-bottom: 1px dashed rgba(0,0,0,0.25);
    margin: 0;
  }

  @media (max-width: 1023px) {
    .devoluciones-section { padding: 64px 48px 80px; }
  }

  @media (max-width: 767px) {
    .devoluciones-section { padding: 48px 24px 72px; }
    .devoluciones-section__title { margin-bottom: 24px; }
  }
</style>

<section class="devoluciones-section">
  <h1 class="devoluciones-section__title">{{ 'cm.dev.devoluciones' | t }}</h1>
  <div class="devoluciones-section__content">

    <p>{{ 'cm.dev.en_casa_maravillas_cuidamos' | t }}</p>

    <h2>{{ 'cm.dev.derecho_de_desistimiento' | t }}</h2>
    <p>{{ 'cm.dev.de_acuerdo_con_el_html' | t }}</p>
    <p>{{ 'cm.dev.sin_embargo_y_de_html' | t }}</p>
    <ul>
      <li>{{ 'cm.dev.productos_alimenticios_perecederos_o' | t }}</li>
      <li>{{ 'cm.dev.productos_sellados_que_por' | t }}</li>
    </ul>
    <p>{{ 'cm.dev.para_los_productos_curados' | t }}</p>

    <h2>{{ 'cm.dev.como_ejercer_el_desistimiento' | t }}</h2>
    <p>{{ 'cm.dev.puedes_iniciar_tu_solicitud' | t }}</p>
    <a href="/account/orders" class="devoluciones-section__cta">{{ 'cm.dev.iniciar_devolucion_en_mi' | t }}</a>
    <p>{{ 'cm.dev.accede_a_tu_pedido_html' | t }}</p>
    <details class="devoluciones-section__form">
      <summary>{{ 'cm.dev.modelo_de_formulario_de' | t }}</summary>
      <div class="devoluciones-section__form-body">
        <p>{{ 'cm.dev.solo_debe_cumplimentar_y_html' | t }}</p>
        <p>{{ 'cm.dev.a_la_atencion_de_html' | t }}</p>
        <p>{{ 'cm.dev.por_la_presente_le' | t }}</p>
        <ul class="devoluciones-section__form-fields">
          <li>{{ 'cm.dev.pedido_el_recibido_el' | t }}</li>
          <li>{{ 'cm.dev.nombre_del_consumidor_o' | t }}</li>
          <li>{{ 'cm.dev.domicilio_del_consumidor_o' | t }}</li>
          <li>{{ 'cm.dev.firma_del_consumidor_o' | t }}</li>
          <li>{{ 'cm.dev.fecha' | t }}</li>
        </ul>
        <p>{{ 'cm.dev.campos_obligatorios_html' | t }}</p>
      </div>
    </details>
    <p>{{ 'cm.dev.una_vez_recibida_tu' | t }}</p>
    <p>{{ 'cm.dev.deberas_devolvernos_el_producto_html' | t }}</p>

    <h2>{{ 'cm.dev.producto_defectuoso_en_mal' | t }}</h2>
    <p>{{ 'cm.dev.si_recibes_un_producto_html' | t }}</p>
    <p>{{ 'cm.dev.como_proceder_html' | t }}</p>
    <ol>
      <li>{{ 'cm.dev.escribenos_a_info_casamaravillas_html' | t }}</li>
      <li>{{ 'cm.dev.indica_tu_numero_de' | t }}</li>
      <li>{{ 'cm.dev.adjunta_fotografias_del_producto' | t }}</li>
      <li>{{ 'cm.dev.nuestro_equipo_valorara_el_html' | t }}</li>
    </ol>
    <p>{{ 'cm.dev.segun_el_tipo_de' | t }}</p>
    <div class="devoluciones-section__notice">
      <p>{{ 'cm.dev.para_jamones_enteros_para_html' | t }}</p>
    </div>

    <h2>{{ 'cm.dev.productos_no_aceptados_para' | t }}</h2>
    <p>{{ 'cm.dev.no_se_tramitan_devoluciones' | t }}</p>
    <ul>
      <li>{{ 'cm.dev.productos_alimenticios_cuyo_precinto' | t }}</li>
      <li>{{ 'cm.dev.productos_danados_como_consecuencia' | t }}</li>
    </ul>

    <h2>{{ 'cm.dev.reembolsos' | t }}</h2>
    <p>{{ 'cm.dev.los_reembolsos_se_procesan_html' | t }}</p>

    <h2>{{ 'cm.dev.necesitas_ayuda' | t }}</h2>
    <p>{{ 'cm.dev.para_gestionar_una_devolucion' | t }}</p>
    <a href="/account/orders" class="devoluciones-section__cta">{{ 'cm.dev.ver_mis_pedidos' | t }}</a>
    <p>{{ 'cm.dev.si_tienes_una_incidencia_html' | t }}<br>
      {{ 'cm.dev.horario_de_atencion_lunes' | t }}
    </p>

  </div>
</section>

{% schema %}
{
  "name": "Devoluciones y Reembolsos",
  "tag": "section"
}
{% endschema %}
