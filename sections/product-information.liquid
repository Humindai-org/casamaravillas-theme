{% comment %}
  product-information.liquid — Sección de información del producto
  Información nutricional y conservación/consumo

  ICON CONFIGURATION:
  To change icons, modify these values at the top of the section:
  Available icons: info_nutricional.svg, icon-consumo.svg, icon-origen.svg, formato.svg,
                   icon-envio.svg, icon-garantia.svg, icon-conservacion.svg, icon-peso.svg, etc.
{% endcomment %}

{%- assign icon_card1 = section.settings.card1_icon -%}
{%- assign icon_card2 = section.settings.card2_icon -%}

<style>
  /* ── LUXURY PALETTE — warm neutrals with sophisticated accents ── */
  :root {
    --bg-primary: #FAFAF8;
    --bg-secondary: #F5F0E8;
    --bg-card: rgba(255, 255, 255, 0.65);
    --text-primary: #1A1410;
    --text-secondary: #8B7F76;
    --accent-gold: #C9A84C;
    --accent-line: #E8DFD3;
    --shadow-dark: rgba(26, 20, 16, 0.04);
    --shadow-warm: rgba(201, 168, 76, 0.08);
  }

  .cm-info-section {
    width: 100%;
    background: linear-gradient(135deg, var(--bg-primary) 0%, #FBF9F6) 100%;
    padding: 80px 24px 120px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .cm-info-section::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(201, 168, 76, 0.03) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .cm-info-section__inner {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .cm-info-section__inner {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }

  /* ── HEADLINE SECTION ── */
  .cm-info-headline {
    padding-top: 20px;
  }

  .cm-info-eyebrow {
    display: block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--accent-gold);
    margin-bottom: 24px;
  }

  .cm-info-title {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0 0 32px;
    line-height: 1.15;
  }

  .cm-info-title em {
    font-style: italic;
    color: var(--accent-gold);
    font-weight: 400;
  }

  .cm-info-body {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
    max-width: 520px;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* ── RIGHT COLUMN WITH IMAGE & CARDS ── */
  .cm-info-right {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .cm-info-image-container {
    position: absolute;
    top: 0;
    right: -580px;
    width: 520px;
    height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .cm-info-image-container img {
    width: 100%;
    height: auto;
    object-fit: contain;
    animation: slideInDiagonal 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: drop-shadow(-15px 25px 50px rgba(26, 20, 16, 0.2))
            drop-shadow(-8px 15px 30px rgba(26, 20, 16, 0.1))
            drop-shadow(-4px 8px 15px rgba(201, 168, 76, 0.08))
            brightness(1.05)
            saturate(1.08);
  }

  @keyframes slideInDiagonal {
    from {
      opacity: 0;
      transform: translateX(180px) translateY(-60px) rotate(12deg) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateX(0) translateY(0) rotate(0deg) scale(1);
    }
  }

  @media (max-width: 1024px) {
    .cm-info-image-container {
      width: 380px;
      right: -420px;
    }
  }

  @media (max-width: 768px) {
    .cm-info-section__inner {
      grid-template-columns: 1fr;
    }

    .cm-info-image-container {
      position: relative;
      right: auto;
      width: 100%;
      margin-top: 40px;
    }
  }

  /* ── CARDS LAYOUT ── */
  .cm-info-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 768px) {
    .cm-info-cards {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .cm-info-card {
    background: var(--bg-card);
    backdrop-filter: blur(10px);
    padding: 40px;
    border-radius: 2px;
    border: 1px solid rgba(232, 223, 211, 0.4);
    box-shadow: 0 8px 24px var(--shadow-dark), 0 0 1px var(--shadow-warm);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    position: relative;
  }

  .cm-info-card:hover {
    background: rgba(255, 255, 255, 0.75);
    box-shadow: 0 12px 32px rgba(26, 20, 16, 0.08), 0 2px 8px var(--shadow-warm);
    transform: translateY(-2px);
  }

  .cm-info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .cm-info-card:hover::before {
    opacity: 1;
  }

  .cm-info-card__icon {
    display: none;
  }

  .cm-info-card__title {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--text-primary);
    margin: 0 0 28px;
    letter-spacing: -0.01em;
  }

  .cm-info-card__rows {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .cm-info-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0;
    border-bottom: none;
  }

  .cm-info-card__row:not(:last-child) {
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(232, 223, 211, 0.5);
  }

  .cm-info-card__label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    color: var(--text-secondary);
    flex: 1;
  }

  .cm-info-card__value {
    font-size: 17px;
    font-weight: 500;
    color: var(--text-primary);
    text-align: right;
  }

  .cm-info-card__subtitle {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-secondary);
    margin: 0 0 20px;
    font-style: italic;
  }

  .cm-info-card__more-btn {
    display: inline-block;
    margin-top: 28px;
    background: none;
    border: none;
    color: var(--accent-gold);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.5px;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    position: relative;
  }

  .cm-info-card__more-btn::after {
    content: ' →';
    transition: transform 0.3s ease;
  }

  .cm-info-card__more-btn:hover {
    color: var(--text-primary);
  }

  .cm-info-card__more-btn:hover::after {
    transform: translateX(4px);
  }

  .cm-info-card__additional-text {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(232, 223, 211, 0.5);
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  /* ── MODAL STYLES — LUXURY ── */
  .cm-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(26, 20, 16, 0.4);
    backdrop-filter: blur(4px);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .cm-modal.active {
    display: flex;
    animation: fadeIn 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      backdrop-filter: blur(0);
    }
    to {
      opacity: 1;
      backdrop-filter: blur(4px);
    }
  }

  .cm-modal__content {
    background: var(--bg-primary);
    border-radius: 2px;
    max-width: 700px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 60px;
    position: relative;
    box-shadow: 0 20px 80px rgba(26, 20, 16, 0.15);
    border: 1px solid var(--accent-line);
    animation: slideUp 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .cm-modal__header {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: 32px;
    font-weight: 400;
    margin-bottom: 40px;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .cm-modal__section {
    margin-bottom: 40px;
  }

  .cm-modal__section:last-child {
    margin-bottom: 0;
  }

  .cm-modal__section-title {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
    color: var(--text-secondary);
  }

  .cm-modal__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 0;
    padding: 0 0 32px;
    border-bottom: 1px solid var(--accent-line);
  }

  .cm-modal__grid:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cm-modal__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cm-modal__item-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.9px;
    color: var(--text-secondary);
  }

  .cm-modal__item-value {
    font-size: 18px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .cm-modal__text {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .cm-modal__footer {
    font-size: 12px;
    color: var(--text-secondary);
    border-top: 1px solid var(--accent-line);
    padding-top: 24px;
    margin-top: 32px;
  }

  .cm-modal__close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    color: var(--text-secondary);
    transition: color 0.2s ease;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cm-modal__close:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 640px) {
    .cm-modal__content {
      padding: 40px 24px;
      max-height: 90vh;
    }

    .cm-modal__header {
      font-size: 24px;
      margin-bottom: 32px;
    }

    .cm-modal__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

<div class="cm-info-section">
  <div class="cm-info-section__inner">

    {%- comment -%} LEFT COLUMN: Headline & Description {%- endcomment -%}
    <div class="cm-info-headline">
      <span class="cm-info-eyebrow">{{ section.settings.eyebrow_text }}</span>
      <h2 class="cm-info-title">
        {{ section.settings.title_text }}<br>
        <em>{{ section.settings.title_em_text }}</em>
      </h2>
      <p class="cm-info-body">
        {{ section.settings.description_text }}
      </p>
    </div>

    {%- comment -%} RIGHT COLUMN: Information Cards {%- endcomment -%}
    <div class="cm-info-right">

      {%- comment -%} Information Cards {%- endcomment -%}
      <div class="cm-info-cards">

        {%- comment -%} Card 1: Información nutricional {%- endcomment -%}
        <article class="cm-info-card">
          <h3 class="cm-info-card__title">{{ section.settings.card1_title }}</h3>
          <p class="cm-info-card__subtitle">Cada 100g</p>
          <div class="cm-info-card__rows">
            {%- assign _kcal  = product.metafields.custom.kcal.value | default: section.settings.info_kcal -%}
            {%- assign _fats  = product.metafields.custom.fats_g.value | default: section.settings.info_fats -%}
            {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: section.settings.info_saturated_fats -%}
            {%- assign _carbs  = product.metafields.custom.carbohydrates_g.value | default: section.settings.info_carbs -%}
            {%- assign _prot  = product.metafields.custom.protein_g.value | default: section.settings.info_protein -%}
            {%- assign _sugar = product.metafields.custom.sugars_g.value | default: section.settings.info_sugars -%}
            {%- assign _salt  = product.metafields.custom.salt_g.value | default: section.settings.info_salt -%}
            {%- if _kcal != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.kcal_label }}</span>
                <span class="cm-info-card__value">{{ _kcal }} kcal</span>
              </div>
            {%- endif -%}
            {%- if _fats != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.fats_label }}</span>
                <span class="cm-info-card__value">{{ _fats }} g</span>
              </div>
            {%- endif -%}
            {%- if _sat_fats != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.saturated_fats_label }}</span>
                <span class="cm-info-card__value">{{ _sat_fats }} g</span>
              </div>
            {%- endif -%}
            {%- if _carbs != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.carbs_label }}</span>
                <span class="cm-info-card__value">{{ _carbs }} g</span>
              </div>
            {%- endif -%}
            {%- if _prot != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.protein_label }}</span>
                <span class="cm-info-card__value">{{ _prot }} g</span>
              </div>
            {%- endif -%}
            {%- if _sugar != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
                <span class="cm-info-card__value">{{ _sugar }} g</span>
              </div>
            {%- elsif _kcal != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
                <span class="cm-info-card__value">0 g</span>
              </div>
            {%- endif -%}
            {%- if _salt != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.salt_label }}</span>
                <span class="cm-info-card__value">{{ _salt }} g</span>
              </div>
            {%- endif -%}
          </div>
          <button class="cm-info-card__more-btn" onclick="openModal('nutritional-modal')">
            Saber más
          </button>
        </article>

        {%- comment -%} Card 2: Conservación y consumo {%- endcomment -%}
        <article class="cm-info-card">
          <h3 class="cm-info-card__title">{{ section.settings.card2_title }}</h3>
          <div class="cm-info-card__rows">
            {%- assign _cons_t  = product.metafields.custom.conservation_temp.value | default: section.settings.info_conservation_temp -%}
            {%- assign _serv_t  = product.metafields.custom.service_temp.value | default: section.settings.info_service_temp -%}
            {%- assign _cons_d  = product.metafields.custom.conservation_days.value | default: section.settings.info_conservation_days -%}
            {%- if _cons_t != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.conservation_label }}</span>
                <span class="cm-info-card__value">{{ _cons_t }}°</span>
              </div>
            {%- endif -%}
            {%- if _serv_t != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.service_label }}</span>
                <span class="cm-info-card__value">{{ _serv_t }}°</span>
              </div>
            {%- endif -%}
            {%- if _cons_d != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.opened_label }}</span>
                <span class="cm-info-card__value">{{ _cons_d }} días</span>
              </div>
            {%- endif -%}
          </div>
          {%- if section.settings.card2_additional_text != blank -%}
            <div class="cm-info-card__additional-text">
              {{ section.settings.card2_additional_text }}
            </div>
          {%- endif -%}
        </article>

      </div>

      {%- comment -%} Product Image: Jamón con mano {%- endcomment -%}
      {%- if section.settings.product_image != blank -%}
      <div class="cm-info-image-container">
        <img
          src="{{ section.settings.product_image | image_url: width: 520 }}"
          alt="{{ section.settings.product_image.alt | default: 'Mano ofreciendo jamón ibérico' }}"
          loading="lazy"
        />
      </div>
      {%- endif -%}

    </div>

  </div>
</div>

<!-- MODAL: Información Nutricional -->
<div class="cm-modal" id="nutritional-modal" onclick="closeModalOnOverlay(event, 'nutritional-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('nutritional-modal')" aria-label="Cerrar modal">&times;</button>

    <div class="cm-modal__header">Información Nutricional</div>

    <div class="cm-modal__section">
      <div class="cm-modal__section-title">Análisis nutricional por 100 g</div>
      <div class="cm-modal__grid">
        {%- assign _kcal  = product.metafields.custom.kcal.value | default: section.settings.info_kcal -%}
        {%- assign _fats  = product.metafields.custom.fats_g.value | default: section.settings.info_fats -%}
        {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: section.settings.info_saturated_fats -%}
        {%- assign _carbs  = product.metafields.custom.carbohydrates_g.value | default: section.settings.info_carbs -%}
        {%- assign _prot  = product.metafields.custom.protein_g.value | default: section.settings.info_protein -%}
        {%- assign _sugar = product.metafields.custom.sugars_g.value | default: section.settings.info_sugars -%}
        {%- assign _salt  = product.metafields.custom.salt_g.value | default: section.settings.info_salt -%}

        {%- if _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.kcal_label }}</div>
            <div class="cm-modal__item-value">{{ _kcal }} kcal</div>
          </div>
        {%- endif -%}

        {%- if _prot != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.protein_label }}</div>
            <div class="cm-modal__item-value">{{ _prot }} g</div>
          </div>
        {%- endif -%}

        {%- if _fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.fats_label }}</div>
            <div class="cm-modal__item-value">{{ _fats }} g</div>
          </div>
        {%- endif -%}

        {%- if _sat_fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.saturated_fats_label }}</div>
            <div class="cm-modal__item-value">{{ _sat_fats }} g</div>
          </div>
        {%- endif -%}

        {%- if _carbs != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.carbs_label }}</div>
            <div class="cm-modal__item-value">{{ _carbs }} g</div>
          </div>
        {%- endif -%}

        {%- if _sugar != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">{{ _sugar }} g</div>
          </div>
        {%- elsif _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">0 g</div>
          </div>
        {%- endif -%}

        {%- if _salt != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.salt_label }}</div>
            <div class="cm-modal__item-value">{{ _salt }} g</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.modal_ingredients != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Ingredientes</div>
        <div class="cm-modal__text">{{ section.settings.modal_ingredients }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_allergens != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Información de alérgenos</div>
        <div class="cm-modal__text">{{ section.settings.modal_allergens }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- MODAL: Conservación y Consumo -->
<div class="cm-modal" id="storage-modal" onclick="closeModalOnOverlay(event, 'storage-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('storage-modal')" aria-label="Cerrar modal">&times;</button>

    <div class="cm-modal__header">Conservación y Consumo</div>

    {%- if section.settings.modal_before_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Antes de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_before_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_after_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Después de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_after_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_consumption_tips != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Sugerencias de consumo</div>
        <div class="cm-modal__text">{{ section.settings.modal_consumption_tips }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  }

  function closeModalOnOverlay(event, modalId) {
    if (event.target.id === modalId) {
      closeModal(modalId);
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      const activeModals = document.querySelectorAll('.cm-modal.active');
      activeModals.forEach(modal => {
        modal.classList.remove('active');
      });
      document.body.style.overflow = 'auto';
    }
  });

  // Subtle parallax effect on scroll
  document.addEventListener('scroll', function() {
    const imageContainer = document.querySelector('.cm-info-image-container');
    if (imageContainer) {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const elementTop = imageContainer.offsetTop;
      const elementDistance = elementTop - scrollTop;

      if (elementDistance < window.innerHeight && elementDistance > -imageContainer.offsetHeight) {
        const parallaxValue = (scrollTop - elementTop) * 0.3;
        imageContainer.style.transform = 'translateY(' + parallaxValue + 'px)';
      }
    }
  });

  // Fade in sections on scroll
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  document.querySelectorAll('.cm-info-card').forEach(card => {
    card.style.opacity = '0';
    card.style.transform = 'translateY(10px)';
    card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(card);
  });
</script>

