{% comment %}
  product-information.liquid — Sección de información del producto
  Información nutricional y conservación/consumo

  ICON CONFIGURATION:
  To change icons, modify these values at the top of the section:
  Available icons: info_nutricional.svg, icon-consumo.svg, icon-origen.svg, formato.svg,
                   icon-envio.svg, icon-garantia.svg, icon-conservacion.svg, icon-peso.svg, etc.
{% endcomment %}

{%- assign icon_card1 = section.settings.card1_icon -%}
{%- assign icon_card2 = section.settings.card2_icon -%}

{{ 'product-information.css' | asset_url | stylesheet_tag }}
<style>
  .cm-info-image-container--embutidos {
    --pi-mobile-right: {{ section.settings.embutidos_mobile_right }}px;
    --pi-mobile-bottom: {{ section.settings.embutidos_mobile_bottom }}px;
  }
  .cm-info-section--embutidos {
    --pi-mobile-section-padding: {{ section.settings.embutidos_mobile_section_padding }}px;
  }
</style>

{%- comment -%} Imagen pegada al borde — se posiciona relativa a cm-info-section {%- endcomment -%}
{%- assign image_modifier = '' -%}
{%- assign section_modifier = '' -%}
{%- comment -%}
  La plantilla (template.suffix) es la señal fiable: los ajustes de imagen
  (product_image, jamones_image, embutidos_image, sliders de posición) se
  configuran por plantilla, no por colección — un producto puede usar la
  plantilla "embutidos" sin que "embutidos" sea su primera colección.
{%- endcomment -%}
{%- assign _variant_handle = template.suffix -%}
{%- if _variant_handle != 'jamones' and _variant_handle != 'embutidos' -%}
  {%- assign _variant_handle = product.collections.first.handle -%}
{%- endif -%}

{%- case _variant_handle -%}
  {%- when 'jamones' -%}
    {%- assign image_modifier = 'cm-info-image-container--jamones' -%}
    {%- assign section_modifier = 'cm-info-section--jamones' -%}
  {%- when 'embutidos' -%}
    {%- assign image_modifier = 'cm-info-image-container--embutidos' -%}
    {%- assign section_modifier = 'cm-info-section--embutidos' -%}
{%- endcase -%}

{%- if section.settings.product_image != blank -%}
  {%- assign image_src = section.settings.product_image | image_url: width: 520, format: 'webp' -%}
  {%- assign image_alt = section.settings.product_image.alt | default: 'Mano ofreciendo jamón ibérico' -%}
{%- elsif _variant_handle == 'jamones' and section.settings.jamones_image != blank -%}
  {%- assign image_src = section.settings.jamones_image | image_url: width: 520, format: 'webp' -%}
  {%- assign image_alt = section.settings.jamones_image.alt | default: 'Mano ofreciendo jamón ibérico' -%}
{%- elsif _variant_handle == 'embutidos' and section.settings.embutidos_image != blank -%}
  {%- assign image_src = section.settings.embutidos_image | image_url: width: 520, format: 'webp' -%}
  {%- assign image_alt = section.settings.embutidos_image.alt | default: 'Embutido ibérico' -%}
{%- endif -%}

<div class="cm-info-section{% if section_modifier != blank %} {{ section_modifier }}{% endif %}">
  <div class="cm-info-section__inner">

    {%- comment -%} LEFT COLUMN: Headline & Description {%- endcomment -%}
    <div class="cm-info-headline">
      <span class="cm-info-eyebrow">{{ section.settings.eyebrow_text }}</span>
      <h2 class="cm-info-title">
        {{ section.settings.title_text }}<br>
        <em>{{ section.settings.title_em_text }}</em>
      </h2>
      <p class="cm-info-body">
        {{ section.settings.description_text }}
      </p>
    </div>

    {%- comment -%} RIGHT COLUMN: Information Cards {%- endcomment -%}
    <div class="cm-info-right">

      {%- comment -%} Information Cards {%- endcomment -%}
      <div class="cm-info-cards">

        {%- comment -%} Card 1: Información nutricional {%- endcomment -%}
        <article class="cm-info-card">
          <h3 class="cm-info-card__title">{{ section.settings.card1_title }}</h3>
          <p class="cm-info-card__subtitle">Cada 100g</p>
          <div class="cm-info-card__rows">
            {%- assign _kcal      = product.metafields.custom.kcal.value | default: product.metafields.custom.energy.value | default: section.settings.info_kcal -%}
            {%- assign _fats      = product.metafields.custom.fats_g.value | default: product.metafields.custom.fat.value | default: section.settings.info_fats -%}
            {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: product.metafields.custom.saturated_fat.value | default: section.settings.info_saturated_fats -%}
            {%- assign _carbs     = product.metafields.custom.carbohydrates_g.value | default: product.metafields.custom.carbohydrates.value | default: section.settings.info_carbs -%}
            {%- assign _prot      = product.metafields.custom.protein_g.value | default: product.metafields.custom.protein.value | default: section.settings.info_protein -%}
            {%- assign _sugar     = product.metafields.custom.sugars_g.value | default: product.metafields.custom.sugars.value | default: section.settings.info_sugars -%}
            {%- assign _salt      = product.metafields.custom.salt_g.value | default: product.metafields.custom.salt.value | default: section.settings.info_salt -%}
            {%- if _kcal != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.kcal_label }}</span>
                <span class="cm-info-card__value">{{- _kcal -}}{%- unless _kcal contains 'kcal' or _kcal contains 'kJ' -%} kcal{%- endunless -%}</span>
              </div>
            {%- endif -%}
            {%- if _fats != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.fats_label }}</span>
                <span class="cm-info-card__value">{{- _fats -}}{%- unless _fats contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- endif -%}
            {%- if _sat_fats != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.saturated_fats_label }}</span>
                <span class="cm-info-card__value">{{- _sat_fats -}}{%- unless _sat_fats contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- endif -%}
            {%- if _carbs != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.carbs_label }}</span>
                <span class="cm-info-card__value">{{- _carbs -}}{%- unless _carbs contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- endif -%}
            {%- if _prot != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.protein_label }}</span>
                <span class="cm-info-card__value">{{- _prot -}}{%- unless _prot contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- endif -%}
            {%- if _sugar != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
                <span class="cm-info-card__value">{{- _sugar -}}{%- unless _sugar contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- elsif _kcal != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
                <span class="cm-info-card__value">0 g</span>
              </div>
            {%- endif -%}
            {%- if _salt != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.salt_label }}</span>
                <span class="cm-info-card__value">{{- _salt -}}{%- unless _salt contains ' g' -%} g{%- endunless -%}</span>
              </div>
            {%- endif -%}
          </div>
          <button class="cm-info-card__more-btn" onclick="openModal('nutritional-modal')">
            Saber más
          </button>
        </article>

        {%- comment -%} Card 2: Conservación y consumo {%- endcomment -%}
        <article class="cm-info-card">
          <h3 class="cm-info-card__title">{{ section.settings.card2_title }}</h3>
          <div class="cm-info-card__rows">
            {%- assign _cons_t  = product.metafields.custom.conservation_temp.value | default: section.settings.info_conservation_temp -%}
            {%- assign _serv_t  = product.metafields.custom.service_temp.value | default: section.settings.info_service_temp -%}
            {%- assign _cons_d  = product.metafields.custom.conservation_days.value | default: section.settings.info_conservation_days -%}
            {%- if _cons_t != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.conservation_label }}</span>
                <span class="cm-info-card__value">{{ _cons_t }}°</span>
              </div>
            {%- endif -%}
            {%- if _serv_t != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.service_label }}</span>
                <span class="cm-info-card__value">{{ _serv_t }}°</span>
              </div>
            {%- endif -%}
            {%- if _cons_d != blank -%}
              <div class="cm-info-card__row">
                <span class="cm-info-card__label">{{ section.settings.opened_label }}</span>
                <span class="cm-info-card__value">{{ _cons_d }} días</span>
              </div>
            {%- endif -%}
          </div>
          {%- if section.settings.card2_additional_text != blank -%}
            {%- assign _has_cons_rows = false -%}
            {%- if _cons_t != blank or _serv_t != blank or _cons_d != blank -%}
              {%- assign _has_cons_rows = true -%}
            {%- endif -%}
            <div class="cm-info-card__additional-text{% unless _has_cons_rows %} cm-info-card__additional-text--no-sep{% endunless %}">
              {{ section.settings.card2_additional_text }}
            </div>
          {%- endif -%}
        </article>

      </div>

    </div>

  </div>

  {%- if image_src != blank -%}
  <div class="cm-info-image-container{% if image_modifier != blank %} {{ image_modifier }}{% endif %}">
    <img
      src="{{ image_src }}"
      alt="{{ image_alt }}"
      loading="lazy"
    />
  </div>
  {%- endif -%}

</div>

<!-- MODAL: Información Nutricional -->
<div class="cm-modal" id="nutritional-modal" onclick="closeModalOnOverlay(event, 'nutritional-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('nutritional-modal')" aria-label="Cerrar modal">&times;</button>

    <div class="cm-modal__header">Información Nutricional</div>

    <div class="cm-modal__section">
      <div class="cm-modal__section-title">Análisis nutricional por 100 g</div>
      <div class="cm-modal__grid">
        {%- assign _kcal      = product.metafields.custom.kcal.value | default: product.metafields.custom.energy.value | default: section.settings.info_kcal -%}
        {%- assign _fats      = product.metafields.custom.fats_g.value | default: product.metafields.custom.fat.value | default: section.settings.info_fats -%}
        {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: product.metafields.custom.saturated_fat.value | default: section.settings.info_saturated_fats -%}
        {%- assign _carbs     = product.metafields.custom.carbohydrates_g.value | default: product.metafields.custom.carbohydrates.value | default: section.settings.info_carbs -%}
        {%- assign _prot      = product.metafields.custom.protein_g.value | default: product.metafields.custom.protein.value | default: section.settings.info_protein -%}
        {%- assign _sugar     = product.metafields.custom.sugars_g.value | default: product.metafields.custom.sugars.value | default: section.settings.info_sugars -%}
        {%- assign _salt      = product.metafields.custom.salt_g.value | default: product.metafields.custom.salt.value | default: section.settings.info_salt -%}

        {%- if _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.kcal_label }}</div>
            <div class="cm-modal__item-value">{{- _kcal -}}{%- unless _kcal contains 'kcal' or _kcal contains 'kJ' -%} kcal{%- endunless -%}</div>
          </div>
        {%- endif -%}

        {%- if _prot != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.protein_label }}</div>
            <div class="cm-modal__item-value">{{- _prot -}}{%- unless _prot contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- endif -%}

        {%- if _fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.fats_label }}</div>
            <div class="cm-modal__item-value">{{- _fats -}}{%- unless _fats contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- endif -%}

        {%- if _sat_fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.saturated_fats_label }}</div>
            <div class="cm-modal__item-value">{{- _sat_fats -}}{%- unless _sat_fats contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- endif -%}

        {%- if _carbs != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.carbs_label }}</div>
            <div class="cm-modal__item-value">{{- _carbs -}}{%- unless _carbs contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- endif -%}

        {%- if _sugar != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">{{- _sugar -}}{%- unless _sugar contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- elsif _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">0 g</div>
          </div>
        {%- endif -%}

        {%- if _salt != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.salt_label }}</div>
            <div class="cm-modal__item-value">{{- _salt -}}{%- unless _salt contains ' g' -%} g{%- endunless -%}</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.modal_ingredients != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Ingredientes</div>
        <div class="cm-modal__text">{{ section.settings.modal_ingredients }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_allergens != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Información de alérgenos</div>
        <div class="cm-modal__text">{{ section.settings.modal_allergens }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- MODAL: Conservación y Consumo -->
<div class="cm-modal" id="storage-modal" onclick="closeModalOnOverlay(event, 'storage-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('storage-modal')" aria-label="Cerrar modal">&times;</button>

    <div class="cm-modal__header">Conservación y Consumo</div>

    {%- if section.settings.modal_before_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Antes de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_before_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_after_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Después de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_after_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_consumption_tips != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Sugerencias de consumo</div>
        <div class="cm-modal__text">{{ section.settings.modal_consumption_tips }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'product-information.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Información del Producto",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Imagen del producto"
    },
    {
      "type": "image_picker",
      "id": "jamones_image",
      "label": "Imagen para colección Jamones"
    },
    {
      "type": "image_picker",
      "id": "embutidos_image",
      "label": "Imagen para colección Embutidos"
    },
    {
      "type": "header",
      "content": "Posición de imagen — Embutidos (móvil)"
    },
    {
      "type": "range",
      "id": "embutidos_mobile_bottom",
      "label": "Desplazamiento vertical",
      "info": "Valores más negativos bajan la imagen más",
      "min": -300,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": -120
    },
    {
      "type": "range",
      "id": "embutidos_mobile_right",
      "label": "Desplazamiento horizontal (borde derecho)",
      "info": "Valores negativos empujan la imagen hacia fuera de la pantalla",
      "min": -100,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": -40
    },
    {
      "type": "range",
      "id": "embutidos_mobile_section_padding",
      "label": "Espacio reservado abajo de la sección",
      "info": "Aumenta esto si la imagen queda cortada",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 580
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Texto superior",
      "default": "Información del producto"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Título principal",
      "default": "Transparencia Con Sabor A"
    },
    {
      "type": "text",
      "id": "title_em_text",
      "label": "Texto en cursiva del título",
      "default": "Tradición"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Descripción",
      "default": "Detrás de cada pieza hay un proceso que merece ser conocido. Por eso te lo contamos todo: su composición nutricional, cómo conservarlo y cómo disfrutarlo al máximo. Porque saber lo que comes es parte del placer."
    },
    {
      "type": "text",
      "id": "card1_title",
      "label": "Título Tarjeta 1",
      "default": "Información nutricional"
    },
    {
      "type": "select",
      "id": "card1_icon",
      "label": "Icono Tarjeta 1",
      "default": "info_nutricional.svg",
      "options": [
        {
          "value": "info_nutricional.svg",
          "label": "Información Nutricional"
        },
        {
          "value": "icon-consumo.svg",
          "label": "Consumo"
        },
        {
          "value": "icon-origen.svg",
          "label": "Origen"
        },
        {
          "value": "formato.svg",
          "label": "Formato"
        },
        {
          "value": "icon-raza.svg",
          "label": "Raza"
        },
        {
          "value": "icon-bellota.svg",
          "label": "Bellota"
        },
        {
          "value": "icon-pasto.svg",
          "label": "Pasto"
        },
        {
          "value": "icon-cereales.svg",
          "label": "Cereales"
        },
        {
          "value": "icon-cata.svg",
          "label": "Cata"
        },
        {
          "value": "icon-curacion.svg",
          "label": "Curación"
        },
        {
          "value": "icon-refrigerado.svg",
          "label": "Refrigerado"
        },
        {
          "value": "icon-envio.svg",
          "label": "Envío"
        },
        {
          "value": "icon-garantia.svg",
          "label": "Garantía"
        },
        {
          "value": "icon-conservacion.svg",
          "label": "Conservación"
        },
        {
          "value": "icon-peso.svg",
          "label": "Peso"
        },
        {
          "value": "icon-info.svg",
          "label": "Información"
        }
      ]
    },
    {
      "type": "text",
      "id": "kcal_label",
      "label": "Etiqueta Valor energético",
      "default": "Valor energético"
    },
    {
      "type": "text",
      "id": "info_kcal",
      "label": "Valor energético por defecto",
      "default": "200"
    },
    {
      "type": "text",
      "id": "protein_label",
      "label": "Etiqueta Proteínas",
      "default": "Proteínas"
    },
    {
      "type": "text",
      "id": "info_protein",
      "label": "Proteínas por defecto",
      "default": "28"
    },
    {
      "type": "text",
      "id": "fats_label",
      "label": "Etiqueta Grasas",
      "default": "Grasas"
    },
    {
      "type": "text",
      "id": "info_fats",
      "label": "Grasas por defecto",
      "default": "24"
    },
    {
      "type": "text",
      "id": "saturated_fats_label",
      "label": "Etiqueta Grasas saturadas",
      "default": "— de las cuales saturadas"
    },
    {
      "type": "text",
      "id": "info_saturated_fats",
      "label": "Grasas saturadas por defecto",
      "default": "9"
    },
    {
      "type": "text",
      "id": "carbs_label",
      "label": "Etiqueta Hidratos de carbono",
      "default": "Hidratos de carbono"
    },
    {
      "type": "text",
      "id": "info_carbs",
      "label": "Hidratos de carbono por defecto",
      "default": "0"
    },
    {
      "type": "text",
      "id": "sugars_label",
      "label": "Etiqueta Azúcares",
      "default": "Azúcares"
    },
    {
      "type": "text",
      "id": "info_sugars",
      "label": "Azúcares por defecto",
      "default": "0"
    },
    {
      "type": "text",
      "id": "salt_label",
      "label": "Etiqueta Sal",
      "default": "Sal"
    },
    {
      "type": "text",
      "id": "info_salt",
      "label": "Sal por defecto",
      "default": "4"
    },
    {
      "type": "text",
      "id": "card2_title",
      "label": "Título Tarjeta 2",
      "default": "Conservación y consumo"
    },
    {
      "type": "select",
      "id": "card2_icon",
      "label": "Icono Tarjeta 2",
      "default": "icon-consumo.svg",
      "options": [
        {
          "value": "info_nutricional.svg",
          "label": "Información Nutricional"
        },
        {
          "value": "icon-consumo.svg",
          "label": "Consumo"
        },
        {
          "value": "icon-origen.svg",
          "label": "Origen"
        },
        {
          "value": "formato.svg",
          "label": "Formato"
        },
        {
          "value": "icon-raza.svg",
