{% comment %}
  product-information.liquid — Sección de información del producto
  Información nutricional y conservación/consumo

  ICON CONFIGURATION:
  To change icons, modify these values at the top of the section:
  Available icons: info_nutricional.svg, icon-consumo.svg, icon-origen.svg, formato.svg,
                   icon-envio.svg, icon-garantia.svg, icon-conservacion.svg, icon-peso.svg, etc.
{% endcomment %}

{%- assign icon_card1 = section.settings.card1_icon -%}
{%- assign icon_card2 = section.settings.card2_icon -%}

<style>
  /* ── VARIABLES DE COLOR — paleta crema clara ── */
  :root {
    --bg-primary:   #F5F0E8;
    --bg-secondary: #EDEAE2;
    --bg-card:      #FFFFFF;
    --text-primary: #1A1410;
    --text-secondary: #6B5E4E;
    --accent-gold:  #C9A84C;
    --border-color: #D6CFC4;
  }

  .cm-info-section {
    width: 100%;
    background: var(--bg-primary);
    padding: 56px 24px 80px;
    box-sizing: border-box;
  }

  .cm-info-section__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .cm-info-headline {
    margin-bottom: 64px;
    text-align: left;
  }

  .cm-info-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--accent-gold);
    margin-bottom: 12px;
  }

  .cm-info-title {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: clamp(28px, 3.2vw, 38px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0 0 20px;
    line-height: 1;
  }

  .cm-info-title em {
    font-style: italic;
    color: var(--accent-gold);
    font-weight: 400;
  }

  .cm-info-body {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0;
  }

  .cm-info-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  @media (max-width: 768px) {
    .cm-info-cards {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .cm-info-card {
    background: var(--bg-card);
    padding: 32px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .cm-info-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    background: var(--bg-secondary);
    border-radius: 8px;
    margin-bottom: 20px;
    color: var(--accent-gold);
  }

  .cm-info-card__icon svg {
    width: 72px;
    height: 72px;
  }

  .cm-info-card__title {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 20px;
  }

  .cm-info-card__rows {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cm-info-card__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
  }

  .cm-info-card__row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .cm-info-card__label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .cm-info-card__value {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .cm-info-card__subtitle {
    font-size: 12px;
    font-weight: 400;
    color: var(--text-secondary);
    margin-top: 4px;
  }

  .cm-info-card__more-btn {
    display: inline-block;
    margin-top: 20px;
    background: none;
    border: none;
    color: var(--accent-gold);
    font-size: 13px;
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  .cm-info-card__more-btn:hover {
    color: var(--text-primary);
  }

  .cm-info-card__additional-text {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-primary);
  }

  /* ── MODAL STYLES ── */
  .cm-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .cm-modal.active {
    display: flex;
  }

  .cm-modal__content {
    background: white;
    border-radius: 8px;
    max-width: 600px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
  }

  .cm-modal__header {
    font-family: var(--cm-font-serif, Georgia, serif);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .cm-modal__section {
    margin-bottom: 1.5rem;
  }

  .cm-modal__section-title {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
    color: var(--text-secondary);
  }

  .cm-modal__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .cm-modal__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cm-modal__item-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .cm-modal__item-value {
    font-size: 15px;
    color: var(--text-primary);
    font-weight: 500;
  }

  .cm-modal__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .cm-modal__footer {
    font-size: 12px;
    color: var(--text-secondary);
    border-top: 1px solid var(--border-color);
    padding-top: 1rem;
    margin-top: 1rem;
  }

  .cm-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .cm-modal__close:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .cm-modal__content {
      padding: 1.5rem;
      max-height: 90vh;
    }

    .cm-modal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="cm-info-section">
  <div class="cm-info-section__inner">

    <div class="cm-info-headline">
      <span class="cm-info-eyebrow">{{ section.settings.eyebrow_text }}</span>
      <h2 class="cm-info-title">
        {{ section.settings.title_text }}<br>
        <em>{{ section.settings.title_em_text }}</em>
      </h2>
      <p class="cm-info-body">
        {{ section.settings.description_text }}
      </p>
    </div>

    <div class="cm-info-cards">

      {%- comment -%} Card 1: Información nutricional {%- endcomment -%}
      <article class="cm-info-card">
        <div class="cm-info-card__icon">
          {%- render 'icon-selector', icon: icon_card1, width: 22, height: 22, alt: section.settings.card1_title -%}
        </div>
        <h3 class="cm-info-card__title">{{ section.settings.card1_title }}</h3>
        <p class="cm-info-card__subtitle">Cada 100g</p>
        <div class="cm-info-card__rows">
          {%- assign _kcal  = product.metafields.custom.kcal.value | default: section.settings.info_kcal -%}
          {%- assign _fats  = product.metafields.custom.fats_g.value | default: section.settings.info_fats -%}
          {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: section.settings.info_saturated_fats -%}
          {%- assign _carbs  = product.metafields.custom.carbohydrates_g.value | default: section.settings.info_carbs -%}
          {%- assign _prot  = product.metafields.custom.protein_g.value | default: section.settings.info_protein -%}
          {%- assign _sugar = product.metafields.custom.sugars_g.value | default: section.settings.info_sugars -%}
          {%- assign _salt  = product.metafields.custom.salt_g.value | default: section.settings.info_salt -%}
          {%- if _kcal != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.kcal_label }}</span>
              <span class="cm-info-card__value">{{ _kcal }} kcal</span>
            </div>
          {%- endif -%}
          {%- if _fats != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.fats_label }}</span>
              <span class="cm-info-card__value">{{ _fats }} g</span>
            </div>
          {%- endif -%}
          {%- if _sat_fats != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.saturated_fats_label }}</span>
              <span class="cm-info-card__value">{{ _sat_fats }} g</span>
            </div>
          {%- endif -%}
          {%- if _carbs != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.carbs_label }}</span>
              <span class="cm-info-card__value">{{ _carbs }} g</span>
            </div>
          {%- endif -%}
          {%- if _prot != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.protein_label }}</span>
              <span class="cm-info-card__value">{{ _prot }} g</span>
            </div>
          {%- endif -%}
          {%- if _sugar != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
              <span class="cm-info-card__value">{{ _sugar }} g</span>
            </div>
          {%- elsif _kcal != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.sugars_label }}</span>
              <span class="cm-info-card__value">0 g</span>
            </div>
          {%- endif -%}
          {%- if _salt != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.salt_label }}</span>
              <span class="cm-info-card__value">{{ _salt }} g</span>
            </div>
          {%- endif -%}
        </div>
        <button class="cm-info-card__more-btn" onclick="openModal('nutritional-modal')">
          Saber más
        </button>
      </article>

      {%- comment -%} Card 2: Conservación y consumo {%- endcomment -%}
      <article class="cm-info-card">
        <div class="cm-info-card__icon">
          {%- render 'icon-selector', icon: icon_card2, width: 22, height: 22, alt: section.settings.card2_title -%}
        </div>
        <h3 class="cm-info-card__title">{{ section.settings.card2_title }}</h3>
        <div class="cm-info-card__rows">
          {%- assign _cons_t  = product.metafields.custom.conservation_temp.value | default: section.settings.info_conservation_temp -%}
          {%- assign _serv_t  = product.metafields.custom.service_temp.value | default: section.settings.info_service_temp -%}
          {%- assign _cons_d  = product.metafields.custom.conservation_days.value | default: section.settings.info_conservation_days -%}
          {%- if _cons_t != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.conservation_label }}</span>
              <span class="cm-info-card__value">{{ _cons_t }}°</span>
            </div>
          {%- endif -%}
          {%- if _serv_t != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.service_label }}</span>
              <span class="cm-info-card__value">{{ _serv_t }}°</span>
            </div>
          {%- endif -%}
          {%- if _cons_d != blank -%}
            <div class="cm-info-card__row">
              <span class="cm-info-card__label">{{ section.settings.opened_label }}</span>
              <span class="cm-info-card__value">{{ _cons_d }} días</span>
            </div>
          {%- endif -%}
        </div>
        {%- if section.settings.card2_additional_text != blank -%}
          <div class="cm-info-card__additional-text">
            {{ section.settings.card2_additional_text }}
          </div>
        {%- endif -%}
      </article>

    </div>
  </div>
</div>

<!-- MODAL: Información Nutricional -->
<div class="cm-modal" id="nutritional-modal" onclick="closeModalOnOverlay(event, 'nutritional-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('nutritional-modal')">&times;</button>

    <div class="cm-modal__header">Información Nutricional</div>

    <div class="cm-modal__section">
      <div class="cm-modal__section-title">por 100 g</div>
      <div class="cm-modal__grid">
        {%- assign _kcal  = product.metafields.custom.kcal.value | default: section.settings.info_kcal -%}
        {%- assign _fats  = product.metafields.custom.fats_g.value | default: section.settings.info_fats -%}
        {%- assign _sat_fats  = product.metafields.custom.saturated_fats_g.value | default: section.settings.info_saturated_fats -%}
        {%- assign _carbs  = product.metafields.custom.carbohydrates_g.value | default: section.settings.info_carbs -%}
        {%- assign _prot  = product.metafields.custom.protein_g.value | default: section.settings.info_protein -%}
        {%- assign _sugar = product.metafields.custom.sugars_g.value | default: section.settings.info_sugars -%}
        {%- assign _salt  = product.metafields.custom.salt_g.value | default: section.settings.info_salt -%}

        {%- if _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.kcal_label }}</div>
            <div class="cm-modal__item-value">{{ _kcal }} kcal</div>
          </div>
        {%- endif -%}

        {%- if _prot != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.protein_label }}</div>
            <div class="cm-modal__item-value">{{ _prot }} g</div>
          </div>
        {%- endif -%}

        {%- if _fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.fats_label }}</div>
            <div class="cm-modal__item-value">{{ _fats }} g</div>
          </div>
        {%- endif -%}

        {%- if _sat_fats != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.saturated_fats_label }}</div>
            <div class="cm-modal__item-value">{{ _sat_fats }} g</div>
          </div>
        {%- endif -%}

        {%- if _carbs != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.carbs_label }}</div>
            <div class="cm-modal__item-value">{{ _carbs }} g</div>
          </div>
        {%- endif -%}

        {%- if _sugar != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">{{ _sugar }} g</div>
          </div>
        {%- elsif _kcal != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.sugars_label }}</div>
            <div class="cm-modal__item-value">0 g</div>
          </div>
        {%- endif -%}

        {%- if _salt != blank -%}
          <div class="cm-modal__item">
            <div class="cm-modal__item-label">{{ section.settings.salt_label }}</div>
            <div class="cm-modal__item-value">{{ _salt }} g</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.modal_ingredients != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Ingredientes</div>
        <div class="cm-modal__text">{{ section.settings.modal_ingredients }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_allergens != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__text">{{ section.settings.modal_allergens }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<!-- MODAL: Conservación y Consumo -->
<div class="cm-modal" id="storage-modal" onclick="closeModalOnOverlay(event, 'storage-modal')">
  <div class="cm-modal__content" onclick="event.stopPropagation()">
    <button class="cm-modal__close" onclick="closeModal('storage-modal')">&times;</button>

    <div class="cm-modal__header">Conservación y Consumo</div>

    {%- if section.settings.modal_before_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Antes de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_before_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_after_opening != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Después de abrir</div>
        <div class="cm-modal__text">{{ section.settings.modal_after_opening }}</div>
      </div>
    {%- endif -%}

    {%- if section.settings.modal_consumption_tips != blank -%}
      <div class="cm-modal__section">
        <div class="cm-modal__section-title">Sugerencias de consumo</div>
        <div class="cm-modal__text">{{ section.settings.modal_consumption_tips }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  function openModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal(modalId) {
    const modal = document.getElementById(modalId);
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }
  }

  function closeModalOnOverlay(event, modalId) {
    if (event.target.id === modalId) {
      closeModal(modalId);
    }
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      const activeModals = document.querySelectorAll('.cm-modal.active');
      activeModals.forEach(modal => {
        modal.classList.remove('active');
      });
      document.body.style.overflow = 'auto';
    }
  });
</script>

