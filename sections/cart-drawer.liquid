{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

<div id="cart-drawer" class="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'cm.cart.aria' | t }}">
  <div class="cart-overlay" onclick="closeCart()"></div>

  <div class="cart-panel">

    <!-- HEADER -->
    <div class="cart-header">
      <div>
        <h2>{{ 'cm.cart.added_html' | t }}</h2>
        <div class="cart-added-confirm" id="cart-added-confirm" style="display:none">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="8" cy="8" r="7" stroke="#6B6050" stroke-width="1.2" fill="none"/>
            <path d="M5 8.2 L7 10.2 L11 6" stroke="#6B6050" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span>{{ 'cm.cart.added_msg' | t }}</span>
        </div>
      </div>
      <button class="cart-close" onclick="closeCart()" aria-label="{{ 'cm.cart.close' | t }}">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <line x1="2" y1="2" x2="16" y2="16" stroke="#00294B" stroke-width="1.5" stroke-linecap="round"/>
          <line x1="16" y1="2" x2="2" y2="16" stroke="#00294B" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <div class="cart-divider"></div>

    <!-- CART COUNT -->
    <p class="cart-count">{{ 'cm.cart.your_cart' | t }} (<span id="cart-item-count">{{ cart.item_count }}</span>)</p>

    <!-- ITEMS -->
    {%- assign cart_has_box = false -%}
    {%- for item in cart.items -%}
      {%- if item.properties._cesta_id != blank -%}{%- assign cart_has_box = true -%}{%- endif -%}
    {%- endfor -%}
    <div class="cart-items" id="cart-items-container"{% if cart_has_box %} data-needs-render{% endif %}>
      {%- if cart_has_box -%}
        <div class="cart-empty"><p>{{ 'cm.cart.loading' | t }}</p></div>
      {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-item" data-key="{{ item.key }}">
          <a href="{{ item.url }}" class="cart-item-image-link">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 160, height: 160, crop: 'center', format: 'webp' }}"
                alt="{{ item.title | escape }}"
                class="cart-item-img"
                width="80"
                height="80"
                loading="lazy"
              >
            {%- else -%}
              <div class="cart-item-img"></div>
            {%- endif -%}
          </a>
          <div class="cart-item-info">
            <a href="{{ item.url }}" class="cart-title">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <p class="cart-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            {%- comment -%}
              Sin línea de peso: item.variant.weight es el peso de ENVÍO (p. ej. 0,15 kg en el jamón loncheado
              de 100 g), no el contenido, y el JS que repinta el cajón (cart-drawer.js) no lo pintaba, así que la
              línea aparecía y desaparecía. Pendiente: mostrar el gramaje real con el metacampo custom.gramaje.
            {%- endcomment -%}
            <div class="cart-qty">
              <button
                class="cart-qty-btn"
                onclick="updateQty('{{ item.key }}', {{ item.quantity | minus: 1 }})"
                aria-label="Reducir cantidad"
              >−</button>
              <input class="cart-qty-num" type="number" inputmode="numeric" min="0" max="999" value="{{ item.quantity }}" aria-label="Cantidad de {{ item.title | escape }}" onchange="cmSetCartQty('{{ item.key }}', this)" onfocus="this.select()">
              <button
                class="cart-qty-btn"
                onclick="updateQty('{{ item.key }}', {{ item.quantity | plus: 1 }})"
                aria-label="Aumentar cantidad"
              >+</button>
            </div>
          </div>
          <div class="cart-item-right">
            {%- comment -%} line_level_total_discount incluye también los códigos de descuento (p. ej. el 5% de la cesta) {%- endcomment -%}
            {%- if item.line_level_total_discount > 0 -%}
              {%- assign cart_item_net = item.original_line_price | minus: item.line_level_total_discount -%}
              {%- assign cart_item_pct = item.line_level_total_discount | times: 100.0 | divided_by: item.original_line_price | round -%}
              <div class="cart-price-wrap">
                <span class="cart-price-compare">{{ item.original_line_price | money }}</span>
                <span class="cart-price cart-price--sale">{{ cart_item_net | money }}</span>
                <span class="cart-discount-badge">-{{ cart_item_pct }}%</span>
              </div>
            {%- else -%}
              <span class="cart-price">{{ item.final_line_price | money }}</span>
            {%- endif -%}
            <button
              class="cart-remove"
              onclick="removeItem('{{ item.key }}')"
              aria-label="Eliminar {{ item.title | escape }}"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 4h12M6 4V2h4v2M5 4l.5 9h5L11 4" stroke="#6B6050" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </button>
          </div>
        </div>
      {%- else -%}
        <div class="cart-empty">
          <p>{{ 'cm.cart.empty' | t }}</p>
          <a href="{{ routes.collections_url }}/all">{{ 'cm.cart.keep_shopping' | t }}</a>
        </div>
      {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- ENVÍO GRATIS -->
    {% render 'free-shipping-bar' %}

    <!-- DISCOUNT -->
    <div class="cart-discount">
      <label for="discount-code">{{ 'cm.cart.discount_label' | t }}</label>
      <div class="discount-row">
        <input
          type="text"
          id="discount-code"
          name="discount"
          placeholder="{{ 'cm.cart.discount_placeholder' | t }}"
          autocomplete="off"
        >
        <button class="discount-apply-btn" onclick="applyDiscount()">{{ 'cm.cart.apply' | t }}</button>
      </div>
    </div>

    <!-- SUMMARY -->
    <div class="cart-summary">
      <div class="row">
        <span>{{ 'cm.cart.subtotal' | t }}</span>
        <span id="cart-subtotal">{{ cart.original_total_price | money }}</span>
      </div>
      <div class="row discount-row" id="cart-discount-row"{% if cart.total_discount == 0 %} hidden{% endif %}>
        <span>Descuentos</span>
        <span id="cart-discount">−{{ cart.total_discount | money }}</span>
      </div>
      <div class="row">
        <span class="shipping-label">
          Envío
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline;vertical-align:middle;margin-left:2px;">
            <circle cx="6" cy="6" r="5" stroke="#6B6050" stroke-width="1" fill="none"/>
            <line x1="6" y1="5" x2="6" y2="9" stroke="#6B6050" stroke-width="1" stroke-linecap="round"/>
            <circle cx="6" cy="3.5" r="0.6" fill="#6B6050"/>
          </svg>
        </span>
        <span id="cart-shipping">{{ 'cm.cart.shipping_calc' | t }}</span>
      </div>
      <div class="cart-divider"></div>
      <div class="row total">
        <span>{{ 'cm.cart.total' | t }}</span>
        <span id="cart-total">{{ cart.total_price | money }}</span>
      </div>
      <p class="iva">(IVA incluido)</p>
    </div>

    <!-- CTA BUTTONS -->
    <button class="checkout-btn" onclick="goToCheckout()">{{ 'cm.cart.checkout' | t }}</button>
    <button class="continue-btn" onclick="closeCart()">{{ 'cm.cart.continue' | t }}</button>

    <!-- RECOMMENDATIONS -->
    <div class="cart-recommendations" id="cart-recommendations" style="display:none">
      <div class="cart-divider" style="margin: 24px 0 16px"></div>
      <h3 class="cart-rec-title">{{ 'cm.cart.recommend' | t }}</h3>
      <div class="cart-rec-grid" id="cart-rec-grid"></div>
    </div>

    <!-- VALUES ICONS -->
    <div class="cart-values">
      <div class="cart-values-grid">

        <!-- Envío gratuito -->
        <div class="cart-value-item">
          <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="1" y="9" width="22" height="16" rx="1" stroke="#6B6050" stroke-width="1.4" fill="none"/>
            <path d="M23 13h5.5L32 18v7h-9V13z" stroke="#6B6050" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
            <circle cx="8" cy="27" r="2.5" stroke="#6B6050" stroke-width="1.4" fill="none"/>
            <circle cx="27" cy="27" r="2.5" stroke="#6B6050" stroke-width="1.4" fill="none"/>
            <line x1="10.5" y1="27" x2="24.5" y2="27" stroke="#6B6050" stroke-width="1.4"/>
            <line x1="1" y1="27" x2="5.5" y2="27" stroke="#6B6050" stroke-width="1.4"/>
          </svg>
          <span>{{ 'cm.cart.intl_shipping' | t }}</span>
        </div>

        <!-- Garantía 100% -->
        <div class="cart-value-item">
          <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M28.5 18a10.5 10.5 0 1 0-3 7.4" stroke="#6B6050" stroke-width="1.4" stroke-linecap="round" fill="none"/>
            <path d="M28.5 10.5V18H21" stroke="#6B6050" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            <path d="M13 18.5l3.5 3.5 6.5-7" stroke="#6B6050" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span>Garantía 100% de satisfacción</span>
        </div>

        <!-- Calidad garantizada -->
        <div class="cart-value-item">
          <svg width="32" height="32" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 22 L9 32 L14 29 L17 33 L20 22" stroke="#6B6050" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
            <path d="M22 22 L27 32 L22 29 L19 33 L18 22" stroke="#6B6050" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
            <circle cx="18" cy="14" r="10" stroke="#6B6050" stroke-width="1.4" fill="none"/>
            <circle cx="18" cy="14" r="7" stroke="#6B6050" stroke-width="1" fill="none"/>
            <path d="M13.5 14 L16.5 17 L22.5 11" stroke="#6B6050" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span>{{ 'cm.cart.quality' | t }}</span>
        </div>

      </div>
    </div>

  </div>
</div>

<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
