{%- comment -%}
  Nosotros — Proceso
  Recorrido de selección: timeline lateral con una imagen protagonista que
  cambia al pasar por cada paso. En escritorio responde al hover y al foco;
  en táctil, al tocar. Sin scroll-jacking: toda la escena cabe de una vez.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{% render 'cm-reveal' %}

<style>
  #nsp-{{ section.id }} {
    background: {% if s.theme == 'dark' %}var(--cm-navy){% else %}var(--cm-off){% endif %};
    --nsp-ink:   {% if s.theme == 'dark' %}var(--cm-off){% else %}var(--cm-navy){% endif %};
    --nsp-muted: {% if s.theme == 'dark' %}rgba(250,246,239,0.58){% else %}var(--cm-text-mid){% endif %};
    --nsp-hair:  {% if s.theme == 'dark' %}rgba(250,246,239,0.14){% else %}rgba(0,41,75,0.13){% endif %};
    padding-block: clamp(64px, 9vw, 132px);
    overflow: hidden;
  }

  #nsp-{{ section.id }} .nsp__wrap {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 72px);
  }

  #nsp-{{ section.id }} .nsp__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 0 0 20px;
  }

  #nsp-{{ section.id }} .nsp__title {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(30px, 4vw, 58px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--nsp-ink);
    margin: 0 0 clamp(40px, 6vw, 76px);
    max-width: 18ch;
    text-wrap: balance;
  }
  #nsp-{{ section.id }} .nsp__title em { font-style: italic; color: var(--cm-gold); }

  #nsp-{{ section.id }} .nsp__grid {
    display: grid;
    grid-template-columns: {% if s.media_side == 'left' %}1.05fr 0.95fr{% else %}0.95fr 1.05fr{% endif %};
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  /* ── Imagen protagonista ── */
  #nsp-{{ section.id }} .nsp__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ s.ratio }};
    overflow: hidden;
    background: {% if s.theme == 'dark' %}rgba(250,246,239,0.05){% else %}rgba(0,41,75,0.05){% endif %};
    {% if s.media_side == 'left' %}grid-column: 1; grid-row: 1;{% else %}grid-column: 2; grid-row: 1;{% endif %}
  }

  #nsp-{{ section.id }} .nsp__shot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
                transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform: scale(1.045);
  }
  #nsp-{{ section.id }} .nsp__shot.is-on {
    opacity: 1;
    transform: scale(1);
  }
  #nsp-{{ section.id }} .nsp__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #nsp-{{ section.id }} .nsp__empty {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(150deg, #002845 0%, #001428 100%);
  }

  #nsp-{{ section.id }} .nsp__ghost {
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-size: clamp(64px, 12vw, 150px);
    color: rgba(196, 151, 58, 0.16);
    line-height: 1;
    user-select: none;
  }

  /* ── Timeline ── */
  #nsp-{{ section.id }} .nsp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    {% if s.media_side == 'left' %}grid-column: 2; grid-row: 1;{% else %}grid-column: 1; grid-row: 1;{% endif %}
  }

  /* la línea del tiempo */
  #nsp-{{ section.id }} .nsp__list::before {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--nsp-hair);
  }

  #nsp-{{ section.id }} .nsp__step { position: relative; }

  #nsp-{{ section.id }} .nsp__btn {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 20px;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 17px 0 17px 26px;
    cursor: pointer;
    font: inherit;
    color: inherit;
    position: relative;
  }

  /* marca del paso sobre la línea */
  #nsp-{{ section.id }} .nsp__btn::before {
    content: '';
    position: absolute;
    left: -2px;
    top: 27px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--nsp-hair);
    transition: background 0.4s ease, transform 0.4s ease;
  }
  #nsp-{{ section.id }} .nsp__step.is-on .nsp__btn::before {
    background: var(--cm-gold);
    transform: scale(1.7);
  }

  #nsp-{{ section.id }} .nsp__num {
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--cm-gold);
    opacity: 0.5;
    transition: opacity 0.4s ease;
    font-variant-numeric: tabular-nums;
  }
  #nsp-{{ section.id }} .nsp__step.is-on .nsp__num { opacity: 1; }

  #nsp-{{ section.id }} .nsp__name {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(21px, 2.3vw, 31px);
    line-height: 1.25;
    color: var(--nsp-ink);
    opacity: 0.42;
    transition: opacity 0.4s ease;
  }
  #nsp-{{ section.id }} .nsp__step.is-on .nsp__name { opacity: 1; }

  /* descripción: solo visible en el paso activo */
  #nsp-{{ section.id }} .nsp__desc {
    grid-column: 2;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.45s ease;
  }
  #nsp-{{ section.id }} .nsp__step.is-on .nsp__desc {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  #nsp-{{ section.id }} .nsp__desc > div {
    overflow: hidden;
    font-family: var(--cm-font-sans);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--nsp-muted);
    max-width: 46ch;
  }
  #nsp-{{ section.id }} .nsp__desc > div p { margin: 0 0 1em; }
  #nsp-{{ section.id }} .nsp__desc > div p:last-child { margin-bottom: 0; }
  #nsp-{{ section.id }} .nsp__step.is-on .nsp__desc > div { padding-top: 12px; }

  #nsp-{{ section.id }} .nsp__btn:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    #nsp-{{ section.id }} .nsp__btn:hover .nsp__name { opacity: 0.8; }
    #nsp-{{ section.id }} .nsp__step.is-on .nsp__btn:hover .nsp__name { opacity: 1; }
  }

  /* ── Móvil: imagen grande arriba, timeline debajo ── */
  @media (max-width: 900px) {
    #nsp-{{ section.id }} .nsp__grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    #nsp-{{ section.id }} .nsp__media {
      grid-column: 1;
      grid-row: 1;
      aspect-ratio: {{ s.ratio_mobile }};
    }
    #nsp-{{ section.id }} .nsp__list {
      grid-column: 1;
      grid-row: 2;
    }
    #nsp-{{ section.id }} .nsp__name { font-size: 20px; }
    #nsp-{{ section.id }} .nsp__btn { padding-block: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #nsp-{{ section.id }} .nsp__shot { transition: opacity 0.2s linear; transform: none; }
    #nsp-{{ section.id }} .nsp__shot.is-on { transform: none; }
  }
</style>

<section id="nsp-{{ section.id }}" class="nsp">
  <div class="nsp__wrap">

    {%- if s.eyebrow != blank -%}
      <p class="nsp__eyebrow" data-cm-reveal>{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.title != blank -%}
      <h2 class="nsp__title" data-cm-reveal data-cm-delay="1">{{ s.title }}</h2>
    {%- endif -%}

    <div class="nsp__grid">

      <div class="nsp__media" data-cm-reveal data-cm-delay="2">
        {%- for block in section.blocks -%}
          <div class="nsp__shot{% if forloop.first %} is-on{% endif %}" data-shot="{{ forloop.index0 }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1400, format: 'webp'
                | image_tag:
                    loading: 'lazy',
                    sizes: '(max-width: 900px) 100vw, 50vw',
                    widths: '600, 900, 1200, 1400',
                    alt: block.settings.title | escape
              }}
            {%- else -%}
              <div class="nsp__empty">
                <span class="nsp__ghost" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <ol class="nsp__list" data-cm-reveal data-cm-delay="3">
        {%- for block in section.blocks -%}
          <li class="nsp__step{% if forloop.first %} is-on{% endif %}" data-step="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <button class="nsp__btn" type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="nsp__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="nsp__name">{{ block.settings.title }}</span>
              {%- if block.settings.description != blank -%}
                <span class="nsp__desc"><div>{{ block.settings.description }}</div></span>
              {%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ol>

    </div>
  </div>
</section>

<script>
(function () {
  var sec = document.getElementById('nsp-{{ section.id }}');
  if (!sec) return;

  var steps = Array.prototype.slice.call(sec.querySelectorAll('.nsp__step'));
  var shots = Array.prototype.slice.call(sec.querySelectorAll('.nsp__shot'));
  if (!steps.length) return;

  var current = 0;
  var hoverable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function activate(i) {
    if (i === current || i < 0 || i >= steps.length) return;
    current = i;
    steps.forEach(function (el, k) {
      var on = k === i;
      el.classList.toggle('is-on', on);
      var btn = el.querySelector('.nsp__btn');
      if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    shots.forEach(function (el, k) { el.classList.toggle('is-on', k === i); });
  }

  steps.forEach(function (el, i) {
    var btn = el.querySelector('.nsp__btn');
    if (!btn) return;
    btn.addEventListener('click', function () { activate(i); });
    btn.addEventListener('focus', function () { activate(i); });
    if (hoverable) {
      el.addEventListener('mouseenter', function () { activate(i); });
    }
  });
})();
</script>

{% schema %}
{
  "name": "Nosotros — Proceso",
  "tag": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Si se deja vacía, el panel muestra el número del paso." },
        { "type": "text", "id": "title", "label": "Título", "default": "La Dehesa" },
        {
          "type": "richtext",
          "id": "description",
          "label": "Descripción",
          "info": "Una o dos frases, o varios párrafos. Solo se ve en el paso activo.",
          "default": "<p>El ecosistema donde nace todo. Encinas centenarias, suelo fértil, espacio sin límites.</p>"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta superior", "default": "El proceso de selección" },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>De la dehesa <em>a tu mesa</em></p>"
    },
    {
      "type": "select",
      "id": "theme",
      "label": "Fondo",
      "options": [
        { "value": "light", "label": "Crema" },
        { "value": "dark", "label": "Navy" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "media_side",
      "label": "Lado de la imagen",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la imagen (escritorio)",
      "options": [
        { "value": "4 / 5", "label": "Vertical 4:5" },
        { "value": "3 / 4", "label": "Vertical 3:4" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 3", "label": "Horizontal 4:3" },
        { "value": "3 / 2", "label": "Horizontal 3:2" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción de la imagen (móvil)",
      "options": [
        { "value": "4 / 5", "label": "Vertical 4:5" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 3", "label": "Horizontal 4:3" },
        { "value": "3 / 2", "label": "Horizontal 3:2" }
      ],
      "default": "4 / 3"
    }
  ],
  "presets": [
    {
      "name": "Nosotros — Proceso",
      "blocks": [
        { "type": "step", "settings": { "title": "La Dehesa", "description": "<p>El ecosistema donde nace todo. Encinas centenarias, suelo fértil, espacio sin límites para el animal que lo llena todo.</p>" } },
        { "type": "step", "settings": { "title": "La Raza", "description": "<p>Ibérico puro. Sin cruzamientos que comprometan el sabor o la calidad. La raza define el potencial.</p>" } },
        { "type": "step", "settings": { "title": "La Montanera", "description": "<p>Cada otoño, los cerdos pastan libremente bajo las encinas. Las bellotas hacen el resto.</p>" } },
        { "type": "step", "settings": { "title": "La Maduración", "description": "<p>El tiempo que cada pieza necesita en bodega. La paciencia es el ingrediente que no se puede comprar.</p>" } },
        { "type": "step", "settings": { "title": "Nuestra Selección", "description": "<p>Visitamos, probamos, comparamos. Solo elegimos lo que nosotros mismos compraríamos.</p>" } },
        { "type": "step", "settings": { "title": "Tu Mesa", "description": "<p>El momento para el que todo existe. El disfrute que justifica cada decisión anterior.</p>" } }
      ]
    }
  ]
}
{% endschema %}
