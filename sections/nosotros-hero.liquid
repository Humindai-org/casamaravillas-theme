{%- comment -%}
  Nosotros — Apertura
  Fotografía editorial a sangre completa, seguida de una franja en el mismo
  crema del resto de la página ("Nuestra historia") con el titular. El corte
  entre foto y franja es limpio, sin degradado.

  El encuadre se controla por proporción (no por vh) para conservar la mayor
  parte posible del original — un alto fijo en vh recorta más cuanto más
  ancha es la pantalla.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign pos_x = s.image_pos_x | default: 50
  assign pos_y = s.image_pos_y | default: 50
  assign heading = s.title | default: 'Tres generaciones eligiendo lo mejor del campo ibérico'
-%}

{% render 'cm-reveal' %}

<style>
  #nsh-{{ section.id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ s.ratio }};
    max-height: {{ s.max_height }}vh;
    overflow: hidden;
    background: var(--cm-navy);
  }

  #nsh-{{ section.id }} .nsh__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ pos_x }}% {{ pos_y }}%;
    {% if s.ken_burns %}
      transform: scale(1.04);
      animation: nshDrift-{{ section.id }} 18s ease-out forwards;
    {% endif %}
  }

  {% if s.ken_burns %}
  @keyframes nshDrift-{{ section.id }} {
    from { transform: scale(1.075); }
    to   { transform: scale(1); }
  }
  {% endif %}

  #nsh-{{ section.id }} .nsh__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 18, 34, 0.42) 0%,
      rgba(0, 18, 34, 0) 32%
    );
  }

  #nsh-{{ section.id }} .nsh__top {
    position: absolute;
    top: clamp(24px, 4vw, 48px);
    left: 0;
    right: 0;
    text-align: center;
    z-index: 3;
  }

  #nsh-{{ section.id }} .nsh__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.55em;
    text-transform: uppercase;
    color: rgba(250, 246, 239, 0.88);
    margin: 0;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6);
  }

  #nsh-band-{{ section.id }} {
    background: var(--cm-off);
    padding-block: 0 clamp(12px, 1.6vw, 20px);
  }

  #nsh-band-{{ section.id }} .nsh__inner {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: clamp(24px, 5vw, 72px);
    text-align: {{ s.align }};
  }

  #nsh-band-{{ section.id }} .nsh__title {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(27px, {{ s.size_vw }}vw, {{ s.size_max }}px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--cm-navy);
    margin: 0;
    max-width: {{ s.measure }}ch;
    text-wrap: balance;
    {% if s.align == 'center' %}margin-inline: auto;{% endif %}
  }
  #nsh-band-{{ section.id }} .nsh__title em { font-style: italic; color: var(--cm-gold); }

  @media (min-width: 768px) {
    #nsh-band-{{ section.id }} .nsh__title {
      white-space: nowrap;
      max-width: none;
      font-size: clamp(26px, 3.6vw, 56px);
    }
  }

  #nsh-band-{{ section.id }} .nsh__rule {
    width: 46px;
    height: 1px;
    background: var(--cm-gold);
    margin: clamp(20px, 2.6vw, 30px) 0 0;
    {% if s.align == 'center' %}margin-inline: auto;{% endif %}
  }

  #nsh-band-{{ section.id }} .nsh__sub {
    font-family: var(--cm-font-sans);
    font-size: 13.5px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--cm-text-mid);
    margin: clamp(18px, 2.4vw, 26px) 0 0;
    max-width: 46ch;
    {% if s.align == 'center' %}margin-inline: auto;{% endif %}
  }

  @media (max-width: 767px) {
    #nsh-{{ section.id }} {
      aspect-ratio: {{ s.ratio_mobile }};
      max-height: {{ s.max_height_mobile }}vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #nsh-{{ section.id }} .nsh__img { animation: none; transform: none; }
  }
</style>

<section id="nsh-{{ section.id }}" class="nsh">
  {%- if s.image != blank -%}
    {{ s.image
      | image_url: width: 2600, format: 'webp'
      | image_tag:
          class: 'nsh__img',
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000, 2600',
          alt: s.image.alt | escape
    }}
  {%- endif -%}

  <div class="nsh__veil" aria-hidden="true"></div>

  {%- if s.eyebrow != blank -%}
    <div class="nsh__top">
      <p class="nsh__eyebrow">{{ s.eyebrow }}</p>
    </div>
  {%- endif -%}
</section>

<div id="nsh-band-{{ section.id }}">
  <div class="nsh__inner">
    {%- if heading != blank -%}
      <h1 class="nsh__title" data-cm-reveal>{{ heading }}</h1>
      <span class="nsh__rule" data-cm-reveal data-cm-delay="1" aria-hidden="true"></span>
    {%- endif -%}
    {%- if s.subtitle != blank -%}
      <p class="nsh__sub" data-cm-reveal data-cm-delay="2">{{ s.subtitle }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Nosotros — Apertura",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Fotografía"
    },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción (escritorio)",
      "info": "Cuanto más panorámica, más recorta la foto original por arriba y abajo.",
      "options": [
        { "value": "4 / 3", "label": "4:3 — conserva casi toda la foto" },
        { "value": "3 / 2", "label": "3:2 — recorte leve" },
        { "value": "16 / 9", "label": "16:9 — cinematográfica" },
        { "value": "21 / 9", "label": "21:9 — panorámica extrema" }
      ],
      "default": "3 / 2"
    },
    {
      "type": "range",
      "id": "max_height",
      "label": "Alto máximo (escritorio)",
      "info": "Tope para que la apertura no empuje el resto de la página fuera de pantalla.",
      "min": 60, "max": 100, "step": 5, "default": 90, "unit": "vh"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción (móvil)",
      "options": [
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Vertical 4:5" }
      ],
      "default": "4 / 3"
    },
    { "type": "range", "id": "max_height_mobile", "label": "Alto máximo (móvil)", "min": 50, "max": 100, "step": 5, "default": 80, "unit": "vh" },
    {
      "type": "range",
      "id": "image_pos_x",
      "label": "Posición horizontal",
      "info": "0% = izquierda · 100% = derecha",
      "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y",
      "label": "Posición vertical",
      "info": "0% = arriba · 100% = abajo",
      "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%"
    },
    { "type": "checkbox", "id": "ken_burns", "label": "Zoom lento al cargar", "default": true },
    {
      "type": "header",
      "content": "Texto"
    },
    { "type": "text", "id": "eyebrow", "label": "Etiqueta sobre la imagen", "default": "Nuestra historia" },
    {
      "type": "text",
      "id": "title",
      "label": "Titular",
      "default": "Tres generaciones eligiendo lo mejor del campo ibérico"
    },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "info": "Opcional. Mantenlo muy corto." },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del titular",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "measure", "label": "Ancho del titular", "min": 12, "max": 40, "step": 1, "default": 20, "unit": "ch" },
    { "type": "range", "id": "size_vw", "label": "Crecimiento tipográfico", "min": 2, "max": 8, "step": 0.5, "default": 4.5, "unit": "vw" },
    { "type": "range", "id": "size_max", "label": "Tamaño máximo", "min": 32, "max": 110, "step": 2, "default": 68, "unit": "px" }
  ],
  "presets": [
    {
      "name": "Nosotros — Apertura"
    }
  ]
}
{% endschema %}
