<style>
  .nsh {
    position: relative;
  }

  .nsh__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .nsh__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_pos_x | default: 50 }}% {{ section.settings.image_pos_y | default: 50 }}%;
    opacity: 1;
    transform: scale(1.08);
    animation: nshKenBurns 10s ease-out forwards;
  }

  @keyframes nshKenBurns {
    from { transform: scale(1.08); }
    to   { transform: scale(1.0);  }
  }

  .nsh__grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  /* Eyebrow overlaid on the photo — mobile only */
  .nsh__eyebrow--media {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    text-align: center;
    color: var(--cm-off);
    text-shadow: 0 2px 10px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.35);
    z-index: 3;
    margin-bottom: 0;
  }

  .nsh__eyebrow--band { display: none; }

  .nsh__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 18px 24px calc(env(safe-area-inset-bottom, 0px) + 18px);
    background: linear-gradient(135deg, var(--cm-gold) 0%, var(--cm-gold-h) 100%);
    box-shadow:
      0 -16px 28px -18px rgba(0,41,75,0.35),
      0 -4px 10px -6px rgba(0,41,75,0.25);
  }

  .nsh__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--cm-navy);
    margin-bottom: 16px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s 0.2s ease, transform 0.7s 0.2s ease;
  }

  .nsh__rule {
    width: 0px;
    height: 1px;
    background: rgba(0,41,75,0.4);
    margin-bottom: 14px;
    opacity: 0;
    transition: opacity 0.6s 0.4s ease, width 0.8s 0.4s ease;
  }

  /* Title — words animate individually via JS */
  .nsh__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(24px, 6.5vw, 32px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.15;
    max-width: 760px;
    margin-bottom: 10px;
  }

  @keyframes nshWordIn {
    from { opacity: 0; filter: blur(8px); }
    to   { opacity: 1; filter: blur(0); }
  }

  .nsh__word {
    display: inline-block;
    animation: nshWordIn 0.75s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  .nsh__subtitle {
    font-family: var(--cm-font-sans);
    font-size: clamp(12px, 1.8vw, 16px);
    font-weight: 700;
    color: var(--cm-navy);
    letter-spacing: 0.08em;
    max-width: 480px;
    line-height: 1.8;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s 0.75s ease, transform 0.7s 0.75s ease;
  }

  .nsh.is-loaded .nsh__eyebrow,
  .nsh.is-loaded .nsh__subtitle { opacity: 1; transform: translateY(0); }
  .nsh.is-loaded .nsh__rule { opacity: 1; width: 48px; }

  @media (min-width: 768px) {
    .nsh__media { aspect-ratio: 16 / 9; }

    .nsh__eyebrow--media { display: none; }
    .nsh__eyebrow--band { display: block; }

    .nsh__content {
      padding: 56px 24px 64px;
    }

    .nsh__eyebrow,
    .nsh__rule { margin-bottom: 32px; }

    .nsh__title {
      font-size: clamp(32px, 5.5vw, 72px);
      margin-bottom: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nsh__bg { animation: none; transform: scale(1.0); }
    .nsh__eyebrow, .nsh__subtitle { opacity: 1; transform: none; transition: none; }
    .nsh__rule { opacity: 1; width: 48px; transition: none; }
    .nsh__word { animation: none; opacity: 1; filter: none; }
  }
</style>

<section class="nsh" id="nsh-{{ section.id }}" aria-label="{{ section.settings.eyebrow | default: 'Nuestra historia' }}">

  <div class="nsh__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 1800, format: 'webp'
        | image_tag:
            class: 'nsh__bg',
            loading: 'eager',
            fetchpriority: 'high',
            alt: section.settings.image.alt | escape
      }}
    {%- endif -%}
    <div class="nsh__grain" aria-hidden="true"></div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="nsh__eyebrow nsh__eyebrow--media">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
  </div>

  <div class="nsh__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nsh__eyebrow nsh__eyebrow--band">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="nsh__title" id="nsh-title-{{ section.id }}">
      {{ section.settings.title | default: 'Tres generaciones eligiendo lo mejor del campo ibérico' }}
    </h1>

    <div class="nsh__rule" aria-hidden="true"></div>

    {%- if section.settings.subtitle != blank -%}
      <p class="nsh__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

</section>

<script>
(function() {
  var el = document.getElementById('nsh-{{ section.id }}');
  if (!el) return;

  var titleEl = document.getElementById('nsh-title-{{ section.id }}');

  if (titleEl && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var words = titleEl.textContent.trim().split(/\s+/);
    var baseDelay = 0.38;
    titleEl.innerHTML = words.map(function(w, i) {
      var delay = (baseDelay + i * 0.07).toFixed(2);
      return '<span class="nsh__word" style="animation-delay:' + delay + 's">' + w + '</span>';
    }).join(' ');
  }

  requestAnimationFrame(function() {
    requestAnimationFrame(function() {
      el.classList.add('is-loaded');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Nosotros — Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Nuestra historia"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título principal",
      "default": "Tres generaciones eligiendo lo mejor del campo ibérico"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Una convicción que se hereda, un estándar que no se negocia"
    },
    {
      "type": "range",
      "id": "image_pos_x",
      "label": "Posición horizontal imagen",
      "info": "0% = izquierda · 50% = centro · 100% = derecha",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y",
      "label": "Posición vertical imagen",
      "info": "0% = arriba · 50% = centro · 100% = abajo",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Nosotros — Hero"
    }
  ]
}
{% endschema %}
