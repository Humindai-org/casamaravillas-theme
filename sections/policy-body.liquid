<style>
  .policy-body-section {
    padding: 80px 72px 96px;
    max-width: 780px;
    margin: 0 auto;
    background: var(--cm-white);
  }

  .policy-body-section__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(30px, 3.5vw, 44px);
    font-weight: 400;
    color: var(--cm-navy);
    margin-bottom: 36px;
    line-height: 1.15;
    text-align: left;
  }

  .policy-body-section__content {
    font-family: var(--cm-font-sans);
    font-size: 15px;
    line-height: 1.85;
    color: var(--cm-text-mid);
  }

  .policy-body-section__content h2,
  .policy-body-section__content h3 {
    font-family: var(--cm-font-serif);
    color: var(--cm-navy);
    margin: 2em 0 0.65em;
    font-size: 1.45em;
    font-weight: 400;
    line-height: 1.2;
    text-align: left;
  }

  .policy-body-section__content h2:first-child,
  .policy-body-section__content h3:first-child {
    margin-top: 0;
  }

  .policy-body-section__content p {
    margin-bottom: 1.1em;
  }

  .policy-body-section__content a {
    color: var(--cm-gold);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .policy-body-section__content a:hover { color: var(--cm-gold-h); }

  .policy-body-section__content ul,
  .policy-body-section__content ol {
    margin: 0 0 1.2em 1.5em;
    list-style: disc !important;
    padding-left: 0.25em;
  }

  .policy-body-section__content ol {
    list-style: decimal !important;
  }

  .policy-body-section__content li {
    margin-bottom: 0.5em;
    list-style: inherit !important;
  }

  .policy-body-section__content strong {
    color: var(--cm-navy);
    font-weight: 600;
  }

  .policy-body-section__content em {
    font-style: italic;
    color: rgba(0,0,0,0.45);
    font-size: 0.9em;
  }

  .policy-body-section__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0 1.8em;
    font-size: 0.88em;
  }

  .policy-body-section__content th {
    background: var(--cm-navy);
    color: var(--cm-white);
    font-family: var(--cm-font-sans);
    font-weight: 600;
    text-align: left;
    padding: 10px 14px;
    font-size: 0.82em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .policy-body-section__content td {
    padding: 9px 14px;
    border-bottom: 1px solid rgba(0,0,0,0.07);
    color: var(--cm-text-mid);
    vertical-align: middle;
  }

  .policy-body-section__content tr:last-child td { border-bottom: none; }

  .policy-body-section__content tbody tr:nth-child(even) td {
    background: rgba(0,0,0,0.025);
  }

  @media (max-width: 767px) {
    .policy-body-section__content table { font-size: 0.78em; }
    .policy-body-section__content th,
    .policy-body-section__content td { padding: 7px 8px; }
  }

  @media (max-width: 1023px) {
    .policy-body-section { padding: 64px 48px 80px; }
  }

  @media (max-width: 767px) {
    .policy-body-section { padding: 48px 24px 72px; }
    .policy-body-section__title { margin-bottom: 24px; }
  }
</style>

<section class="policy-body-section">
  <h1 class="policy-body-section__title">{{ policy.title }}</h1>
  <div class="policy-body-section__content rte">
    {%- if policy.handle == 'shipping-policy' -%}
      <h2>{{ 'cm.ship.procesamiento_de_pedidos' | t }}</h2>
      <p>{{ 'cm.ship.los_pedidos_se_procesan' | t }}</p>
      <p>{{ 'cm.ship.una_vez_enviado_tu' | t }}</p>

      <h2>{{ 'cm.ship.envios_a_espana_peninsular' | t }}</h2>
      <p>{{ 'cm.ship.plazo_de_entrega_2448_html' | t }}</p>
      <p>{{ 'cm.ship.gastos_de_envio_iva_html' | t }}</p>
      <ul>
        <li>{{ 'cm.ship.jamon_entero_10_kg_html' | t }}</li>
        <li>{{ 'cm.ship.jamon_deshuesado_6_kg_html' | t }}</li>
        <li>{{ 'cm.ship.jamon_cortado_a_mano_html' | t }}</li>
        <li>{{ 'cm.ship.embutidos_enteros_0_60_html' | t }}</li>
        <li>{{ 'cm.ship.embutidos_loncheados_100_g_html' | t }}</li>
      </ul>
      <p>{{ 'cm.ship.envio_gratis_para_pedidos_html' | t }}</p>

      <h2>{{ 'cm.ship.islas_baleares_canarias_ceuta' | t }}</h2>
      {%- comment -%} Baleares desactivado hasta que el cliente confirme tarifa de transportista. {%- endcomment -%}
      <p>{{ 'cm.ship.por_el_momento_no_2_html' | t }}</p>

      <h2>{{ 'cm.ship.envios_internacionales' | t }}</h2>
      <p>{{ 'cm.ship.enviamos_a_toda_europa' | t }}</p>
      <p>{{ 'cm.ship.plazos_de_entrega_35_html' | t }}</p>
      <p>
        <strong>{{ 'cm.ship.zona_1' | t }}</strong> — Alemania · Italia · Mónaco<br>
        <strong>{{ 'cm.ship.zona_2' | t }}</strong> — Bélgica · Luxemburgo · Países Bajos · Polonia · República Checa<br>
        <strong>{{ 'cm.ship.zona_3' | t }}</strong> — Austria · Bulgaria · Croacia · Dinamarca · Eslovaquia · Eslovenia · Estonia · Finlandia · Grecia · Hungría · Irlanda · Letonia · Lituania · Rumanía · Suecia<br>
        <strong>{{ 'cm.ship.zona_4' | t }}</strong> — Reino Unido<br>
        <strong>{{ 'cm.ship.zona_5' | t }}</strong> — Francia
      </p>
      <table>
        <thead>
          <tr>
            <th>{{ 'cm.ship.producto' | t }}</th>
            <th>{{ 'cm.ship.zona_1' | t }}</th>
            <th>{{ 'cm.ship.zona_2' | t }}</th>
            <th>{{ 'cm.ship.zona_3' | t }}</th>
            <th>{{ 'cm.ship.zona_4' | t }}</th>
            <th>{{ 'cm.ship.zona_5' | t }}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>{{ 'cm.ship.jamon_entero_10_kg' | t }}</td>
            <td>40,27 €</td><td>45,01 €</td><td>54,44 €</td><td>47,68 €</td><td>40,27 €</td>
          </tr>
          <tr>
            <td>{{ 'cm.ship.jamon_deshuesado_6_kg' | t }}</td>
            <td>33,67 €</td><td>39,14 €</td><td>42,64 €</td><td>39,61 €</td><td>33,67 €</td>
          </tr>
          <tr>
            <td>{{ 'cm.ship.jamon_cortado_a_mano' | t }}</td>
            <td>30,95 €</td><td>32,67 €</td><td>39,38 €</td><td>35,53 €</td><td>30,95 €</td>
          </tr>
          <tr>
            <td>{{ 'cm.ship.embutidos_loncheados' | t }}</td>
            <td>26,75 €</td><td>28,32 €</td><td>33,86 €</td><td>33,06 €</td><td>26,75 €</td>
          </tr>
        </tbody>
      </table>
      <p>{{ 'cm.ship.para_envios_al_reino_2_html' | t }}</p>
      <p>{{ 'cm.ship.paises_bajo_consulta_bosnia_html' | t }}</p>

      <h2>{{ 'cm.ship.embalaje' | t }}</h2>
      <p>{{ 'cm.ship.cada_pedido_sale_de' | t }}</p>

      <h2>{{ 'cm.ship.incidencias_en_el_envio' | t }}</h2>
      <p>{{ 'cm.ship.si_recibes_tu_pedido_2_html' | t }}</p>

      <h2>{{ 'cm.ship.periodos_de_alta_demanda' | t }}</h2>
      <p>{{ 'cm.ship.en_temporadas_de_alta' | t }}</p>

      <h2>{{ 'cm.ship.tienes_dudas' | t }}</h2>
      <p>
        Email: <a href="mailto:info@casamaravillas.com">info@casamaravillas.com</a><br>
        {{ 'cm.ship.telefono' | t }}: <a href="tel:966113446">966 11 34 46</a><br>
        {{ 'cm.dev.horario_de_atencion_lunes' | t }}
      </p>
    {%- else -%}
      {{ policy.body }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contenido de política",
  "tag": "section"
}
{% endschema %}
