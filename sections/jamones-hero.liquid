{% comment %}
  jamones-hero.liquid
  Hero con scroll expansion: frame escala de 0.85 a 1 mientras el sticky viaja.
{% endcomment %}

<style>
  .jh-{{ section.id }} {
    position: relative;
    height: 100svh;
    background: #e4e4e4;
  }

  .jh__sticky-{{ section.id }} {
    position: relative;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .jh__bg-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .jh__bg-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .jh__bg-overlay-{{ section.id }} {
    display: none;
  }

  .jh__bg-wash-{{ section.id }} {
    position: absolute;
    inset: 0;
    z-index: 1.5;
    background: linear-gradient(to top, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.6) 30%, rgba(255, 255, 255, 0) 70%);
    will-change: opacity;
    pointer-events: none;
  }

  .jh__frame-{{ section.id }} {
    position: absolute;
    top: 65%;
    left: 50%;
    z-index: 2;
    border-radius: 0;
    box-shadow: none;
    overflow: hidden;
    will-change: transform;
    transform: translate(-50%, -50%) scale(0.3);
    width: 850px;
    height: 1000px;
    background-position: center;
    background-repeat: no-repeat;
    background-size: 250%;
  }

  .jh__img-secondary-{{ section.id }} {
    display: none;
  }

  .jh__img-secondary-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .jh__content-{{ section.id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: 0 60px 20px 60px;
    pointer-events: none;
  }

  .jh__eyebrow-wrapper-{{ section.id }} {
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .jh__eyebrow-{{ section.id }} {
    margin-bottom: 0;
    margin-top: 0;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s 0.1s ease, transform 0.7s 0.1s ease;
  }

  .jh__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: clamp(80px, 13vw, 180px);
    font-weight: 400;
    color: #1f1f1f;
    line-height: 1;
    letter-spacing: -0.015em;
    margin-bottom: 24px;
    margin-top: 0;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.85s 0.3s ease, transform 0.85s 0.3s ease;
    white-space: nowrap;
  }

  .jh__heading-{{ section.id }} em {
    font-style: italic;
    color: var(--cm-gold);
  }

  .jh__subheading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-size: clamp(13px, 1.8vw, 19px);
    color: rgba(250, 246, 239, 0.6);
    margin-bottom: 12px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s 0.45s ease, transform 0.7s 0.45s ease;
  }

  .jh__body-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: clamp(13px, 1.5vw, 16px);
    font-weight: 300;
    color: #000;
    max-width: 440px;
    line-height: 1.7;
    margin-bottom: 56px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s 0.55s ease, transform 0.7s 0.55s ease;
  }

  .jh__scroll-hint-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s 0.9s ease, transform 0.6s 0.9s ease;
    pointer-events: none;
  }

  .jh__scroll-label-{{ section.id }} {
    font-size: 8.5px;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--cm-font-sans);
    font-weight: 400;
  }

  .jh__scroll-line-{{ section.id }} {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--cm-gold), transparent);
  }

  .jh__eyebrow-wrapper-{{ section.id }}.jh-visible .jh__eyebrow-{{ section.id }},
  .jh__content-{{ section.id }}.jh-visible .jh__heading-{{ section.id }},
  .jh__content-{{ section.id }}.jh-visible .jh__subheading-{{ section.id }},
  .jh__content-{{ section.id }}.jh-visible .jh__body-{{ section.id }},
  .jh__content-{{ section.id }}.jh-visible .jh__scroll-hint-{{ section.id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .jh__bg-img-{{ section.id }} {
    object-position: {{ section.settings.image_pos_x | default: 50 }}% {{ section.settings.image_pos_y | default: 50 }}%;
  }

  @media (max-width: 767px) {
    .jh-{{ section.id }} { height: 64svh; min-height: 360px; background: transparent; }
    .jh__sticky-{{ section.id }} { position: relative; height: 64svh; min-height: 360px; }
    .jh__eyebrow-{{ section.id }} { color: rgba(255, 255, 255, 0.9); }
    .jh__bg-img-{{ section.id }} {
      object-position: {{ section.settings.image_pos_x | default: 50 }}% {{ section.settings.image_pos_y_mobile | default: 70 }}%;
      transform: scale(1.25) translateY(-10%);
    }
    .jh__frame-{{ section.id }} {
      top: 68%;
      width: 90vw;
      height: 120vw;
      max-width: 480px;
      max-height: 700px;
    }
    .jh__heading-{{ section.id }} { font-size: clamp(48px, 12vw, 100px); }
    .jh__content-{{ section.id }} { padding: 32px 24px 0 24px; }
  }
</style>

{%- liquid
  assign jh_heading = section.settings.heading | default: 'Jamones Ibéricos'
  assign jh_words   = jh_heading | split: ' '
  assign jh_first   = jh_words | first
  assign jh_rest    = jh_heading | remove_first: jh_first | strip
-%}

<section
  class="jh-{{ section.id }}"
  id="jh-section-{{ section.id }}"
>
  <div class="jh__sticky-{{ section.id }}">

    {%- if section.settings.image != blank -%}
      <div class="jh__bg-{{ section.id }}">
        {%- assign jh_src = section.settings.image | image_url: width: 2400 -%}
        <img
          class="jh__bg-img-{{ section.id }}"
          src="{{ jh_src }}"
          alt="{{ jh_heading | escape }}"
          width="2400"
          height="1400"
          loading="eager"
        >
        <div class="jh__bg-overlay-{{ section.id }}" id="jh-overlay-{{ section.id }}" aria-hidden="true"></div>
        <div class="jh__bg-wash-{{ section.id }}" aria-hidden="true"></div>
      </div>
    {%- endif -%}

    {%- if section.settings.image_secondary != blank -%}
      {%- assign jh_src_secondary = section.settings.image_secondary | image_url: width: 2400 -%}
      <div
        class="jh__frame-{{ section.id }}"
        id="jh-frame-{{ section.id }}"
        style="background-image: url('{{ jh_src_secondary }}');"
      ></div>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <div class="jh__eyebrow-wrapper-{{ section.id }}">
        <p class="cm-eyebrow jh__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</p>
      </div>
    {%- endif -%}

    <div class="jh__content-{{ section.id }}" id="jh-content-{{ section.id }}">
      <h1 class="jh__heading-{{ section.id }}">
        {{ jh_first }} <em>{{ jh_rest }}</em>
      </h1>

      {%- if section.settings.subheading != blank -%}
        <p class="jh__subheading-{{ section.id }}">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="jh__body-{{ section.id }}">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

  </div>
</section>

<script>
(function () {
  'use strict';

  var sid     = '{{ section.id }}';
  var el      = document.getElementById('jh-section-' + sid);
  var frame   = document.getElementById('jh-frame-' + sid);
  var overlay = document.getElementById('jh-overlay-' + sid);
  var content = document.getElementById('jh-content-' + sid);
  var eyebrowWrapper = el ? el.querySelector('.jh__eyebrow-wrapper-' + sid) : null;

  if (!el) return;

  setTimeout(function () {
    if (content) content.classList.add('jh-visible');
    if (eyebrowWrapper) eyebrowWrapper.classList.add('jh-visible');
  }, 150);

  var isMobile = window.matchMedia('(max-width: 767px)').matches;
  var reduced  = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var ticking = false;

  function lerp(a, b, t) { return a + (b - a) * t; }
  function easeOut(t) { var c = 1 - t; return 1 - c * c * c; }

  function update() {
    ticking = false;
    var rect   = el.getBoundingClientRect();
    var sTop   = rect.top + window.scrollY;
    var travel = el.offsetHeight - window.innerHeight;

    if (travel <= 0) {
      if (frame) {
        frame.style.transform = 'translate(-50%, -50%) scale(1)';
        frame.style.borderRadius = '0px';
        frame.style.boxShadow = 'none';
      }
      return;
    }

    var raw      = Math.min(Math.max((window.scrollY - sTop) / travel, 0), 1);
    var progress = easeOut(raw);
    var scale    = lerp(0.4, 1, progress);
    var bgSize   = lerp(250, 100, progress);

    if (frame) {
      frame.style.transform      = 'translate(-50%, -50%) scale(' + scale + ')';
      frame.style.backgroundSize = bgSize + '%';
    }
  }

  window.addEventListener('scroll', function () {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });

  update();
})();
</script>

{% schema %}
{
  "name": "Hero Jamones",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo principal"
    },
    {
      "type": "image_picker",
      "id": "image_secondary",
      "label": "Imagen de fondo secundaria (opcional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Alicante, España"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Jamones Ibericos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtitulo",
      "default": "Iberian Cured Hams"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Descripcion",
      "default": "De la dehesa a tu mesa. Seleccionamos cada pieza por su crianza, su raza y su curacion."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_x",
      "label": "Posición horizontal imagen",
      "info": "0% = izquierda · 50% = centro · 100% = derecha",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y",
      "label": "Posición vertical imagen",
      "info": "0% = arriba · 50% = centro · 100% = abajo",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y_mobile",
      "label": "Posición vertical imagen (móvil)",
      "info": "Ajuste independiente para móvil — 0% = arriba · 100% = abajo",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero Jamones"
    }
  ]
}
{% endschema %}
