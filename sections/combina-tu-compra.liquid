{%- comment -%} combina-tu-compra.liquid — Upsell cross-familia usando product-card {%- endcomment -%}

{%- liquid
  assign sec_title = section.settings.title | default: 'Combina tu compra con'

  assign current_family = template.suffix

  # Carnes ibéricas oculta temporalmente de las sugerencias — no se ofrece todavía.
  # Para reactivar, volver a incluir 'carnes-ibericas' en las listas de abajo.
  case current_family
    when 'jamones'
      assign families_to_show = 'embutidos,packs-regalo' | split: ','
    when 'embutidos'
      assign families_to_show = 'jamones,packs-regalo' | split: ','
    when 'carnes-ibericas'
      assign families_to_show = 'jamones,embutidos,packs-regalo' | split: ','
    when 'packs-regalo'
      assign families_to_show = 'jamones,embutidos' | split: ','
    else
      assign families_to_show = 'jamones,embutidos,packs-regalo' | split: ','
  endcase
-%}

<style>
  #cm-combina-section {
    display: none;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    margin-top: 56px;
    margin-bottom: 56px;
  }

  #cm-combina-section.is-animating {
    opacity: 1;
    transform: translateY(0);
  }

  .cm-combina {
    background: var(--cm-off);
    border-top: 3px solid var(--pdp-accent, var(--cm-gold));
    border-bottom: 3px solid var(--pdp-accent, var(--cm-gold));
    padding: 48px 72px 56px;
  }

  .cm-combina__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .cm-combina__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 32px;
  }

  .cm-combina__title {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    font-weight: 500;
    color: var(--pdp-accent, var(--cm-gold));
  }

  .cm-combina__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Imagen: contain para ver el producto entero */
  .cm-combina .product-card__img-box img {
    object-fit: contain;
    object-position: center center;
    transform: none !important;
    padding: 12px;
    box-sizing: border-box;
  }

  .cm-combina .product-card:hover .product-card__img-box img {
    transform: scale(1.04) !important;
  }

  @media (max-width: 900px) {
    .cm-combina { padding: 40px 32px 48px; }
    .cm-combina__grid { gap: 16px; }
  }

  @media (max-width: 600px) {
    .cm-combina { padding: 32px 20px 40px; }
    .cm-combina__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
</style>

<div id="cm-combina-section" aria-label="{{ sec_title }}">
  <div class="cm-combina">
    <div class="cm-combina__inner">

      <div class="cm-combina__header">
        <p class="cm-combina__title">{{ sec_title }}</p>
      </div>

      <div class="cm-combina__grid">
        {%- for family in families_to_show -%}
          {%- assign col = collections[family] -%}
          {%- if col != blank and col.products.first != blank -%}
            {% render 'product-card', card_product: col.products.first %}
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Combina tu compra",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título de la sección",
      "default": "Combina tu compra con"
    }
  ],
  "presets": [
    {
      "name": "Combina tu compra"
    }
  ]
}
{% endschema %}
