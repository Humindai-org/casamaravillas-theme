{%- comment -%} combina-tu-compra.liquid — Sección upsell post-ATC para Casa Maravillas {%- endcomment -%}

{%- assign combina_col = section.settings.collection -%}
{%- assign show_count  = section.settings.products_to_show | default: 5 -%}
{%- assign sec_title   = section.settings.title | default: 'Combina tu compra con' -%}

<style>
  /* ── Sección oculta por defecto, se revela tras ATC ── */
  #cm-combina-section {
    display: none;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    margin-bottom: 0;
  }

  #cm-combina-section.is-animating {
    opacity: 1;
    transform: translateY(0);
  }

  .cm-combina {
    background: var(--cm-off);
    border-top: 3px solid var(--pdp-accent, var(--cm-gold));
    padding: 48px 48px 64px;
    margin-bottom: 0;
  }

  .cm-combina__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .cm-combina__eyebrow {
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    font-weight: 500;
    color: var(--pdp-accent, var(--cm-gold));
    margin-bottom: 28px;
  }

  /* ── Carrusel ── */
  .cm-combina__slider {
    position: relative;
    padding: 0 28px;
  }

  .cm-combina__track-wrap {
    overflow: hidden;
  }

  .cm-combina__track {
    display: flex;
    gap: 16px;
    transition: transform 0.4s ease;
    align-items: stretch;
  }

  /* ── Tarjeta ── */
  .cm-combina__card {
    flex: 0 0 calc(20% - 13px);
    min-width: 180px;
    display: flex;
    flex-direction: column;
  }

  .cm-combina__card-inner {
    background: var(--cm-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(10, 30, 60, 0.07), 0 1px 3px rgba(10, 30, 60, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cm-combina__card-inner:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(10, 30, 60, 0.12), 0 2px 6px rgba(10, 30, 60, 0.07);
  }

  /* Imagen */
  .cm-combina__card-img-link {
    display: block;
    text-decoration: none;
  }

  .cm-combina__card-img-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background: linear-gradient(165deg, #f1f0ed 0%, #e6e4df 100%);
    overflow: hidden;
  }

  .cm-combina__card-img {
    position: absolute;
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease;
  }

  .cm-combina__card-inner:hover .cm-combina__card-img { transform: scale(1.05); }

  /* Info */
  .cm-combina__card-info {
    padding: 12px 14px 0;
    flex: 1;
  }

  .cm-combina__card-category {
    font-size: 8px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    font-weight: 500;
    color: var(--cm-gold);
    margin-bottom: 5px;
    display: block;
  }

  .cm-combina__card-name {
    font-family: var(--cm-font-serif);
    font-size: 13px;
    color: var(--cm-navy);
    font-weight: 400;
    line-height: 1.35;
    margin: 0 0 10px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }

  .cm-combina__card-name-link {
    text-decoration: none;
    color: inherit;
  }

  /* Footer con precio + botón ATC */
  .cm-combina__card-foot {
    padding: 10px 14px 14px;
    border-top: 1px solid rgba(10, 30, 60, 0.07);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .cm-combina__card-price {
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: var(--cm-navy);
    font-weight: 600;
  }

  .cm-combina__card-atc {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cm-navy);
    border: none;
    cursor: pointer;
    color: var(--cm-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s ease, transform 0.2s ease;
    font-size: 20px;
    line-height: 1;
    font-weight: 300;
  }

  .cm-combina__card-atc:hover {
    background: var(--cm-gold);
    transform: scale(1.1);
  }

  .cm-combina__card-atc:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .cm-combina__card-atc[data-added="true"] {
    background: #2e7d32;
  }

  /* Flechas */
  .cm-combina__arrow {
    position: absolute;
    top: 38%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: var(--cm-white);
    border: 1px solid var(--cm-border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cm-navy);
    z-index: 2;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(10,30,60,0.1);
    transition: background 0.2s, border-color 0.2s;
  }

  .cm-combina__arrow:hover {
    background: var(--cm-navy);
    color: var(--cm-white);
    border-color: var(--cm-navy);
  }

  .cm-combina__arrow:focus-visible {
    outline: 2px solid var(--pdp-accent, var(--cm-gold));
    outline-offset: 2px;
  }

  .cm-combina__arrow--prev { left: -4px; }
  .cm-combina__arrow--next { right: -4px; }

  .cm-combina__arrow[disabled] { opacity: 0.3; cursor: default; pointer-events: none; }

  /* Responsive */
  @media (max-width: 900px) {
    .cm-combina { padding: 40px 24px 48px; }
    .cm-combina__slider { padding: 0 20px; }
    .cm-combina__card { flex: 0 0 calc(33.333% - 11px); }
  }

  @media (max-width: 600px) {
    .cm-combina__card { flex: 0 0 calc(50% - 8px); min-width: 140px; }
  }
</style>

<div id="cm-combina-section" aria-label="{{ sec_title }}">
  <div class="cm-combina">
    <div class="cm-combina__inner">
      <p class="cm-combina__eyebrow">{{ sec_title }}</p>

      {%- if combina_col != blank and combina_col.products.size > 0 -%}
        <div class="cm-combina__slider">
          <button class="cm-combina__arrow cm-combina__arrow--prev" id="cm-combina-prev" aria-label="Productos anteriores" disabled>
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <div class="cm-combina__track-wrap">
            <div class="cm-combina__track" id="cm-combina-track">
              {%- for prod in combina_col.products limit: show_count -%}
                {%- assign prod_collection = prod.collections | first -%}
                {%- assign variant = prod.first_available_variant | default: prod.variants.first -%}
                <div class="cm-combina__card">
                  <div class="cm-combina__card-inner">

                    <a href="{{ prod.url }}" class="cm-combina__card-img-link">
                      <div class="cm-combina__card-img-wrap">
                        {%- if prod.featured_image -%}
                          <img
                            class="cm-combina__card-img"
                            src="{{ prod.featured_image | image_url: width: 500 }}"
                            alt="{{ prod.featured_image.alt | escape | default: prod.title }}"
                            width="500"
                            height="500"
                            loading="lazy"
                          >
                        {%- endif -%}
                      </div>
                    </a>

                    <div class="cm-combina__card-info">
                      {%- if prod_collection != blank -%}
                        <span class="cm-combina__card-category">{{ prod_collection.title }}</span>
                      {%- endif -%}
                      <a href="{{ prod.url }}" class="cm-combina__card-name-link">
                        <p class="cm-combina__card-name">{{ prod.title }}</p>
                      </a>
                    </div>

                    <div class="cm-combina__card-foot">
                      <p class="cm-combina__card-price">{{ prod.price | money }}</p>
                      {%- if variant -%}
                        <button
                          class="cm-combina__card-atc"
                          data-variant-id="{{ variant.id }}"
                          aria-label="Añadir {{ prod.title }} a la cesta"
                          title="Añadir a la cesta"
                        >+</button>
                      {%- endif -%}
                    </div>

                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <button class="cm-combina__arrow cm-combina__arrow--next" id="cm-combina-next" aria-label="Productos siguientes">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      {%- else -%}
        <p style="font-size:14px;color:var(--cm-text-light);font-family:var(--cm-font-sans);">
          Selecciona una colección en el editor para mostrar los productos.
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  /* ── Carrusel ── */
  const track   = document.getElementById('cm-combina-track');
  const btnPrev = document.getElementById('cm-combina-prev');
  const btnNext = document.getElementById('cm-combina-next');
  if (!track || !btnPrev || !btnNext) return;

  let current = 0;
  const cards = track.querySelectorAll('.cm-combina__card');
  const total = cards.length;

  function visibleCount() {
    const w = track.parentElement.offsetWidth;
    if (w < 600) return 2;
    if (w < 900) return 3;
    return 5;
  }

  function go(idx) {
    const vis = visibleCount();
    const max = Math.max(0, total - vis);
    current = Math.min(Math.max(0, idx), max);
    const cardW = cards[0] ? cards[0].offsetWidth + 16 : 0;
    track.style.transform = 'translateX(-' + (current * cardW) + 'px)';
    btnPrev.disabled = (current === 0);
    btnNext.disabled = (current >= max);
  }

  btnPrev.addEventListener('click', () => go(current - 1));
  btnNext.addEventListener('click', () => go(current + 1));
  window.addEventListener('resize', () => go(current));
  go(0);

  /* ── Botones ATC ── */
  track.addEventListener('click', function(e) {
    const btn = e.target.closest('.cm-combina__card-atc');
    if (!btn) return;
    e.preventDefault();

    const variantId = btn.dataset.variantId;
    if (!variantId) return;

    btn.disabled = true;
    btn.textContent = '…';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(r => r.json())
    .then(() => {
      btn.textContent = '✓';
      btn.dataset.added = 'true';
      /* Refresca el contador del icono de carrito si existe */
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      setTimeout(() => {
        btn.textContent = '+';
        btn.disabled = false;
        delete btn.dataset.added;
      }, 2000);
    })
    .catch(() => {
      btn.textContent = '+';
      btn.disabled = false;
    });
  });
})();
</script>

{% schema %}
{
  "name": "Combina tu compra",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Combina tu compra con"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección de productos"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5,
      "label": "Máximo de productos a mostrar"
    }
  ],
  "presets": [
    {
      "name": "Combina tu compra"
    }
  ]
}
{% endschema %}
