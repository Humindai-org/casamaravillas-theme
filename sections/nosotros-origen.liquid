<style>
  .nso {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 50vh;
    background: var(--cm-off);
    border-bottom: 1px solid var(--cm-border);
  }

  .nso__image-col {
    position: relative;
    overflow: hidden;
    min-height: 380px;
  }

  .nso__image-col img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_pos_x | default: 50 }}% {{ section.settings.image_pos_y | default: 50 }}%;
  }

  .nso__image-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, var(--cm-navy) 0%, #001a30 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }


  .nso__content {
    padding: clamp(64px, 8vw, 112px) clamp(48px, 7vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .nso__inner { position: relative; z-index: 1; }

  .nso__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin-bottom: 20px;
  }

  .nso__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(28px, 3.5vw, 48px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.2;
    margin-bottom: 28px;
  }

  .nso__body {
    font-family: var(--cm-font-sans);
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--cm-text-mid);
    margin-bottom: 48px;
    max-width: 480px;
  }

  .nso__body p { margin-bottom: 16px; }
  .nso__body p:last-child { margin-bottom: 0; }

  .nso__quote {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    max-width: 480px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--cm-border);
  }

  .nso__quote-rule {
    flex-shrink: 0;
    width: 28px;
    height: 1px;
    margin-top: 14px;
    background: var(--cm-gold);
  }

  .nso__quote-text {
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-size: clamp(19px, 1.9vw, 24px);
    line-height: 1.4;
    color: var(--cm-navy);
  }

  .nso .cm-reveal {
    opacity: 0;
    transform: translateY(32px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .nso .cm-reveal.is-visible { opacity: 1; transform: none; }
  .nso .cm-reveal--d1 { transition-delay: 0.15s; }
  .nso .cm-reveal--d2 { transition-delay: 0.3s; }
  .nso .cm-reveal--d3 { transition-delay: 0.45s; }

  @media (prefers-reduced-motion: reduce) {
    .nso .cm-reveal { opacity: 1; transform: none; transition: none; }
  }

  @media (max-width: 1023px) {
    .nso { grid-template-columns: 1fr; }
    .nso__image-col { min-height: 0; height: 340px; }
    .nso__content { padding: 56px 40px; }
  }

  @media (max-width: 767px) {
    .nso__image-col { height: 260px; }
    .nso__content { padding: 48px 24px; }
  }
</style>

<section class="nso" id="nso-{{ section.id }}">

  <div class="nso__image-col">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
        | image_url: width: 1200, format: 'webp'
        | image_tag:
            loading: 'lazy',
            alt: section.settings.image.alt | escape
      }}
    {%- else -%}
      <div class="nso__image-placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="nso__content">
    <div class="nso__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nso__eyebrow cm-reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="nso__title cm-reveal cm-reveal--d1">{{ section.settings.title | default: 'Todo empezó con una convicción' }}</h2>

      {%- if section.settings.body != blank -%}
        <div class="nso__body cm-reveal cm-reveal--d2">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.quote != blank -%}
        <div class="nso__quote cm-reveal cm-reveal--d3">
          <span class="nso__quote-rule" aria-hidden="true"></span>
          <p class="nso__quote-text">{{ section.settings.quote }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>

</section>

<script>
(function() {
  var sec = document.getElementById('nso-{{ section.id }}');
  if (!sec) return;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('is-visible'); });
  }, { threshold: 0.15 });
  sec.querySelectorAll('.cm-reveal').forEach(function(el) { obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Nosotros — Origen",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "range",
      "id": "image_pos_x",
      "label": "Posición horizontal imagen",
      "info": "0% = izquierda · 50% = centro · 100% = derecha",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y",
      "label": "Posición vertical imagen",
      "info": "0% = arriba · 50% = centro · 100% = abajo",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Nuestra historia"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Todo empezó con una convicción"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Somos una familia que lleva tres generaciones viviendo los ibéricos desde dentro. No desde la teoría, sino desde el campo, desde las bodegas, desde el conocimiento acumulado de quien ha pasado décadas aprendiendo a distinguir lo bueno de lo excepcional.</p><p>Cuando decidimos llevar ese conocimiento a una tienda online, nos hicimos una sola pregunta: ¿venderíamos esto a un amigo? Si la respuesta es sí, entra al catálogo. Si hay alguna duda, no entra. Así de simple. Así de exigente.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Cita destacada",
      "info": "Frase corta que cierra la sección.",
      "default": "Vamos al origen porque ahí está la verdad del producto."
    }
  ],
  "presets": [
    {
      "name": "Nosotros — Origen"
    }
  ]
}
{% endschema %}
