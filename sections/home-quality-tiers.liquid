<style>
  .hqt-{{ section.id }} {
    padding: 72px 0;
    background: var(--cm-white);
  }

  .hqt__header-{{ section.id }} {
    text-align: center;
    margin-bottom: 56px;
    padding: 0 24px;
  }

  .hqt__eyebrow-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 16px;
    display: block;
  }

  .hqt__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.2;
    margin: 0;
  }

  /* Grid Container */
  .hqt__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Hover Image Item */
  .hqt__item-{{ section.id }} {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    cursor: pointer;
    border-radius: 8px;
  }

  .hqt__image-container-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hqt__image-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.4s ease;
  }

  .hqt__image-front-{{ section.id }} {
    opacity: 1;
    z-index: 2;
  }

  .hqt__image-back-{{ section.id }} {
    opacity: 0;
    z-index: 1;
  }

  .hqt__item-{{ section.id }}:hover .hqt__image-front-{{ section.id }} {
    opacity: 0;
  }

  .hqt__item-{{ section.id }}:hover .hqt__image-back-{{ section.id }} {
    opacity: 1;
  }

  /* Tablet - 2 columns */
  @media (max-width: 1023px) {
    .hqt-{{ section.id }} {
      padding: 56px 0;
    }

    .hqt__header-{{ section.id }} {
      margin-bottom: 40px;
    }

    .hqt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      padding: 0 16px;
    }
  }

  /* Mobile - 1 column */
  @media (max-width: 767px) {
    .hqt-{{ section.id }} {
      padding: 40px 0;
    }

    .hqt__header-{{ section.id }} {
      margin-bottom: 32px;
      padding: 0 16px;
    }

    .hqt__heading-{{ section.id }} {
      font-size: 22px;
    }

    .hqt__grid-{{ section.id }} {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 0 16px;
    }
  }
</style>

<section class="hqt-{{ section.id }}" id="hqt-{{ section.id }}">
  <div class="hqt__header-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hqt__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hqt__heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="hqt__grid-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- assign front_url = block.settings.front_image | image_url: width: 600, format: 'webp' -%}
      {%- assign back_url = block.settings.back_image | image_url: width: 600, format: 'webp' -%}

      <div
        class="hqt__item-{{ section.id }}"
        {{ block.shopify_attributes }}
      >
        <div class="hqt__image-container-{{ section.id }}">
          {%- if front_url != blank -%}
            <img
              src="{{ front_url }}"
              alt="{{ block.settings.alt_text }}"
              class="hqt__image-{{ section.id }} hqt__image-front-{{ section.id }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {%- endif -%}

          {%- if back_url != blank -%}
            <img
              src="{{ back_url }}"
              alt="{{ block.settings.alt_text }}"
              class="hqt__image-{{ section.id }} hqt__image-back-{{ section.id }}"
              loading="lazy"
              width="600"
              height="600"
            >
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Categorías de Jamones",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Imagen con Hover",
      "settings": [
        {
          "type": "image_picker",
          "id": "front_image",
          "label": "Imagen frontal (default)"
        },
        {
          "type": "image_picker",
          "id": "back_image",
          "label": "Imagen de hover"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo (alt)"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "NUESTRAS CATEGORÍAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Encuentra el jamón que buscas"
    }
  ],
  "presets": [
    {
      "name": "Categorías de Jamones",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
