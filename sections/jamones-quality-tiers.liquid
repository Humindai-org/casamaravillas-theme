{% comment %}
  jamones-quality-tiers.liquid
  Sistema de categorías con 3 medallones: Bellota 100%, Bellota 75%, Cebo de Campo
  Iconos editables desde Shopify Admin
{% endcomment %}

<style>
  .qt-{{ section.id }} {
    background: var(--cm-off);
    padding: 56px 72px 64px;
  }

  /* ── Header ── */
  .qt__header-{{ section.id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .qt__eyebrow-{{ section.id }} {
    display: block;
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 16px;
  }

  .qt__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.2;
  }

  /* ── Grid de 3 columnas ── */
  .qt__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Medallón ── */
  .qt__medallion-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .qt__medallion-{{ section.id }}:hover {
    transform: translateY(-8px);
  }

  .qt__medallion-{{ section.id }}:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 8px;
  }

  .qt__medallion-{{ section.id }}.is-active {
    opacity: 1;
  }

  /* ── Icono medallón ── */
  .qt__icon-{{ section.id }} {
    position: relative;
    width: 220px;
    height: 220px;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qt__icon-img-{{ section.id }} {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Halo: la silueta del propio escudo, teñida del color de su categoría y
     desenfocada. Va detrás de la imagen, así que solo se ve lo que desborda.
     Dos capas (cerca + amplia) para que la luz tenga caída, no un borde plano.
     Solo se anima la opacidad; el blur se calcula una vez.
     Sin soporte de máscara el halo no llega a existir: sin el recorte pintaría
     un cuadrado de color, así que es mejor quedarse solo con el desplazamiento. */
  @supports ((-webkit-mask-image: url('#m')) or (mask-image: url('#m'))) {
    .qt__icon-{{ section.id }}::before,
    .qt__icon-{{ section.id }}::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--qt-glow);
      -webkit-mask: var(--qt-mask) center / contain no-repeat;
      mask: var(--qt-mask) center / contain no-repeat;
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }

    .qt__icon-{{ section.id }}::before {
      filter: blur(10px);
    }

    .qt__icon-{{ section.id }}::after {
      filter: blur(32px);
    }

    /* ── Halo encendido: hover, foco de teclado y categoría seleccionada ── */
    .qt__medallion-{{ section.id }}:hover .qt__icon-{{ section.id }}::before,
    .qt__medallion-{{ section.id }}:focus-visible .qt__icon-{{ section.id }}::before {
      opacity: 0.45;
    }

    .qt__medallion-{{ section.id }}:hover .qt__icon-{{ section.id }}::after,
    .qt__medallion-{{ section.id }}:focus-visible .qt__icon-{{ section.id }}::after {
      opacity: 0.55;
    }

    .qt__medallion-{{ section.id }}.is-active .qt__icon-{{ section.id }}::before {
      opacity: 0.58;
    }

    .qt__medallion-{{ section.id }}.is-active .qt__icon-{{ section.id }}::after {
      opacity: 0.72;
    }
  }

  /* ── Contenedor de textos bajo el icono ── */
  .qt__content-{{ section.id }} {
    flex: 1;
  }

  .qt__category-label-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 8px;
  }

  .qt__category-name-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .qt__category-desc-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 13px;
    color: var(--cm-text);
    line-height: 1.5;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .qt-{{ section.id }} {
      padding: 40px 40px 48px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 36px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .qt__icon-{{ section.id }} {
      width: 180px;
      height: 180px;
    }
    .qt__icon-{{ section.id }}::before {
      filter: blur(8px);
    }
    .qt__icon-{{ section.id }}::after {
      filter: blur(26px);
    }
    .qt__category-name-{{ section.id }} {
      font-size: 18px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .qt-{{ section.id }} {
      padding: 20px 16px 28px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 20px;
    }
    .qt__heading-{{ section.id }} {
      font-size: 22px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .qt__medallion-{{ section.id }} {
      margin: 0 auto;
    }
    .qt__icon-{{ section.id }} {
      width: 140px;
      height: 140px;
      margin-bottom: 16px;
    }
    .qt__icon-{{ section.id }}::before {
      filter: blur(6px);
    }
    .qt__icon-{{ section.id }}::after {
      filter: blur(20px);
    }
    .qt__category-name-{{ section.id }} {
      font-size: 14px;
      margin-bottom: 4px;
    }
    .qt__category-desc-{{ section.id }} {
      font-size: 11px;
      line-height: 1.4;
    }
  }

  /* ── Movimiento reducido: el halo se mantiene, la animación no ── */
  @media (prefers-reduced-motion: reduce) {
    .qt__medallion-{{ section.id }},
    .qt__icon-{{ section.id }}::before,
    .qt__icon-{{ section.id }}::after {
      transition: none;
    }
    .qt__medallion-{{ section.id }}:hover {
      transform: none;
    }
  }
</style>

<section class="qt-{{ section.id }}" id="qt-section-{{ section.id }}">
  <div class="qt__header-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="qt__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="qt__heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="qt__grid-{{ section.id }}">
    {%- for i in (0..2) -%}
      {%- assign settings_icon = 'cat' | append: i | append: '_icon' -%}
      {%- assign settings_name = 'cat' | append: i | append: '_name' -%}
      {%- assign settings_desc = 'cat' | append: i | append: '_desc' -%}
      {%- assign settings_glow = 'cat' | append: i | append: '_glow' -%}
      {%- assign icon_url = section.settings[settings_icon] | image_url -%}
      {%- assign glow_color = section.settings[settings_glow] | default: '#C4973A' -%}

      {%- assign filter_tags = 'precinto negro,precinto rojo,precinto verde' | split: ',' -%}
      {%- assign filter_tag = filter_tags[forloop.index0] -%}
      {%- assign is_active = false -%}
      {%- for t in current_tags -%}
        {%- if t == filter_tag -%}{%- assign is_active = true -%}{%- endif -%}
      {%- endfor -%}

      <button
        type="button"
        class="qt__medallion-{{ section.id }}{% if is_active %} is-active{% endif %}"
        data-filter-tag-btn="{{ filter_tag }}"
        aria-label="Ver detalles de {{ section.settings[settings_name] }}{% if is_active %} — clic para quitar filtro{% endif %}"
      >
        {%- if section.settings[settings_icon] != blank -%}
          <div
            class="qt__icon-{{ section.id }}"
            style="--qt-mask: url('{{ icon_url | escape }}'); --qt-glow: {{ glow_color | escape }};"
          >
            <img
              src="{{ icon_url }}"
              alt="{{ section.settings[settings_name] }}"
              class="qt__icon-img-{{ section.id }}"
              loading="lazy"
              width="220"
              height="220"
            />
          </div>
        {%- endif -%}

        <div class="qt__content-{{ section.id }}">
          <h3 class="qt__category-name-{{ section.id }}">{{ section.settings[settings_name] }}</h3>
          {%- if section.settings[settings_desc] != blank -%}
            <p class="qt__category-desc-{{ section.id }}">{{ section.settings[settings_desc] }}</p>
          {%- endif -%}
        </div>
      </button>
    {%- endfor -%}
  </div>
</section>

<script>
  (function() {
    var qtSection = document.getElementById('qt-section-{{ section.id }}');
    if (!qtSection) return;

    var qualityTags = ['precinto negro', 'precinto rojo', 'precinto verde'];

    qtSection.querySelectorAll('[data-filter-tag-btn]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var tag = btn.getAttribute('data-filter-tag-btn');
        var collectionSection = document.querySelector('[data-jamones-collection]');
        if (!collectionSection) return;

        var clickedCb = collectionSection.querySelector('input[data-filter-tag="' + tag + '"]');
        if (!clickedCb) return;

        var wasChecked = clickedCb.checked;

        // Exclusive selection: uncheck ALL other quality tags (sidebar + drawer)
        qualityTags.forEach(function(qtag) {
          if (qtag !== tag) {
            collectionSection.querySelectorAll('input[data-filter-tag="' + qtag + '"]').forEach(function(cb) {
              cb.checked = false;
            });
          }
        });

        // Toggle the clicked tag
        clickedCb.checked = !wasChecked;

        // Update visual state of all medallions
        qtSection.querySelectorAll('[data-filter-tag-btn]').forEach(function(b) {
          b.classList.toggle('is-active', b === btn && !wasChecked);
        });

        // Delegate filtering to jamones-collection's own change listener
        clickedCb.dispatchEvent(new Event('change'));
      });
    });
  })();
</script>

