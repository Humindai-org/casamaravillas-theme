{% comment %}
  jamones-quality-tiers.liquid
  Sistema de categorías con 4 medallones: Bellota, Peyote, Cebo de Campo, Cebo
  Iconos editables desde Shopify Admin
{% endcomment %}

<style>
  .qt-{{ section.id }} {
    background: var(--cm-off);
    padding: 56px 72px 64px;
  }

  /* ── Header ── */
  .qt__header-{{ section.id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .qt__eyebrow-{{ section.id }} {
    display: block;
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 16px;
  }

  .qt__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.2;
  }

  /* ── Grid de 4 columnas ── */
  .qt__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Medallón ── */
  .qt__medallion-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .qt__medallion-{{ section.id }}:hover {
    transform: translateY(-8px);
  }

  .qt__medallion-{{ section.id }}:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 8px;
  }

  /* ── Icono medallón ── */
  .qt__icon-{{ section.id }} {
    position: relative;
    width: 140px;
    height: 160px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .qt__icon-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ── Contenedor de textos bajo el icono ── */
  .qt__content-{{ section.id }} {
    flex: 1;
  }

  .qt__category-label-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 8px;
  }

  .qt__category-name-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .qt__category-desc-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 13px;
    color: var(--cm-text);
    line-height: 1.5;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .qt-{{ section.id }} {
      padding: 40px 40px 48px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 36px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .qt__icon-{{ section.id }} {
      width: 120px;
      height: 140px;
    }
    .qt__category-name-{{ section.id }} {
      font-size: 18px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .qt-{{ section.id }} {
      padding: 32px 24px 40px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 28px;
    }
    .qt__heading-{{ section.id }} {
      font-size: 24px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .qt__medallion-{{ section.id }} {
      margin: 0 auto;
    }
    .qt__icon-{{ section.id }} {
      width: 100px;
      height: 120px;
    }
    .qt__category-name-{{ section.id }} {
      font-size: 16px;
    }
    .qt__category-desc-{{ section.id }} {
      font-size: 12px;
    }
  }
</style>

<section class="qt-{{ section.id }}" id="qt-section-{{ section.id }}">
  <div class="qt__header-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="qt__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="qt__heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="qt__grid-{{ section.id }}">
    {%- for i in (0..3) -%}
      {%- assign settings_icon = 'cat' | append: i | append: '_icon' -%}
      {%- assign settings_name = 'cat' | append: i | append: '_name' -%}
      {%- assign settings_desc = 'cat' | append: i | append: '_desc' -%}
      {%- assign icon_url = section.settings[settings_icon] | image_url -%}

      <a
        class="qt__medallion-{{ section.id }}"
        href="#cat-{{ i }}"
        aria-label="Ver detalles de {{ section.settings[settings_name] }}"
      >
        {%- if section.settings[settings_icon] != blank -%}
          <div class="qt__icon-{{ section.id }}">
            <img
              src="{{ icon_url }}"
              alt="{{ section.settings[settings_name] }}"
              class="qt__icon-img-{{ section.id }}"
              loading="lazy"
              width="140"
              height="160"
            />
          </div>
        {%- endif -%}

        <div class="qt__content-{{ section.id }}">
          <div class="qt__category-label-{{ section.id }}">Categoría</div>
          <h3 class="qt__category-name-{{ section.id }}">{{ section.settings[settings_name] }}</h3>
          {%- if section.settings[settings_desc] != blank -%}
            <p class="qt__category-desc-{{ section.id }}">{{ section.settings[settings_desc] }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Jamones - Calidad",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Sistema de Categorías"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Cuatro piezas, tres niveles"
    },
    {
      "type": "header",
      "content": "🥇 Categoría I — Bellota 100%"
    },
    {
      "type": "image_picker",
      "id": "cat0_icon",
      "label": "Icono"
    },
    {
      "type": "text",
      "id": "cat0_name",
      "label": "Nombre",
      "default": "Bellota 100% Ibérico"
    },
    {
      "type": "textarea",
      "id": "cat0_desc",
      "label": "Descripción (opcional)"
    },
    {
      "type": "header",
      "content": "Categoría II — Bellota 75%"
    },
    {
      "type": "image_picker",
      "id": "cat1_icon",
      "label": "Icono"
    },
    {
      "type": "text",
      "id": "cat1_name",
      "label": "Nombre",
      "default": "Bellota 75% Ibérico"
    },
    {
      "type": "textarea",
      "id": "cat1_desc",
      "label": "Descripción (opcional)"
    },
    {
      "type": "header",
      "content": "🥈 Categoría III — Cebo de Campo"
    },
    {
      "type": "image_picker",
      "id": "cat2_icon",
      "label": "Icono"
    },
    {
      "type": "text",
      "id": "cat2_name",
      "label": "Nombre",
      "default": "Cebo de Campo Ibérico"
    },
    {
      "type": "textarea",
      "id": "cat2_desc",
      "label": "Descripción (opcional)"
    },
    {
      "type": "header",
      "content": "🥉 Categoría IV — Cebo"
    },
    {
      "type": "image_picker",
      "id": "cat3_icon",
      "label": "Icono"
    },
    {
      "type": "text",
      "id": "cat3_name",
      "label": "Nombre",
      "default": "Cebo Ibérico"
    },
    {
      "type": "textarea",
      "id": "cat3_desc",
      "label": "Descripción (opcional)"
    }
  ],
  "presets": [
    {
      "name": "Jamones — Sistema de Categorías"
    }
  ]
}
{% endschema %}
