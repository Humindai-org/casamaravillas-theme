{% comment %}
  jamones-quality-tiers.liquid
  Sistema de categorías con 4 medallones: Bellota, Peyote, Cebo de Campo, Cebo
  Iconos editables desde Shopify Admin
{% endcomment %}

<style>
  .qt-{{ section.id }} {
    background: var(--cm-off);
    padding: 56px 72px 64px;
  }

  /* ── Header ── */
  .qt__header-{{ section.id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .qt__eyebrow-{{ section.id }} {
    display: block;
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 16px;
  }

  .qt__heading-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: clamp(24px, 2.8vw, 36px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.2;
  }

  /* ── Grid de 4 columnas ── */
  .qt__grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Medallón ── */
  .qt__medallion-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .qt__medallion-{{ section.id }}:hover {
    transform: translateY(-8px);
  }

  .qt__medallion-{{ section.id }}:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 8px;
  }

  .qt__medallion-{{ section.id }}.is-active {
    opacity: 1;
  }

  .qt__medallion-{{ section.id }}.is-active .qt__icon-img-{{ section.id }} {
    filter: brightness(0.9);
  }

  /* ── Icono medallón ── */
  .qt__icon-{{ section.id }} {
    position: relative;
    width: 160px;
    height: 180px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .qt__icon-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* ── Contenedor de textos bajo el icono ── */
  .qt__content-{{ section.id }} {
    flex: 1;
  }

  .qt__category-label-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    margin-bottom: 8px;
  }

  .qt__category-name-{{ section.id }} {
    font-family: var(--cm-font-serif);
    font-size: 20px;
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .qt__category-desc-{{ section.id }} {
    font-family: var(--cm-font-sans);
    font-size: 13px;
    color: var(--cm-text);
    line-height: 1.5;
  }

  /* ── Tablet ── */
  @media (max-width: 1023px) {
    .qt-{{ section.id }} {
      padding: 40px 40px 48px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 36px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .qt__icon-{{ section.id }} {
      width: 140px;
      height: 160px;
    }
    .qt__category-name-{{ section.id }} {
      font-size: 18px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 767px) {
    .qt-{{ section.id }} {
      padding: 20px 16px 28px;
    }
    .qt__header-{{ section.id }} {
      margin-bottom: 20px;
    }
    .qt__heading-{{ section.id }} {
      font-size: 22px;
    }
    .qt__grid-{{ section.id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .qt__medallion-{{ section.id }} {
      margin: 0 auto;
    }
    .qt__icon-{{ section.id }} {
      width: 100px;
      height: 110px;
      margin-bottom: 12px;
    }
    .qt__category-name-{{ section.id }} {
      font-size: 14px;
      margin-bottom: 4px;
    }
    .qt__category-desc-{{ section.id }} {
      font-size: 11px;
      line-height: 1.4;
    }
  }
</style>

<section class="qt-{{ section.id }}" id="qt-section-{{ section.id }}">
  <div class="qt__header-{{ section.id }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="qt__eyebrow-{{ section.id }}">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="qt__heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div class="qt__grid-{{ section.id }}">
    {%- for i in (0..3) -%}
      {%- assign settings_icon = 'cat' | append: i | append: '_icon' -%}
      {%- assign settings_name = 'cat' | append: i | append: '_name' -%}
      {%- assign settings_desc = 'cat' | append: i | append: '_desc' -%}
      {%- assign icon_url = section.settings[settings_icon] | image_url -%}

      {%- assign filter_tags = 'precinto negro,precinto rojo,precinto verde,precinto blanco' | split: ',' -%}
      {%- assign filter_tag = filter_tags[forloop.index0] -%}
      {%- assign is_active = false -%}
      {%- for t in current_tags -%}
        {%- if t == filter_tag -%}{%- assign is_active = true -%}{%- endif -%}
      {%- endfor -%}

      <button
        type="button"
        class="qt__medallion-{{ section.id }}{% if is_active %} is-active{% endif %}"
        data-filter-tag-btn="{{ filter_tag }}"
        aria-label="Ver detalles de {{ section.settings[settings_name] }}{% if is_active %} — clic para quitar filtro{% endif %}"
      >
        {%- if section.settings[settings_icon] != blank -%}
          <div class="qt__icon-{{ section.id }}">
            <img
              src="{{ icon_url }}"
              alt="{{ section.settings[settings_name] }}"
              class="qt__icon-img-{{ section.id }}"
              loading="lazy"
              width="160"
              height="180"
            />
          </div>
        {%- endif -%}

        <div class="qt__content-{{ section.id }}">
          <h3 class="qt__category-name-{{ section.id }}">{{ section.settings[settings_name] }}</h3>
          {%- if section.settings[settings_desc] != blank -%}
            <p class="qt__category-desc-{{ section.id }}">{{ section.settings[settings_desc] }}</p>
          {%- endif -%}
        </div>
      </button>
    {%- endfor -%}
  </div>
</section>

<script>
  (function() {
    var qtSection = document.getElementById('qt-section-{{ section.id }}');
    if (!qtSection) return;

    function filterProductsByTag(tag) {
      var collectionSection = document.querySelector('[data-jamones-collection]');
      if (!collectionSection) {
        console.warn('No se encontró jamones-collection');
        return;
      }

      // Find and toggle the checkbox
      var checkbox = collectionSection.querySelector('input[data-filter-tag="' + tag + '"]');
      if (!checkbox) {
        console.warn('No se encontró checkbox para tag: ' + tag);
        return;
      }

      // Toggle checkbox
      checkbox.checked = !checkbox.checked;

      // Find all products and apply filtering
      var selectedTags = [];
      collectionSection.querySelectorAll('input[data-filter-tag]:checked').forEach(function(cb) {
        var t = cb.getAttribute('data-filter-tag');
        if (selectedTags.indexOf(t) === -1) selectedTags.push(t);
      });

      // Filter products
      var products = collectionSection.querySelectorAll('[data-product-tags]');
      var visibleCount = 0;

      products.forEach(function(product) {
        var productTags = product.getAttribute('data-product-tags').split(',').map(function(t) { return t.trim(); });
        var matches = true;

        if (selectedTags.length > 0) {
          matches = selectedTags.every(function(tag) {
            return productTags.indexOf(tag) !== -1;
          });
        }

        if (matches) {
          product.style.display = '';
          visibleCount++;
        } else {
          product.style.display = 'none';
        }
      });

      // Update product count
      var countEl = collectionSection.querySelector('.jc__count-' + collectionSection.id.replace('jc-section-', ''));
      if (countEl) {
        countEl.textContent = visibleCount + (visibleCount === 1 ? ' producto' : ' productos');
      }

      // Update URL hash
      var url = new URL(window.location.href);
      if (selectedTags.length > 0) {
        url.hash = selectedTags.join('+');
      } else {
        url.hash = '';
      }
      window.history.replaceState({}, '', url.toString());
    }

    qtSection.querySelectorAll('[data-filter-tag-btn]').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        var tag = btn.getAttribute('data-filter-tag-btn');
        filterProductsByTag(tag);
      });
    });
  })();
</script>

