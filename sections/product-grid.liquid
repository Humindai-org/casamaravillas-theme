<style>
  .product-grid-section {
    padding: 96px 72px;
    background: var(--cm-off);
  }

  .product-grid-section.bg-gold-pale {
    background: #F5EFE0;
  }

  .product-grid-section.bg-navy {
    background: var(--cm-navy);
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-grid-section__eyebrow {
    color: var(--cm-gold);
  }

  .product-grid-section.bg-navy .product-grid-section__title {
    color: var(--cm-white);
  }

  /* On navy background, product card text stays white (not navy/gold) */
  .product-grid-section.bg-navy .product-card__name,
  .product-grid-section.bg-navy .product-card__name:hover {
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-card__price {
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-card__name-sub {
    color: rgba(255, 255, 255, 0.7);
  }

  .product-grid-section.bg-navy .product-card__foot {
    border-top-color: rgba(255, 255, 255, 0.2);
  }

  .product-grid-section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .product-grid-section__eyebrow {
    font-size: 9px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-weight: 500;
    margin-bottom: 18px;
    font-family: var(--cm-font-sans);
  }

  .product-grid-section__rule {
    width: 54px;
    height: 1px;
    background: var(--cm-gold);
    opacity: 0.6;
    margin-bottom: 26px;
  }

  .product-grid-section__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(30px, 3.4vw, 50px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.12;
  }

  .product-grid-section__title em { font-style: italic; }

  .product-grid-section__subtitle {
    font-family: var(--cm-font-serif);
    font-size: clamp(16px, 1.5vw, 20px);
    color: var(--cm-text-light);
    line-height: 1.5;
    margin-top: 20px;
  }

  .product-grid-section__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols, 4), 1fr);
    gap: 28px;
  }

  /* Floating-card look scoped to this section (keeps collection grids untouched) */
  .product-grid-section .product-card {
    background: transparent;
  }

  .product-grid-section .product-card:hover {
    box-shadow: none;
  }

  .product-grid-section .product-card__img-box {
    background: linear-gradient(165deg, #f1f0ed 0%, #e6e4df 100%);
  }

  .product-grid-section__footer {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  /* Flechas de navegación del carrusel: solo existen en móvil */
  .product-grid-section__nav {
    display: none;
  }

  .product-grid-section__view-all {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--cm-navy);
    text-decoration: none;
    padding: 20px 56px;
    border: 1px solid var(--cm-gold);
    background: transparent;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .product-grid-section__view-all::after { content: '→'; font-size: 14px; }
  .product-grid-section__view-all:hover { background: var(--cm-navy); color: var(--cm-white); border-color: var(--cm-navy); }
  .product-grid-section__view-all:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 3px;
  }

  .product-grid-section.bg-navy .product-grid-section__view-all {
    color: var(--cm-white);
  }
  .product-grid-section.bg-navy .product-grid-section__view-all:hover {
    background: var(--cm-white);
    color: var(--cm-navy);
    border-color: var(--cm-white);
  }

  @media (max-width: 1023px) {
    .product-grid-section { padding: 64px 32px; }
    .product-grid-section__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }

  @media (max-width: 767px) {
    .product-grid-section { padding: 48px 20px; }

    /* Carrusel horizontal: una tarjeta grande a la vez, con un asomo de la siguiente */
    .product-grid-section__grid {
      grid-template-columns: none;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      margin: 0 -20px;
      padding-bottom: 8px;
      scrollbar-width: none;
    }

    .product-grid-section__grid::-webkit-scrollbar { display: none; }

    .product-grid-section .product-card {
      flex: 0 0 80%;
      max-width: 80%;
      scroll-snap-align: start;
    }

    /* Margen visible antes de la primera tarjeta y después de la última */
    .product-grid-section .product-card:first-child { margin-left: 20px; }
    .product-grid-section .product-card:last-child { margin-right: 20px; }

    /* Flechas de navegación del carrusel (solo móvil) */
    .product-grid-section__nav {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
    }

    .product-grid-section__arrow {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--cm-gold);
      background: transparent;
      color: var(--cm-gold);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      cursor: pointer;
      transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease, opacity 0.25s ease;
    }

    .product-grid-section__arrow svg { width: 16px; height: 16px; display: block; }
    .product-grid-section__arrow:hover { background: var(--cm-gold); color: var(--cm-navy); }
    .product-grid-section__arrow:active { transform: scale(0.92); }
    .product-grid-section__arrow:focus-visible { outline: 2px solid var(--cm-gold); outline-offset: 2px; }
    .product-grid-section__arrow[disabled] { opacity: 0.35; cursor: default; }
    .product-grid-section__arrow[disabled]:hover { background: transparent; color: var(--cm-gold); }

    .product-grid-section__view-all { padding: 18px 40px; }
  }

  @media (max-width: 480px) {
    .product-grid-section .product-card { flex: 0 0 84%; max-width: 84%; }
  }
</style>

<section class="product-grid-section{% if section.settings.section_bg == 'gold_pale' %} bg-gold-pale{% elsif section.settings.section_bg == 'navy' %} bg-navy{% endif %}">

  {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.description != blank -%}
    <div class="product-grid-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="product-grid-section__eyebrow">{{ section.settings.eyebrow }}</p>
        <div class="product-grid-section__rule"></div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="product-grid-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="product-grid-section__subtitle">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign product_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product' and block.settings.product != blank -%}
      {%- assign product_count = product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign grid_cols = product_count | at_least: 1 | at_most: 4 -%}
  {%- if product_count == 0 -%}{%- assign grid_cols = 4 -%}{%- endif -%}
  <div class="product-grid-section__grid" style="--grid-cols: {{ grid_cols }};">
    {%- assign product_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        {%- assign product_handle = block.settings.product -%}
        {%- if product_handle != blank -%}
          {%- assign product = all_products[product_handle] -%}
          {% render 'product-card', card_product: product, tier_icons: section.settings.tier_icons, card_image: block.settings.image, card_hover_image: block.settings.hover_image, block_zoom: block.settings.image_zoom, block_offset: block.settings.image_offset %}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if product_count == 0 -%}
      {%- for i in (1..4) -%}
        {% render 'product-card', tier_icons: section.settings.tier_icons %}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="product-grid-section__nav">
    <button type="button" class="product-grid-section__arrow" data-carousel-prev aria-label="Producto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    <button type="button" class="product-grid-section__arrow" data-carousel-next aria-label="Producto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </button>
  </div>

  {%- if section.settings.view_all_label != blank -%}
    <div class="product-grid-section__footer">
      <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="product-grid-section__view-all">
        {{ section.settings.view_all_label }}
      </a>
    </div>
  {%- endif -%}

</section>

<script>
if (!window.cmGridCarouselInit) {
  window.cmGridCarouselInit = true;
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.product-grid-section__arrow');
    if (!btn) return;
    var wrap = btn.closest('.product-grid-section');
    var grid = wrap && wrap.querySelector('.product-grid-section__grid');
    var cards = grid && grid.querySelectorAll('.product-card');
    if (!grid || !cards || !cards.length) return;
    var current = grid.scrollLeft;
    var target = null;
    if (btn.hasAttribute('data-carousel-prev')) {
      for (var i = cards.length - 1; i >= 0; i--) {
        if (cards[i].offsetLeft < current - 4) { target = cards[i].offsetLeft; break; }
      }
      if (target === null) target = cards[0].offsetLeft;
    } else {
      for (var j = 0; j < cards.length; j++) {
        if (cards[j].offsetLeft > current + 4) { target = cards[j].offsetLeft; break; }
      }
      if (target === null) target = cards[cards.length - 1].offsetLeft;
    }
    grid.scrollTo({ left: target, behavior: 'smooth' });
  });

  var updateArrows = function(grid) {
    var wrap = grid.closest('.product-grid-section');
    var prevBtn = wrap.querySelector('[data-carousel-prev]');
    var nextBtn = wrap.querySelector('[data-carousel-next]');
    if (!prevBtn || !nextBtn) return;
    var maxScroll = grid.scrollWidth - grid.clientWidth;
    prevBtn.disabled = grid.scrollLeft <= 4;
    nextBtn.disabled = grid.scrollLeft >= maxScroll - 4;
  };

  document.querySelectorAll('.product-grid-section__grid').forEach(function(grid) {
    updateArrows(grid);
    grid.addEventListener('scroll', function() { updateArrows(grid); }, { passive: true });
  });
  window.addEventListener('resize', function() {
    document.querySelectorAll('.product-grid-section__grid').forEach(updateArrows);
  });
}
</script>

{% schema %}
{
  "name": "Grid de productos",
  "tag": "section",
  "blocks": [
    {
      "type": "product",
      "name": "Producto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Producto"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen principal (opcional)",
          "info": "Si la dejas vacía, se usa la imagen destacada del producto."
        },
        {
          "type": "image_picker",
          "id": "hover_image",
          "label": "Imagen hover (opcional)",
          "info": "Se muestra al pasar el mouse. Si la dejas vacía, no hay hover (salvo que el producto tenga una 2ª imagen o el metafield)."
        },
        {
          "type": "header",
          "content": "Ajuste de imagen"
        },
        {
          "type": "range",
          "id": "image_zoom",
          "label": "Zoom",
          "min": 50,
          "max": 200,
          "step": 5,
          "default": 100,
          "unit": "%"
        },
        {
          "type": "range",
          "id": "image_offset",
          "label": "Posición vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50,
          "unit": "%"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etiqueta superior",
      "default": "Tienda"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Nuestra <em>selección</em></p>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Subtítulo"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del enlace 'Ver todo'",
      "default": "Ver toda la colección"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Enlace 'Ver todo'"
    },
    {
      "type": "select",
      "id": "section_bg",
      "label": "Fondo de la sección",
      "options": [
        {
          "value": "off",
          "label": "Off-white (default)"
        },
        {
          "value": "gold_pale",
          "label": "Dorado pálido"
        },
        {
          "value": "navy",
          "label": "Navy (oscuro)"
        }
      ],
      "default": "off"
    },
    {
      "type": "header",
      "content": "Iconos de clasificación"
    },
    {
      "type": "image_picker",
      "id": "tier_icons_bellota_100",
      "label": "Icono - Bellota 100% (precinto negro)"
    },
    {
      "type": "image_picker",
      "id": "tier_icons_bellota_75",
      "label": "Icono - Bellota 50% (precinto rojo)"
    },
    {
      "type": "image_picker",
      "id": "tier_icons_cebo_campo",
      "label": "Icono - Cebo de Campo (precinto verde)"
    },
    {
      "type": "image_picker",
      "id": "tier_icons_cebo",
      "label": "Icono - Cebo (precinto blanco)"
    }
  ],
  "presets": [
    {
      "name": "Grid de productos",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
