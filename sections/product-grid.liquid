<style>
  .product-grid-section {
    padding: 96px 72px;
    background: var(--cm-off);
  }

  .product-grid-section.bg-gold-pale {
    background: #F5EFE0;
  }

  .product-grid-section.bg-navy {
    background: var(--cm-navy);
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-grid-section__eyebrow {
    color: var(--cm-gold);
  }

  .product-grid-section.bg-navy .product-grid-section__title {
    color: var(--cm-white);
  }

  /* On navy background, product card text stays white (not navy/gold) */
  .product-grid-section.bg-navy .product-card__name,
  .product-grid-section.bg-navy .product-card__name:hover {
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-card__price {
    color: var(--cm-white);
  }

  .product-grid-section.bg-navy .product-card__name-sub {
    color: rgba(255, 255, 255, 0.7);
  }

  .product-grid-section.bg-navy .product-card__foot {
    border-top-color: rgba(255, 255, 255, 0.2);
  }

  .product-grid-section__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }

  .product-grid-section__eyebrow {
    font-size: 9px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-weight: 500;
    margin-bottom: 18px;
    font-family: var(--cm-font-sans);
  }

  .product-grid-section__rule {
    width: 54px;
    height: 1px;
    background: var(--cm-gold);
    opacity: 0.6;
    margin-bottom: 26px;
  }

  .product-grid-section__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(30px, 3.4vw, 50px);
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.12;
  }

  .product-grid-section__title em { font-style: italic; }

  .product-grid-section__subtitle {
    font-family: var(--cm-font-serif);
    font-size: clamp(16px, 1.5vw, 20px);
    color: var(--cm-text-light);
    line-height: 1.5;
    margin-top: 20px;
  }

  .product-grid-section__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols, 4), 1fr);
    gap: 28px;
  }

  /* Floating-card look scoped to this section (keeps collection grids untouched) */
  .product-grid-section .product-card {
    background: transparent;
  }

  .product-grid-section .product-card:hover {
    box-shadow: none;
  }

  .product-grid-section .product-card__img-box {
    background: linear-gradient(165deg, #f1f0ed 0%, #e6e4df 100%);
  }

  .product-grid-section__footer {
    display: flex;
    justify-content: center;
    margin-top: 56px;
  }

  /* Flechas de navegación del carrusel: solo existen en móvil */
  .product-grid-section__nav {
    display: none;
  }

  .product-grid-section__view-all {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--cm-navy);
    text-decoration: none;
    padding: 20px 56px;
    border: 1px solid var(--cm-gold);
    background: transparent;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .product-grid-section__view-all::after { content: '→'; font-size: 14px; }
  .product-grid-section__view-all:hover { background: var(--cm-navy); color: var(--cm-white); border-color: var(--cm-navy); }
  .product-grid-section__view-all:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 3px;
  }

  .product-grid-section.bg-navy .product-grid-section__view-all {
    color: var(--cm-white);
  }
  .product-grid-section.bg-navy .product-grid-section__view-all:hover {
    background: var(--cm-white);
    color: var(--cm-navy);
    border-color: var(--cm-white);
  }

  @media (max-width: 1023px) {
    .product-grid-section { padding: 64px 32px; }
    .product-grid-section__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
  }

  @media (max-width: 767px) {
    .product-grid-section { padding: 48px 20px; }

    /* Carrusel horizontal: una tarjeta grande a la vez, con un asomo de la siguiente */
    .product-grid-section__grid {
      grid-template-columns: none;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      margin: 0 -20px;
      padding-bottom: 8px;
      scrollbar-width: none;
      /* Sin esto el snap alinea la tarjeta al borde y se come el margen izquierdo */
      scroll-padding-left: 20px;
      scroll-padding-right: 20px;
    }

    .product-grid-section__grid::-webkit-scrollbar { display: none; }

    .product-grid-section .product-card {
      flex: 0 0 80%;
      max-width: 80%;
      scroll-snap-align: start;
    }

    /* Margen visible antes de la primera tarjeta y después de la última.
       (No usar :first-child: el snippet product-card emite una etiqueta de estilos como primer hijo.) */
    .product-grid-section__grid { padding-left: 20px; padding-right: 20px; }

    /* Flechas de navegación del carrusel (solo móvil) */
    .product-grid-section__nav {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin-top: 20px;
    }

    .product-grid-section__arrow {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--cm-gold);
      background: transparent;
      color: var(--cm-gold);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      cursor: pointer;
      transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease, opacity 0.25s ease;
    }

    .product-grid-section__arrow svg { width: 16px; height: 16px; display: block; }
    .product-grid-section__arrow:hover { background: var(--cm-gold); color: var(--cm-navy); }
    .product-grid-section__arrow:active { transform: scale(0.92); }
    .product-grid-section__arrow:focus-visible { outline: 2px solid var(--cm-gold); outline-offset: 2px; }
    .product-grid-section__arrow[disabled] { opacity: 0.35; cursor: default; }
    .product-grid-section__arrow[disabled]:hover { background: transparent; color: var(--cm-gold); }

    .product-grid-section__view-all { padding: 18px 40px; }
  }

  @media (max-width: 480px) {
    .product-grid-section .product-card { flex: 0 0 84%; max-width: 84%; }
  }
  /* Móvil, opción «Filas compactas»: sin carrusel; todos los productos visibles a la vez (foto pequeña + nombre + precio). */
  @media (max-width: 767px) {
    .product-grid-section.is-compact-mobile { padding: 28px 16px 32px; }
    .product-grid-section.is-compact-mobile .product-grid-section__header { margin-bottom: 16px; }
    .product-grid-section.is-compact-mobile .product-grid-section__grid {
      display: grid; grid-template-columns: 1fr; overflow: visible; gap: 10px;
      margin: 0; padding: 0; scroll-snap-type: none;
    }
    .product-grid-section.is-compact-mobile .product-card {
      flex: none; max-width: none; flex-direction: row; align-items: stretch; border-radius: 10px;
    }
    .product-grid-section.is-compact-mobile .product-card > a { flex: 0 0 92px; width: 92px; display: block; }
    .product-grid-section.is-compact-mobile .product-card__img-box { width: 92px; height: 100%; min-height: 92px; aspect-ratio: auto; border-radius: 10px 0 0 10px; }
    .product-grid-section.is-compact-mobile .product-card { min-height: 92px; }
    .product-grid-section.is-compact-mobile .product-card__add-btn,
    .product-grid-section.is-compact-mobile .product-card__quality,
    .product-grid-section.is-compact-mobile .product-card__cat,
    .product-grid-section.is-compact-mobile .product-card__name-sub,
    .product-grid-section.is-compact-mobile .product-grid-section__nav { display: none; }
    .product-grid-section.is-compact-mobile .product-card__body { padding: 10px 12px; justify-content: center; gap: 6px; }
    .product-grid-section.is-compact-mobile .product-card__name { font-size: 14px; margin: 0; }
    .product-grid-section.is-compact-mobile .product-card__foot { padding-top: 6px; }
    .product-grid-section.is-compact-mobile .product-card__price { font-size: 16px; }
    .product-grid-section.is-compact-mobile .product-card__plus { width: 36px; height: 36px; }
    .product-grid-section.is-compact-mobile .product-grid-section__footer { margin-top: 16px; }
  }

  /* ===== Modo caja de regalo: carrusel de 3 en escena =====
     Las tarjetas comparten la misma celda; la activa va al centro, grande, y las otras dos a los lados, más pequeñas y
     atenuadas. Al rotar, cada una cambia de sitio con transform/opacity (nada de left/width). Ver el script del final. */
  .product-grid-section.is-gift { overflow-x: clip; }
  .product-grid-section.is-gift .pg-br { display: none; }
  @media (max-width: 767px) { .product-grid-section.is-gift .pg-br { display: block; } }
  .product-grid-section.is-gift .product-grid-section__grid {
    display: grid; grid-template-columns: minmax(0, clamp(250px, 30vw, 430px)); justify-content: center;
    gap: 0; margin: 0 auto; padding: 8px 0 0; overflow: visible; scroll-snap-type: none;
    touch-action: pan-y;
  }
  .product-grid-section.is-gift .product-card {
    grid-area: 1 / 1; flex: none; max-width: none; width: 100%; scroll-snap-align: none;
    --pos: 0; --s: 1;
    transform: translateX(calc(var(--pos) * 98%)) scale(var(--s));
    opacity: var(--o, 1);
    transition: transform 0.75s cubic-bezier(0.22, 0.7, 0.2, 1), opacity 0.6s ease;
    z-index: 1;
  }
  .product-grid-section.is-gift .product-card.is-active { --s: 1; --o: 1; z-index: 3; }
  .product-grid-section.is-gift .product-card.is-side { --s: 0.76; --o: 0.5; z-index: 2; cursor: pointer; }
  .product-grid-section.is-gift .product-card.is-far { --s: 0.6; --o: 0; pointer-events: none; }
  .product-grid-section.is-gift .product-card.is-jump { transition: none; }
  .product-grid-section.is-gift .product-card:hover { transform: translateX(calc(var(--pos) * 98%)) scale(var(--s)); }
  .product-grid-section.is-gift .product-card.is-side:hover { --o: 0.8; }
  /* Solo la tarjeta del centro abre la tapa */
  .product-grid-section.is-gift .product-card:not(.is-active):hover .product-card__img-box--gift.has-secondary .product-card__img--gift,
  .product-grid-section.is-gift .product-card:not(.is-active):focus-within .product-card__img-box--gift.has-secondary .product-card__img--gift { transform: none; opacity: 1; }
  .product-grid-section.is-gift .product-card:not(.is-active) .product-card__img-box--gift .product-card__img--secondary { transform: scale(1.06); }
  /* En pantallas táctiles no hay hover: la tapa se abre sola cuando la caja llega al centro */
  @media (hover: none) {
    .product-grid-section.is-gift .product-card.is-active.is-open .product-card__img-box--gift.has-secondary .product-card__img--gift { transform: translateY(-104%) rotate(-3deg); opacity: 0; }
    .product-grid-section.is-gift .product-card.is-active.is-open .product-card__img-box--gift .product-card__img--secondary { transform: scale(1); }
  }
  .product-grid-section.is-gift .pg-stage { position: relative; }
  /* Flechas en los laterales (escritorio); debajo solo en móvil */
  .product-grid-section.is-gift .product-grid-section__nav {
    display: flex; justify-content: space-between; align-items: center; margin: 0; padding: 0 clamp(12px, 3vw, 48px);
    pointer-events: none; position: absolute; top: 0; bottom: 0; left: -72px; right: -72px; z-index: 5;
  }
  @media (max-width: 1023px) { .product-grid-section.is-gift .product-grid-section__nav { left: -32px; right: -32px; } }
  .product-grid-section.is-gift .product-grid-section__arrow { pointer-events: auto; }
  .product-grid-section.is-gift .product-grid-section__arrow {
    width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--cm-gold); background: transparent; color: var(--cm-gold);
    display: inline-flex; align-items: center; justify-content: center; padding: 0; cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }
  .product-grid-section.is-gift .product-grid-section__arrow svg { width: 16px; height: 16px; display: block; }
  .product-grid-section.is-gift .product-grid-section__arrow:hover { background: var(--cm-gold); color: var(--cm-navy); }
  .product-grid-section.is-gift .product-grid-section__arrow:active { transform: scale(0.92); }
  .product-grid-section.is-gift .product-grid-section__arrow:focus-visible { outline: 2px solid var(--cm-gold); outline-offset: 3px; }
  @media (max-width: 767px) {
    .product-grid-section.is-gift { padding: 48px 0; }
    .product-grid-section.is-gift .product-grid-section__header { padding: 0 20px; }
    .product-grid-section.is-gift .product-grid-section__grid { grid-template-columns: minmax(0, 68vw); padding: 8px 0 0; margin: 0 auto; }
    .product-grid-section.is-gift .product-card { flex: none; max-width: none; }
    .product-grid-section.is-gift .product-grid-section__footer { padding: 0 20px; }
    .product-grid-section.is-gift .product-grid-section__nav { gap: 14px; justify-content: center; margin-top: 28px; padding: 0; position: static; left: auto; right: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-grid-section.is-gift .product-card { transition: opacity 0.3s ease; }
  }
</style>

{%- comment -%}
  Modo «caja de regalo» (adviento/Navidad/Black Friday): cada jamón es una caja cerrada con lazo; al pasar el ratón (o tocar en móvil)
  la tapa sube y deja ver la foto del jamón. Las 3 imágenes de las cajas son assets/gift-box-{oro,plata,bronce}.jpg (ver product-card).
{%- endcomment -%}
{%- assign gift_mode = section.settings.gift_mode -%}
{%- assign grid_eyebrow = section.settings.eyebrow -%}
{%- assign grid_cta_label = section.settings.view_all_label -%}
{%- assign grid_cta_url = section.settings.view_all_url | default: '/collections/all' -%}
{%- if gift_mode -%}
  {%- capture gf_bf_on -%}{% render 'cm-promos', key: 'bf_on' %}{%- endcapture -%}
  {%- if gf_bf_on != blank -%}
    {%- capture gf_bf_pct -%}{% render 'cm-promos', key: 'bf_pct' %}{%- endcapture -%}
    {%- assign grid_cta_label = 'Ver ofertas de Black Friday' -%}
    {%- capture grid_cta_url -%}{% render 'cm-promos', key: 'bf_url' %}{%- endcapture -%}
    {%- assign grid_cta_url = grid_cta_url | strip -%}
    {%- assign grid_eyebrow = 'Black Friday · −' | append: gf_bf_pct | strip | append: ' % <span class="pg-br"></span>hasta el lunes 30' -%}
  {%- endif -%}
{%- endif -%}
<section class="product-grid-section{% if gift_mode %} is-gift{% endif %}{% if section.settings.section_bg == 'gold_pale' %} bg-gold-pale{% elsif section.settings.section_bg == 'navy' %} bg-navy{% endif %}{% if section.settings.compact_mobile %} is-compact-mobile{% endif %}">

  {%- if grid_eyebrow != blank or section.settings.title != blank or section.settings.description != blank -%}
    <div class="product-grid-section__header">
      {%- if grid_eyebrow != blank -%}
        <p class="product-grid-section__eyebrow">{{ grid_eyebrow }}</p>
        <div class="product-grid-section__rule"></div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="product-grid-section__title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="product-grid-section__subtitle">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign product_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'product' and block.settings.product != blank -%}
      {%- assign product_count = product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign grid_cols = product_count | at_least: 1 | at_most: 4 -%}
  {%- if product_count == 0 -%}{%- assign grid_cols = 4 -%}{%- endif -%}
  {%- if gift_mode -%}<div class="pg-stage">{%- endif -%}
  <div class="product-grid-section__grid" style="--grid-cols: {{ grid_cols }};">
    {%- assign product_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        {%- assign product_handle = block.settings.product -%}
        {%- if product_handle != blank -%}
          {%- assign product = all_products[product_handle] -%}
          {% render 'product-card', card_product: product, tier_icons: section.settings.tier_icons, card_image: block.settings.image, card_hover_image: block.settings.hover_image, card_gift: gift_mode, block_zoom: block.settings.image_zoom, block_offset: block.settings.image_offset %}
          {%- assign product_count = product_count | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if product_count == 0 -%}
      {%- for i in (1..4) -%}
        {% render 'product-card', tier_icons: section.settings.tier_icons %}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="product-grid-section__nav">
    <button type="button" class="product-grid-section__arrow" data-carousel-prev aria-label="Producto anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
    </button>
    <button type="button" class="product-grid-section__arrow" data-carousel-next aria-label="Producto siguiente">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M9 6l6 6-6 6"/>
      </svg>
    </button>
  </div>
  {%- if gift_mode -%}</div>{%- endif -%}

  {%- if grid_cta_label != blank -%}
    <div class="product-grid-section__footer">
      <a href="{{ grid_cta_url }}" class="product-grid-section__view-all">
        {{ grid_cta_label }}
      </a>
    </div>
  {%- endif -%}

</section>

<script>
if (!window.cmGridCarouselInit) {
  window.cmGridCarouselInit = true;
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.product-grid-section__arrow');
    if (!btn) return;
    var wrap = btn.closest('.product-grid-section');
    if (wrap && wrap.classList.contains('is-gift')) return; /* el modo caja de regalo rota con su propio script */
    var grid = wrap && wrap.querySelector('.product-grid-section__grid');
    var cards = grid && grid.querySelectorAll('.product-card');
    if (!grid || !cards || !cards.length) return;
    /* Paso = ancho de tarjeta + hueco. (offsetLeft no sirve: la rejilla no es offsetParent y el
       scroll-snap devolvía el carrusel a la tarjeta 1, así que la flecha derecha parecía muerta.) */
    var gap = parseFloat(getComputedStyle(grid).columnGap || getComputedStyle(grid).gap) || 16;
    var step = cards[0].getBoundingClientRect().width + gap;
    var target = grid.scrollLeft + (btn.hasAttribute('data-carousel-prev') ? -step : step);
    grid.scrollTo({ left: target, behavior: 'smooth' });
  });

  var updateArrows = function(grid) {
    var wrap = grid.closest('.product-grid-section');
    if (wrap.classList.contains('is-gift')) return;
    var prevBtn = wrap.querySelector('[data-carousel-prev]');
    var nextBtn = wrap.querySelector('[data-carousel-next]');
    if (!prevBtn || !nextBtn) return;
    var maxScroll = grid.scrollWidth - grid.clientWidth;
    prevBtn.disabled = grid.scrollLeft <= 4;
    nextBtn.disabled = grid.scrollLeft >= maxScroll - 4;
  };

  document.querySelectorAll('.product-grid-section__grid').forEach(function(grid) {
    updateArrows(grid);
    grid.addEventListener('scroll', function() { updateArrows(grid); }, { passive: true });
  });
  window.addEventListener('resize', function() {
    document.querySelectorAll('.product-grid-section__grid').forEach(updateArrows);
  });
}
</script>

<script>
/* Carrusel de 3 en escena (modo caja de regalo). La tarjeta activa va al centro y las demás a los lados; rota con las flechas,
   al tocar/hacer clic en una tarjeta lateral, deslizando, con el teclado (foco) y solo en automático cada 5 s mientras la sección
   está en pantalla (se detiene al interactuar y con «reducir movimiento»). */
(function () {
  document.querySelectorAll('.product-grid-section.is-gift').forEach(function (sec) {
    if (sec.dataset.stageInit) return; sec.dataset.stageInit = '1';
    var grid = sec.querySelector('.product-grid-section__grid');
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.product-card'));
    var n = cards.length; if (n < 2) return;
    var half = Math.floor(n / 2), idx = 0, rels = [], timer = null, openT = null, paused = false;
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

    function layout() {
      cards.forEach(function (c, i) {
        var rel = ((i - idx + half) % n + n) % n - half;
        var wrapped = rels[i] !== undefined && Math.abs(rel - rels[i]) > 1;
        if (wrapped) c.classList.add('is-jump');
        c.style.setProperty('--pos', rel);
        c.classList.toggle('is-active', rel === 0);
        c.classList.toggle('is-side', Math.abs(rel) === 1);
        c.classList.toggle('is-far', Math.abs(rel) > 1);
        c.classList.remove('is-open');
        c.setAttribute('aria-hidden', rel === 0 ? 'false' : 'true');
        rels[i] = rel;
        if (wrapped) { void c.offsetWidth; c.classList.remove('is-jump'); }
      });
      clearTimeout(openT);
      openT = setTimeout(function () { cards[idx].classList.add('is-open'); }, 900);
    }
    function go(to) { idx = ((to % n) + n) % n; layout(); }
    function next() { go(idx + 1); }
    function prev() { go(idx - 1); }
    function stop() { clearInterval(timer); timer = null; }
    function start() { if (reduce || paused || timer) return; timer = setInterval(next, 5000); }
    function pause(ms) { paused = true; stop(); clearTimeout(pause.t); pause.t = setTimeout(function () { paused = false; if (visible) start(); }, ms || 9000); }

    var pb = sec.querySelector('[data-carousel-prev]'), nb = sec.querySelector('[data-carousel-next]');
    if (pb) pb.addEventListener('click', function () { prev(); pause(); });
    if (nb) nb.addEventListener('click', function () { next(); pause(); });

    /* Clic en una tarjeta lateral: la trae al centro en vez de abrir su ficha */
    grid.addEventListener('click', function (e) {
      var c = e.target.closest('.product-card'); if (!c) return;
      var i = cards.indexOf(c);
      if (i > -1 && i !== idx) { e.preventDefault(); e.stopPropagation(); go(i); pause(); }
    }, true);
    grid.addEventListener('focusin', function (e) {
      var c = e.target.closest('.product-card'); var i = cards.indexOf(c);
      if (i > -1 && i !== idx) { go(i); pause(); }
    });

    /* Deslizar con el dedo */
    var x0 = null, y0 = null;
    grid.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; pause(); }, { passive: true });
    grid.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0; x0 = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { dx < 0 ? next() : prev(); }
    }, { passive: true });

    sec.addEventListener('mouseenter', function () { paused = true; stop(); });
    sec.addEventListener('mouseleave', function () { paused = false; if (visible) start(); });

    var visible = false;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (en) { visible = en[0].isIntersecting; visible ? start() : stop(); }, { threshold: 0.4 }).observe(sec);
    }
    layout();
  });
})();
</script>

