{%- comment -%}
  Nosotros — Valores
  Cada valor es una escena editorial propia: fondo, composición y escala
  distintos. Las imágenes se desbordan hasta el borde del viewport y el
  numeral se superpone a la esquina. Sin marcos, sin bordes, sin tarjetas.
{%- endcomment -%}

{% render 'cm-reveal' %}

<style>
  #val-{{ section.id }} .val__scene {
    --pad: clamp(24px, 5vw, 72px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: clamp(20px, 2.5vw, 32px);
    align-items: center;
    padding-inline: var(--pad);
    padding-block: clamp(32px, 4vw, 60px);
    overflow: hidden;
  }

  #val-{{ section.id }} .val--crema { background: var(--cm-off);  --val-ink: var(--cm-navy); --val-muted: var(--cm-text-mid); }
  #val-{{ section.id }} .val--blanco { background: var(--cm-white); --val-ink: var(--cm-navy); --val-muted: var(--cm-text-mid); }
  #val-{{ section.id }} .val--navy  { background: var(--cm-navy); --val-ink: var(--cm-off);  --val-muted: rgba(250,246,239,0.62); }
  #val-{{ section.id }} .val--noche { background: #0C0C0C;        --val-ink: var(--cm-off);  --val-muted: rgba(250,246,239,0.56); }

  /* ── Media ── */
  #val-{{ section.id }} .val__media {
    position: relative;
    overflow: hidden;
  }
  #val-{{ section.id }} .val__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Texto ── */
  #val-{{ section.id }} .val__text { position: relative; z-index: 2; }

  #val-{{ section.id }} .val__num {
    display: block;
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(40px, 6vw, 92px);
    line-height: 0.9;
    color: var(--cm-gold);
    opacity: 0.5;
    margin-bottom: 16px;
    font-variant-numeric: tabular-nums;
  }

  #val-{{ section.id }} .val__name {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--val-ink);
    margin: 0 0 22px;
    text-wrap: balance;
  }
  #val-{{ section.id }} .val__name em { font-style: italic; color: var(--cm-gold); }

  #val-{{ section.id }} .val__line {
    font-family: var(--cm-font-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
    color: var(--val-muted);
    margin: 0;
    max-width: 42ch;
  }
  #val-{{ section.id }} .val__line p { margin: 0 0 1.1em; }
  #val-{{ section.id }} .val__line p:last-child { margin-bottom: 0; }

  #val-{{ section.id }} .val__meta {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 26px 0 0;
  }

  /* ── Composiciones ──
     La imagen rompe el contenedor hasta el borde del viewport. */

  /* imagen desbordada por la izquierda */
  #val-{{ section.id }} .val--izq .val__media {
    grid-column: 1 / span 7;
    margin-left: calc(-1 * var(--pad));
    aspect-ratio: 3 / 2;
  }
  #val-{{ section.id }} .val--izq .val__text { grid-column: 9 / span 4; }

  /* imagen desbordada por la derecha */
  #val-{{ section.id }} .val--der .val__media {
    grid-column: 6 / span 7;
    margin-right: calc(-1 * var(--pad));
    grid-row: 1;
    aspect-ratio: 3 / 2;
  }
  #val-{{ section.id }} .val--der .val__text { grid-column: 1 / span 4; grid-row: 1; }

  /* columna vertical alta, mucho aire al lado */
  #val-{{ section.id }} .val--columna .val__media {
    grid-column: 2 / span 4;
    aspect-ratio: 4 / 5;
  }
  #val-{{ section.id }} .val--columna .val__text { grid-column: 8 / span 4; }

  /* panorámica a todo el ancho, texto debajo desplazado */
  #val-{{ section.id }} .val--panoramica .val__media {
    grid-column: 1 / span 12;
    margin-inline: calc(-1 * var(--pad));
    aspect-ratio: 21 / 7;
  }
  #val-{{ section.id }} .val--panoramica .val__text { grid-column: 7 / span 5; }

  /* sin imagen: solo tipografía a gran escala */
  #val-{{ section.id }} .val--tipografica .val__text {
    grid-column: 2 / span 9;
    text-align: left;
  }
  #val-{{ section.id }} .val--tipografica .val__name { font-size: clamp(36px, 6.5vw, 104px); }
  #val-{{ section.id }} .val--tipografica .val__line { font-size: 16px; max-width: 46ch; }

  @media (max-width: 900px) {
    #val-{{ section.id }} .val__scene {
      grid-template-columns: 1fr;
      padding-block: clamp(28px, 6vw, 44px);
      row-gap: 20px;
    }
    #val-{{ section.id }} .val__scene .val__media,
    #val-{{ section.id }} .val__scene .val__text {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    #val-{{ section.id }} .val__media {
      order: 1;
      margin-inline: calc(-1 * var(--pad)) !important;
      aspect-ratio: 16 / 10 !important;
    }
    #val-{{ section.id }} .val--columna .val__media { aspect-ratio: 4 / 5 !important; }
    #val-{{ section.id }} .val__text { order: 2; }
    #val-{{ section.id }} .val__num { margin-bottom: 10px; }
  }

  #val-{{ section.id }} .val__anchor {
    display: block;
    height: 0;
    scroll-margin-top: 56px;
  }
</style>

<section
  id="val-{{ section.id }}"
  class="val"
  aria-label="{{ section.settings.aria_label | default: 'Nuestros valores' | escape }}"
>
  {%- if section.settings.anchor != blank -%}<span id="{{ section.settings.anchor }}" class="val__anchor" aria-hidden="true"></span>{%- endif -%}
  {%- for block in section.blocks -%}
    {%- liquid
      comment
        Los bloques del template anterior (text-full / centered) se normalizan
        al formato nuevo para que la sección siga montando la página mientras
        el template no se haya actualizado.
      endcomment
      assign b = block.settings

      if block.type == 'valor'
        assign v_image = b.image
        assign v_name = b.name
        assign v_line = b.line
        assign v_meta = b.meta
        assign layout = b.layout
        assign ground = b.ground
      else
        assign v_image = b.background_image | default: b.image
        assign v_name = b.headline
        assign v_line = b.body
        assign v_meta = b.value_name
        assign cycle_i = forloop.index0 | modulo: 4
        case cycle_i
          when 0
            assign layout = 'izq'
            assign ground = 'crema'
          when 1
            assign layout = 'tipografica'
            assign ground = 'navy'
          when 2
            assign layout = 'der'
            assign ground = 'blanco'
          else
            assign layout = 'panoramica'
            assign ground = 'noche'
        endcase
      endif

      if v_image == blank
        assign layout = 'tipografica'
      endif
    -%}
    <article
      class="val__scene val--{{ layout }} val--{{ ground }}"
      {{ block.shopify_attributes }}
    >
      {%- if layout != 'tipografica' and v_image != blank -%}
        <div class="val__media" data-cm-reveal>
          {{ v_image
            | image_url: width: 2000, format: 'webp'
            | image_tag:
                loading: 'lazy',
                sizes: '(max-width: 900px) 100vw, 60vw',
                widths: '600, 900, 1300, 1700, 2000',
                alt: v_meta | escape
          }}
        </div>
      {%- endif -%}

      <div class="val__text" data-cm-reveal data-cm-delay="1">
        <span class="val__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        {%- if v_name != blank -%}
          <h2 class="val__name">{{ v_name }}</h2>
        {%- endif -%}
        {%- if v_line != blank -%}
          <div class="val__line">{{ v_line }}</div>
        {%- endif -%}
        {%- if v_meta != blank -%}
          <p class="val__meta">{{ v_meta }}</p>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Nosotros — Valores",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "valor",
      "name": "Valor",
      "settings": [
        {
          "type": "richtext",
          "id": "name",
          "label": "Nombre del valor",
          "info": "Usa cursiva para resaltar en dorado.",
          "default": "<p>Un valor <em>que no negociamos</em></p>"
        },
        {
          "type": "richtext",
          "id": "line",
          "label": "Frase",
          "info": "Corta. Puedes usar varios párrafos y negrita.",
          "default": "<p>Una frase corta que lo explique. Dos líneas como mucho.</p>"
        },
        { "type": "text", "id": "meta", "label": "Etiqueta inferior", "info": "Opcional. El nombre del valor." },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Sin imagen, la escena queda solo tipográfica." },
        {
          "type": "select",
          "id": "layout",
          "label": "Composición",
          "info": "Alterna para que ninguna escena se lea igual que la anterior.",
          "options": [
            { "value": "izq", "label": "Imagen desbordada a la izquierda" },
            { "value": "der", "label": "Imagen desbordada a la derecha" },
            { "value": "columna", "label": "Columna vertical con aire" },
            { "value": "panoramica", "label": "Panorámica a todo el ancho" },
            { "value": "tipografica", "label": "Solo tipografía" }
          ],
          "default": "izq"
        },
        {
          "type": "select",
          "id": "ground",
          "label": "Fondo de la escena",
          "options": [
            { "value": "crema", "label": "Crema" },
            { "value": "blanco", "label": "Blanco" },
            { "value": "navy", "label": "Navy" },
            { "value": "noche", "label": "Negro" }
          ],
          "default": "crema"
        }
      ]
    },
    {
      "type": "text-full",
      "name": "Valor a sangre (legado)",
      "settings": [
        { "type": "paragraph", "content": "Bloque heredado. Se dibuja con la composición nueva; al pasarlo a «Valor» tendrás control de composición y fondo." },
        { "type": "image_picker", "id": "background_image", "label": "Imagen" },
        { "type": "text",     "id": "value_name", "label": "Nombre del valor" },
        { "type": "text",     "id": "headline",   "label": "Titular" },
        { "type": "richtext", "id": "body",       "label": "Texto" }
      ]
    },
    {
      "type": "centered",
      "name": "Valor centrado (legado)",
      "settings": [
        { "type": "paragraph", "content": "Bloque heredado. Se dibuja con la composición nueva; al pasarlo a «Valor» tendrás control de composición y fondo." },
        { "type": "image_picker", "id": "background_image", "label": "Imagen" },
        { "type": "text",     "id": "value_name", "label": "Nombre del valor" },
        { "type": "text",     "id": "headline",   "label": "Titular" },
        { "type": "richtext", "id": "body",       "label": "Texto" }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Navegación"
    },
    { "type": "text", "id": "anchor", "label": "ID de ancla (para el índice)", "info": "Debe coincidir con el enlace del índice. Déjalo vacío si no se enlaza desde ahí.", "default": "valores" },
    { "type": "text", "id": "aria_label", "label": "Etiqueta accesibilidad", "default": "Nuestros valores" }
  ],
  "presets": [
    {
      "name": "Nosotros — Valores",
      "blocks": [
        {
          "type": "valor",
          "settings": {
            "name": "<p>Solo ponemos <em>lo que creemos</em></p>",
            "line": "<p>Si un producto no nos convence en la primera prueba, no llega a nuestra tienda. Decimos que no con mucha más frecuencia de la que decimos que sí.</p>",
            "meta": "Autenticidad",
            "layout": "columna",
            "ground": "blanco"
          }
        },
        {
          "type": "valor",
          "settings": {
            "name": "<p>Un equilibrio que <em>no se puede romper</em></p>",
            "line": "<p>Entre el animal y su entorno, entre el productor y su tierra, entre nosotros y quien recibe el pedido.</p>",
            "meta": "Respeto",
            "layout": "tipografica",
            "ground": "navy"
          }
        },
        {
          "type": "valor",
          "settings": {
            "name": "<p>Sin excepciones y <em>sin excusas</em></p>",
            "line": "<p>El mismo estándar en la selección, en el envasado y en la logística. Cuando algo no llega al nivel, lo decimos y lo arreglamos.</p>",
            "meta": "Exigencia",
            "layout": "izq",
            "ground": "crema"
          }
        },
        {
          "type": "valor",
          "settings": {
            "name": "<p>La tradición y la innovación <em>no son opuestos</em></p>",
            "line": "<p>Son los dos extremos del mismo hilo: honramos el saber de generaciones mientras buscamos nuevas formas de acercarlo.</p>",
            "meta": "Imaginación",
            "layout": "panoramica",
            "ground": "noche"
          }
        }
      ]
    }
  ]
}
{% endschema %}
