{%- comment -%}
  Nosotros — Valores
  Cada valor es una escena editorial propia: fondo, composición y escala
  distintos. Las imágenes se desbordan hasta el borde del viewport y el
  numeral se superpone a la esquina. Sin marcos, sin bordes, sin tarjetas.
{%- endcomment -%}

{% render 'cm-reveal' %}

<style>
  #val-{{ section.id }} .val__scene {
    --pad: clamp(24px, 5vw, 72px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: clamp(20px, 3vw, 48px);
    row-gap: clamp(28px, 4vw, 52px);
    align-items: center;
    padding-inline: var(--pad);
    padding-block: clamp(72px, 11vw, 168px);
    overflow: hidden;
  }

  #val-{{ section.id }} .val--crema { background: var(--cm-off);  --val-ink: var(--cm-navy); --val-muted: var(--cm-text-mid); }
  #val-{{ section.id }} .val--blanco { background: var(--cm-white); --val-ink: var(--cm-navy); --val-muted: var(--cm-text-mid); }
  #val-{{ section.id }} .val--navy  { background: var(--cm-navy); --val-ink: var(--cm-off);  --val-muted: rgba(250,246,239,0.62); }
  #val-{{ section.id }} .val--noche { background: #0C0C0C;        --val-ink: var(--cm-off);  --val-muted: rgba(250,246,239,0.56); }

  /* ── Media ── */
  #val-{{ section.id }} .val__media {
    position: relative;
    overflow: hidden;
  }
  #val-{{ section.id }} .val__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Texto ── */
  #val-{{ section.id }} .val__text { position: relative; z-index: 2; }

  #val-{{ section.id }} .val__num {
    display: block;
    font-family: var(--cm-font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(40px, 6vw, 92px);
    line-height: 0.9;
    color: var(--cm-gold);
    opacity: 0.5;
    margin-bottom: 16px;
    font-variant-numeric: tabular-nums;
  }

  #val-{{ section.id }} .val__name {
    font-family: var(--cm-font-serif);
    font-weight: 300;
    font-size: clamp(30px, 4.4vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--val-ink);
    margin: 0 0 22px;
    text-wrap: balance;
  }
  #val-{{ section.id }} .val__name em { font-style: italic; color: var(--cm-gold); }

  #val-{{ section.id }} .val__line {
    font-family: var(--cm-font-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.85;
    color: var(--val-muted);
    margin: 0;
    max-width: 42ch;
  }

  #val-{{ section.id }} .val__meta {
    font-family: var(--cm-font-sans);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 26px 0 0;
  }

  /* ── Composiciones ──
     La imagen rompe el contenedor hasta el borde del viewport. */

  /* imagen desbordada por la izquierda */
  #val-{{ section.id }} .val--izq .val__media {
    grid-column: 1 / span 7;
    margin-left: calc(-1 * var(--pad));
    aspect-ratio: 5 / 4;
  }
  #val-{{ section.id }} .val--izq .val__text { grid-column: 9 / span 4; }

  /* imagen desbordada por la derecha */
  #val-{{ section.id }} .val--der .val__media {
    grid-column: 6 / span 7;
    margin-right: calc(-1 * var(--pad));
    grid-row: 1;
    aspect-ratio: 5 / 4;
  }
  #val-{{ section.id }} .val--der .val__text { grid-column: 1 / span 4; grid-row: 1; }

  /* columna vertical alta, mucho aire al lado */
  #val-{{ section.id }} .val--columna .val__media {
    grid-column: 2 / span 4;
    aspect-ratio: 3 / 4;
  }
  #val-{{ section.id }} .val--columna .val__text { grid-column: 8 / span 4; }

  /* panorámica a todo el ancho, texto debajo desplazado */
  #val-{{ section.id }} .val--panoramica .val__media {
    grid-column: 1 / span 12;
    margin-inline: calc(-1 * var(--pad));
    aspect-ratio: 21 / 9;
  }
  #val-{{ section.id }} .val--panoramica .val__text { grid-column: 7 / span 5; }

  /* sin imagen: solo tipografía a gran escala */
  #val-{{ section.id }} .val--tipografica .val__text {
    grid-column: 2 / span 9;
    text-align: left;
  }
  #val-{{ section.id }} .val--tipografica .val__name { font-size: clamp(36px, 6.5vw, 104px); }
  #val-{{ section.id }} .val--tipografica .val__line { font-size: 16px; max-width: 46ch; }

  @media (max-width: 900px) {
    #val-{{ section.id }} .val__scene {
      grid-template-columns: 1fr;
      padding-block: clamp(56px, 12vw, 90px);
      row-gap: 26px;
    }
    #val-{{ section.id }} .val__scene .val__media,
    #val-{{ section.id }} .val__scene .val__text {
      grid-column: 1 / -1 !important;
      grid-row: auto !important;
    }
    #val-{{ section.id }} .val__media {
      order: 1;
      margin-inline: calc(-1 * var(--pad)) !important;
      aspect-ratio: 4 / 3 !important;
    }
    #val-{{ section.id }} .val--columna .val__media { aspect-ratio: 4 / 5 !important; }
    #val-{{ section.id }} .val__text { order: 2; }
    #val-{{ section.id }} .val__num { margin-bottom: 10px; }
  }
</style>

<section
  id="val-{{ section.id }}"
  class="val"
  aria-label="{{ section.settings.aria_label | default: 'Nuestros valores' | escape }}"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign layout = block.settings.layout
      if block.settings.image == blank
        assign layout = 'tipografica'
      endif
    -%}
    <article
      class="val__scene val--{{ layout }} val--{{ block.settings.ground }}"
      {{ block.shopify_attributes }}
    >
      {%- if layout != 'tipografica' and block.settings.image != blank -%}
        <div class="val__media" data-cm-reveal>
          {{ block.settings.image
            | image_url: width: 2000, format: 'webp'
            | image_tag:
                loading: 'lazy',
                sizes: '(max-width: 900px) 100vw, 60vw',
                widths: '600, 900, 1300, 1700, 2000',
                alt: block.settings.name | escape
          }}
        </div>
      {%- endif -%}

      <div class="val__text" data-cm-reveal data-cm-delay="1">
        <span class="val__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        {%- if block.settings.name != blank -%}
          <h2 class="val__name">{{ block.settings.name }}</h2>
        {%- endif -%}
        {%- if block.settings.line != blank -%}
          <p class="val__line">{{ block.settings.line }}</p>
        {%- endif -%}
        {%- if block.settings.meta != blank -%}
          <p class="val__meta">{{ block.settings.meta }}</p>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Nosotros — Valores",
  "tag": "section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "valor",
      "name": "Valor",
      "settings": [
        {
          "type": "richtext",
          "id": "name",
          "label": "Nombre del valor",
          "info": "Usa cursiva para resaltar en dorado.",
          "default": "<p>Solo ponemos <em>lo que creemos</em></p>"
        },
        {
          "type": "textarea",
          "id": "line",
          "label": "Frase",
          "info": "Corta. Dos o tres líneas como mucho.",
          "default": "Si un producto no nos convence en la primera prueba, no llega a nuestra tienda."
        },
        { "type": "text", "id": "meta", "label": "Etiqueta inferior", "info": "Opcional.", "default": "Autenticidad" },
        { "type": "image_picker", "id": "image", "label": "Imagen", "info": "Sin imagen, la escena queda solo tipográfica." },
        {
          "type": "select",
          "id": "layout",
          "label": "Composición",
          "info": "Alterna para que ninguna escena se lea igual que la anterior.",
          "options": [
            { "value": "izq", "label": "Imagen desbordada a la izquierda" },
            { "value": "der", "label": "Imagen desbordada a la derecha" },
            { "value": "columna", "label": "Columna vertical con aire" },
            { "value": "panoramica", "label": "Panorámica a todo el ancho" },
            { "value": "tipografica", "label": "Solo tipografía" }
          ],
          "default": "izq"
        },
        {
          "type": "select",
          "id": "ground",
          "label": "Fondo de la escena",
          "options": [
            { "value": "crema", "label": "Crema" },
            { "value": "blanco", "label": "Blanco" },
            { "value": "navy", "label": "Navy" },
            { "value": "noche", "label": "Negro" }
          ],
          "default": "crema"
        }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Etiqueta accesibilidad", "default": "Nuestros valores" }
  ],
  "presets": [
    {
      "name": "Nosotros — Valores",
      "blocks": [
        { "type": "valor", "settings": { "layout": "izq", "ground": "crema" } },
        { "type": "valor", "settings": { "layout": "der", "ground": "navy" } },
        { "type": "valor", "settings": { "layout": "columna", "ground": "blanco" } },
        { "type": "valor", "settings": { "layout": "panoramica", "ground": "noche" } }
      ]
    }
  ]
}
{% endschema %}
