<style>
  .trust-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 2px solid var(--cm-gold);
    border-bottom: 1px solid var(--cm-border);
    background: var(--cm-off);
  }

  .trust-band__cell {
    padding: 40px 28px;
    border-right: 1px solid var(--cm-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .trust-band__cell:last-child { border-right: none; }

  .trust-band__icon {
    width: 32px;
    height: 32px;
    color: var(--cm-gold);
    flex-shrink: 0;
  }

  .trust-band__title {
    font-size: 12px;
    font-weight: 500;
    color: var(--cm-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    line-height: 1.3;
  }

  .trust-band__desc {
    font-size: 12px;
    color: var(--cm-text-mid);
    line-height: 1.55;
    font-family: var(--cm-font-sans);
  }

  @media (max-width: 767px) {
    .trust-band {
      grid-template-columns: 1fr 1fr;
    }
    .trust-band__cell:nth-child(2) { border-right: none; }
    .trust-band__cell:nth-child(3) {
      border-right: 1px solid var(--cm-border);
      border-top: 1px solid var(--cm-border);
    }
    .trust-band__cell:nth-child(4) {
      border-top: 1px solid var(--cm-border);
    }
    .trust-band__cell:nth-child(5) {
      border-right: none;
      border-top: 1px solid var(--cm-border);
    }
    .trust-band__cell { padding: 32px 20px; }
  }
</style>

{%- comment -%}
Icon mapping for trust band items. Each block uses hardcoded SVG files.
To change icons per item, modify the icon names below:
Available icons: formato.svg, icon-envio.svg, icon-garantia.svg, icon-conservacion.svg, icon-peso.svg
{%- endcomment -%}
{%- assign icons = 'icon-envio.svg|icon-garantia.svg|icon-conservacion.svg|icon-peso.svg|formato.svg' | split: '|' -%}

<div class="trust-band" id="cm-trust-band">
  {%- for block in section.blocks -%}
    {%- assign icon_name = icons[forloop.index0] -%}
    <div class="trust-band__cell" {{ block.shopify_attributes }} {%- if icon_name == 'formato.svg' %} id="cm-trust-formato" data-is-formato="true"{% endif %}>
      <div class="trust-band__icon">
        {%- render 'icon-selector', icon: icon_name, width: 32, height: 32, css_class: 'trust-band__icon-img' -%}
      </div>
      <div>
        <p class="trust-band__title" {%- if icon_name == 'formato.svg' %} id="cm-trust-formato-title"{% endif %}>{{ block.settings.title }}</p>
        <p class="trust-band__desc" {%- if icon_name == 'formato.svg' %} id="cm-trust-formato-desc"{% endif %}>{{ block.settings.description }}</p>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Banda de confianza",
  "tag": "section",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Elemento",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Envío gratis"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción",
          "default": "A partir de €80 en Peninsula"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banda de confianza",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "title": "Envío gratis",
            "description": "A partir de €80 en Península"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Calidad garantizada",
            "description": "Tres generaciones de artesanía ibérica"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Embalaje especial",
            "description": "Conservación en frío garantizada"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Packaging regalo",
            "description": "Presentación premium para regalar"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "title": "Múltiples formatos",
            "description": "Cortado, deshuesado o pieza entera"
          }
        }
      ]
    }
  ]
}
{% endschema %}
