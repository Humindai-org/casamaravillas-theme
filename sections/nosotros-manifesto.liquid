<style>
  #nsm-{{ section.id }} {
    --nsm-height: {{ section.settings.height | default: 55 }}vh;
    --nsm-height-mobile: {{ section.settings.height_mobile | default: 45 }}vh;
    --nsm-pos-x: {{ section.settings.image_pos_x | default: 50 }}%;
    --nsm-pos-y: {{ section.settings.image_pos_y | default: 20 }}%;
    --nsm-zoom: {{ section.settings.image_zoom | default: 100 | divided_by: 100.0 }};
    --nsm-saturation: {{ section.settings.image_saturation | default: 75 | divided_by: 100.0 }};
    --nsm-brightness: {{ section.settings.image_brightness | default: 85 | divided_by: 100.0 }};
    --nsm-veil: {{ section.settings.overlay_opacity | default: 0 | divided_by: 100.0 }};
    {%- if section.settings.image != blank and section.settings.image.aspect_ratio %}
    --nsm-ratio: {{ section.settings.image.aspect_ratio }};
    {%- endif %}
  }

  /*
   * With an image: the section's height follows the photo's own
   * proportions (aspect-ratio) up to the max-height cap below, so it
   * never looks stretched sideways-cropped — any excess is trimmed
   * off the bottom instead (bias the vertical encuadre to control
   * what stays visible). Without an image, the cap acts as the
   * section's fixed height.
   */
  .nsm {
    position: relative;
    width: 100%;
    aspect-ratio: var(--nsm-ratio, auto);
    min-height: 260px;
    {%- if section.settings.image != blank %}
    max-height: var(--nsm-height);
    {%- else %}
    min-height: var(--nsm-height);
    {%- endif %}
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background: #1a1a1a;
  }

  .nsm__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--nsm-pos-x) var(--nsm-pos-y);
    transform: scale(var(--nsm-zoom));
    filter: saturate(var(--nsm-saturation)) brightness(var(--nsm-brightness));
  }

  .nsm__veil {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,var(--nsm-veil));
    pointer-events: none;
    z-index: 1;
  }

  .nsm__grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.06'/%3E%3C/svg%3E");
    background-size: 180px;
    pointer-events: none;
    z-index: 2;
  }

  .nsm__fade {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 55%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.65), transparent);
    pointer-events: none;
    z-index: 2;
  }

  .nsm__content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: clamp(28px, 5vw, 56px) 24px 32px;
    max-width: 640px;
    margin: 0 auto;
  }

  .nsm__eyebrow {
    font-family: var(--cm-font-sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin-bottom: 16px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }

  .nsm__rule {
    width: 32px;
    height: 1px;
    background: var(--cm-gold);
    margin: 0 auto 16px;
  }

  .nsm__quote {
    font-family: var(--cm-font-serif);
    font-size: clamp(20px, 2.6vw, 30px);
    font-weight: 400;
    font-style: normal;
    color: var(--cm-off);
    line-height: 1.4;
    margin: 0 0 20px;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 16px rgba(0,0,0,0.55);
  }

  .nsm__attribution {
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin-bottom: 40px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.5);
  }

  .nsm__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 28px;
    border: 1.5px solid var(--cm-gold);
    color: var(--cm-navy);
    font-family: var(--cm-font-sans);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--cm-gold);
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .nsm__cta:hover {
    background: #a97f2c;
    border-color: #a97f2c;
  }

  .nsm__cta:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 3px;
  }

  .nsm .cm-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .nsm .cm-reveal.is-visible { opacity: 1; transform: none; }
  .nsm .cm-reveal--d1 { transition-delay: 0.15s; }
  .nsm .cm-reveal--d2 { transition-delay: 0.3s; }
  .nsm .cm-reveal--d3 { transition-delay: 0.45s; }
  .nsm .cm-reveal--d4 { transition-delay: 0.6s; }

  @media (max-width: 767px) {
    .nsm {
      min-height: 200px;
      align-items: stretch;
      {%- if section.settings.image != blank %}
      max-height: var(--nsm-height-mobile);
      {%- else %}
      min-height: var(--nsm-height-mobile);
      {%- endif %}
    }
    /* Content stretches full height; the button sticks to the
       bottom (margin-top: auto) instead of following right under
       the quote, so it never sits over the faces. */
    .nsm__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 18px 20px 14px;
    }
    .nsm__quote {
      font-size: 15px;
      margin-top: 28px;
      margin-bottom: 0;
    }
    .nsm__cta {
      margin-top: auto;
      padding: 8px 18px;
      font-size: 8px;
      gap: 6px;
    }
    .nsm__cta svg {
      width: 10px;
      height: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nsm .cm-reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<section class="nsm" id="nsm-{{ section.id }}">

  {%- if section.settings.image != blank -%}
    {{ section.settings.image
      | image_url: width: 1800, format: 'webp'
      | image_tag:
          class: 'nsm__bg',
          loading: 'lazy',
          alt: section.settings.image.alt | escape
    }}
  {%- endif -%}

  <div class="nsm__veil"  aria-hidden="true"></div>
  <div class="nsm__grain" aria-hidden="true"></div>
  <div class="nsm__fade"  aria-hidden="true"></div>

  <div class="nsm__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="nsm__eyebrow cm-reveal">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <div class="nsm__rule cm-reveal cm-reveal--d1" aria-hidden="true"></div>

    <blockquote class="nsm__quote cm-reveal cm-reveal--d2">
      {{ section.settings.quote | default: 'Tres generaciones seleccionando los mejores ibéricos de España.' }}
    </blockquote>

    {%- if section.settings.cta_label != blank -%}
      <a
        href="{{ section.settings.cta_url | default: '/collections/all' }}"
        class="nsm__cta cm-reveal cm-reveal--d3"
      >
        {{ section.settings.cta_label }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

</section>

<script>
(function() {
  var sec = document.getElementById('nsm-{{ section.id }}');
  if (!sec) return;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('is-visible'); });
  }, { threshold: 0.1 });
  sec.querySelectorAll('.cm-reveal').forEach(function(el) { obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Nosotros — Manifiesto",
  "tag": "section",
  "settings": [
    { "type": "header",       "content": "Imagen de fondo" },
    { "type": "image_picker", "id": "image",       "label": "Imagen" },
    {
      "type": "range",
      "id": "image_pos_x",
      "label": "Encuadre horizontal",
      "info": "0% = izquierda · 50% = centro · 100% = derecha",
      "min": 0, "max": 100, "step": 5, "default": 50, "unit": "%"
    },
    {
      "type": "range",
      "id": "image_pos_y",
      "label": "Encuadre vertical",
      "info": "0% = arriba · 50% = centro · 100% = abajo. Si la sección recorta la imagen, un valor bajo mantiene visible la parte de arriba y recorta por abajo.",
      "min": 0, "max": 100, "step": 5, "default": 20, "unit": "%"
    },
    {
      "type": "range",
      "id": "image_zoom",
      "label": "Zoom",
      "info": "100% = imagen completa. Súbelo para acercar el encuadre.",
      "min": 100, "max": 200, "step": 5, "default": 100, "unit": "%"
    },
    {
      "type": "range",
      "id": "image_saturation",
      "label": "Saturación",
      "min": 0, "max": 150, "step": 5, "default": 75, "unit": "%"
    },
    {
      "type": "range",
      "id": "image_brightness",
      "label": "Brillo",
      "min": 30, "max": 130, "step": 5, "default": 85, "unit": "%"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Capa oscura sobre la imagen",
      "info": "Súbela si el texto no se lee bien.",
      "min": 0, "max": 80, "step": 5, "default": 0, "unit": "%"
    },
    { "type": "header",       "content": "Altura de la sección" },
    {
      "type": "paragraph",
      "content": "La sección respeta las proporciones de la foto hasta esta altura máxima; si la foto es más alta, se recorta por abajo (usa el encuadre vertical para elegir qué parte se conserva). Así no queda desproporcionada frente a otras secciones."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Altura máxima en escritorio",
      "info": "Porcentaje de la altura de la pantalla.",
      "min": 30, "max": 100, "step": 5, "default": 55, "unit": "%"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Altura máxima en móvil",
      "min": 25, "max": 100, "step": 5, "default": 45, "unit": "%"
    },
    { "type": "header",       "content": "Textos" },
    { "type": "text",         "id": "eyebrow",     "label": "Etiqueta superior",  "default": "Nuestra convicción" },
    { "type": "text",         "id": "quote",       "label": "Frase principal",    "default": "Lo excepcional merece ser accesible" },
    { "type": "text",         "id": "attribution", "label": "Atribución",         "default": "Casa Maravillas — Tres generaciones de selección" },
    { "type": "text",         "id": "cta_label",   "label": "Texto del botón",    "default": "Descubre nuestra selección" },
    { "type": "url",          "id": "cta_url",     "label": "Enlace del botón" }
  ],
  "presets": [
    {
      "name": "Nosotros — Manifiesto"
    }
  ]
}
{% endschema %}
