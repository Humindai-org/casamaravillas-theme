{% comment %}
  main-product.liquid — Sección de producto premium para Casa Maravillas
  Jamones, embutidos y productos ibéricos
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
{%- assign product_accent = '#00294B' -%}
{%- case product.type -%}
  {%- when 'Jamón' -%}           {%- assign product_accent = '#C4973A' -%}
  {%- when 'Carnes Ibéricas' -%} {%- assign product_accent = '#C05A38' -%}
  {%- when 'Embutidos' -%}       {%- assign product_accent = '#7A1F3C' -%}
  {%- when 'Packs & Regalos' -%} {%- assign product_accent = '#4A5B6B' -%}
{%- endcase -%}


<style>
  /* ── VARIABLES DE COLOR — paleta crema clara ── */
  :root {
    --bg-primary:   #F5F0E8;
    --bg-secondary: #EDEAE2;
    --bg-card:      #FFFFFF;
    --text-primary: #1A1410;
    --text-secondary: #6B5E4E;
    --accent-gold:  #C9A84C;
    --border-color: #D6CFC4;
    --sticky-bg:    #1A1410;
  }

  /* ── LAYOUT PRINCIPAL ── */
.cm-pdp {
  --pdp-accent: {{ product_accent }};
  width: 100%;
  padding: 56px 48px 80px;
  background: var(--bg-primary);
  box-sizing: border-box;
}

.cm-pdp__grid {
  max-width: 1280px;
  margin: 0 auto;
}

  .cm-pdp__grid {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 64px;
    align-items: start;
  }

  /* ── GALERÍA ── */
  .cm-pdp__gallery {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: row;
    gap: 14px;
    align-items: flex-start;
  }

  .cm-pdp__main-img-wrap {
    flex: 1;
    min-width: 0;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--bg-secondary);
    position: relative;
  }

  .cm-pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: var(--gal-fit, contain);
    object-position: var(--gal-pos-x, 50%) var(--gal-pos-y, 50%);
    transform: scale(var(--gal-zoom, 1));
    transform-origin: var(--gal-pos-x, 50%) var(--gal-pos-y, 50%);
    display: block;
    transition: opacity 0.25s ease;
  }

  .cm-pdp__main-img.is-loading { opacity: 0; }

  /* Thumbnails — columna vertical izquierda */
  .cm-pdp__thumbnails {
    display: flex;
    flex-direction: column;
    gap: 10px;
    order: -1;
    width: 72px;
    flex-shrink: 0;
    overflow-y: auto;
    overflow-x: hidden;
    max-height: 520px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
    padding-right: 2px;
  }

  .cm-pdp__thumbnails::-webkit-scrollbar { width: 3px; }
  .cm-pdp__thumbnails::-webkit-scrollbar-track { background: transparent; }
  .cm-pdp__thumbnails::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 2px; }

  .cm-pdp__thumb-btn {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border: 2px solid var(--border-color);
    background: var(--bg-card);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .cm-pdp__thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cm-pdp__thumb-btn.is-active { border-color: var(--accent-gold); }
  .cm-pdp__thumb-btn:hover:not(.is-active) { border-color: var(--text-secondary); }
  .cm-pdp__thumb-btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }

  /* ── INFO ── */
  .cm-pdp__eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .cm-pdp__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(28px, 3vw, 42px);
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: 20px;
    font-weight: 400;
  }

  /* ── BARRA DE HECHOS RÁPIDOS ── */
  .cm-pdp__facts {
    display: flex;
    gap: 0;
    border: 1px solid var(--border-color);
    margin-bottom: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--bg-card);
    border-radius: 4px;
  }

  .cm-pdp__facts::-webkit-scrollbar { display: none; }

  .cm-fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px 16px;
    flex: 1;
    min-width: 100px;
    border-right: 1px solid var(--border-color);
    text-align: center;
  }

  .cm-fact:last-child { border-right: none; }

  .cm-fact__icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    margin-bottom: 2px;
  }

  .cm-fact__label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    display: block;
    line-height: 1;
    font-weight: 400;
  }

  .cm-fact__value {
    font-size: 15px;
    font-weight: 300;
    color: var(--text-primary);
    font-family: var(--cm-font-serif, var(--cm-font-sans));
    display: block;
    line-height: 1.35;
    white-space: normal;
    word-break: break-word;
    max-width: 100%;
  }

  /* ── PRECIO ── */
  .cm-pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .cm-pdp__price {
    font-size: 28px;
    font-weight: 400;
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
  }

  .cm-pdp__price--sale { color: #8B1A1A; }

  .cm-pdp__price--compare {
    font-size: 17px;
    color: var(--text-secondary);
    text-decoration: line-through;
  }

  .cm-pdp__discount-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    background: #8B1A1A;
    color: #fff;
    padding: 3px 8px;
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  .cm-pdp__price-kg {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 24px;
  }

  /* ── VOLUMEN DISCOUNT ── */
  .cm-volume-discount {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 4px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .cm-volume-discount__original {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: line-through;
    font-family: var(--cm-font-sans);
  }

  .cm-volume-discount__price {
    font-size: 22px;
    font-weight: 500;
    color: #8B1A1A;
    font-family: var(--cm-font-sans);
  }

  .cm-volume-discount__badge {
    font-size: 12px;
    font-weight: 500;
    color: #8B1A1A;
    font-family: var(--cm-font-sans);
  }

  /* ── VARIANTES (select dropdown) ── */
  .cm-pdp__variants { margin-bottom: 24px; }

  .cm-pdp__select-wrap {
    position: relative;
    margin-bottom: 16px;
  }

  .cm-pdp__select-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 10px;
    display: block;
  }

  .cm-pdp__select {
    width: 100%;
    padding: 14px 44px 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
    font-size: 14px;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .cm-pdp__select:hover { border-color: var(--text-primary); }
  .cm-pdp__select:focus { outline: 2px solid var(--accent-gold); outline-offset: 0; }

  .cm-pdp__select-arrow {
    position: absolute;
    right: 14px;
    bottom: 16px;
    pointer-events: none;
    color: var(--accent-gold);
    display: flex;
  }

  /* Nota de impuestos */
  .cm-pdp__tax-note {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 20px;
  }

  /* ── SELECTOR DE CURACIÓN ── */
  .cm-curing-selector { margin-bottom: 24px; }

  .option-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin: 0 0 8px;
    display: block;
  }

  .option-buttons { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 8px; }

  .option-btn {
    padding: 10px 18px;
    border: 1.5px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
    font-size: 13px;
    cursor: pointer;
    border-radius: 4px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .option-btn:hover { border-color: var(--accent-gold); }

  .option-btn.active {
    border-color: var(--accent-gold);
    background: var(--accent-gold);
    color: #1A1410;
    font-weight: 600;
  }

  .option-hint {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    font-style: italic;
    margin: 0;
    min-height: 18px;
  }

  /* ── COMPRA ── */
  .cm-pdp__purchase {
    display: flex;
    gap: 10px;
    align-items: stretch;
    margin-bottom: 24px;
  }

  .cm-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
    background: var(--bg-card);
  }

  .cm-qty__btn {
    width: 44px;
    height: 52px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    font-family: var(--cm-font-sans);
  }

  .cm-qty__btn:hover { background: var(--bg-secondary); }

  .cm-qty__btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .cm-qty__input {
    width: 44px;
    height: 52px;
    border: none;
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    text-align: center;
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: var(--text-primary);
    background: transparent;
    -moz-appearance: textfield;
  }

  .cm-qty__input::-webkit-outer-spin-button,
  .cm-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .cm-pdp__add-btn {
    flex: 1;
    height: 64px;
    background: var(--accent-gold);
    color: #1A1410;
    border: 1px solid var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-size: 12px;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }

  .cm-pdp__add-btn:hover:not(:disabled) {
    background: transparent;
    color: var(--accent-gold);
  }

  .cm-pdp__add-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .cm-pdp__add-btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  /* ── DESCRIPCIÓN CORTA ── */
  .cm-pdp__desc {
    margin-top: 40px;
    margin-bottom: 24px;
  }

  .cm-pdp__desc-preview {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    transition: opacity 0.3s;
    overflow: visible;
    padding: 24px;
    background: var(--bg-card);
    border-radius: 4px;
  }

  .cm-pdp__desc-preview strong,
  .cm-pdp__desc-preview b {
    font-weight: 600;
    color: var(--text-primary);
  }

  .cm-pdp__desc-preview em,
  .cm-pdp__desc-preview i {
    font-style: italic;
  }

  .cm-pdp__desc-preview ul,
  .cm-pdp__desc-preview ol {
    margin: 12px 0;
    padding-left: 30px !important;
  }

  .cm-pdp__desc-preview li {
    margin-bottom: 8px;
    padding-left: 20px;
    list-style: disc;
  }

  .cm-pdp__desc-preview p {
    margin: 12px 0;
  }

  .cm-pdp__desc-full {
    font-size: 16px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.4s ease;
    opacity: 0;
  }

  .cm-pdp__desc-full strong,
  .cm-pdp__desc-full b {
    font-weight: 600;
    color: var(--text-primary);
  }

  .cm-pdp__desc-full em,
  .cm-pdp__desc-full i {
    font-style: italic;
  }

  .cm-pdp__desc-full ul,
  .cm-pdp__desc-full ol {
    margin: 12px 0;
    padding-left: 30px !important;
  }

  .cm-pdp__desc-full li {
    margin-bottom: 8px;
    padding-left: 20px;
    list-style: disc;
  }

  .cm-pdp__desc-full p {
    margin: 12px 0;
  }

  .cm-pdp__desc-full.is-open {
    max-height: 1200px !important;
    opacity: 1 !important;
  }

  .cm-pdp__desc-full.is-open + .cm-pdp__desc-preview { display: none; }

  .cm-desc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-top: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .cm-desc-toggle:hover { color: var(--text-primary); }

  .cm-desc-toggle:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .cm-desc-toggle__chevron {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .cm-desc-toggle[aria-expanded="true"] .cm-desc-toggle__chevron {
    transform: rotate(180deg);
  }

  /* ── PRODUCTOS COMPLEMENTARIOS ── */
  .cm-comp-products {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--border-color);
  }

  .cm-comp__eyebrow {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 600;
    margin: 0 0 16px;
  }

  .cm-comp__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cm-comp__card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 10px;
  }

  .cm-comp__card-img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--bg-secondary);
    display: block;
  }

  .cm-comp__card-body {
    flex: 1;
    min-width: 0;
  }

  .cm-comp__card-name {
    font-family: var(--cm-font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.35;
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cm-comp__card-price {
    font-family: var(--cm-font-sans);
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
  }

  .cm-comp__atc-btn {
    flex-shrink: 0;
    background: var(--pdp-accent, var(--accent-gold));
    color: #fff;
    border: none;
    padding: 8px 14px;
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
    line-height: 1;
  }

  .cm-comp__atc-btn:hover:not(:disabled) {
    background: var(--text-primary);
  }

  .cm-comp__atc-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cm-comp__skeleton {
    height: 76px;
    background: linear-gradient(90deg, var(--bg-secondary) 25%, var(--border-color) 50%, var(--bg-secondary) 75%);
    background-size: 200% 100%;
    animation: cm-shimmer 1.5s infinite;
    border: 1px solid var(--border-color);
  }

  /* ── SECCIÓN COMBINA ── */
  .cm-combina-section {
    display: none;
    max-width: 1280px;
    margin: 56px auto 56px;
    padding: 40px 48px 48px;
    background: var(--bg-card);
    border-top: 3px solid var(--cm-gold);
    border-bottom: 3px solid var(--cm-gold);
    box-shadow: 0 4px 24px rgba(26,20,16,0.07);
  }

  .cm-combina-section.is-animating { display: block; }

  .cm-combina__title {
    font-size: 10px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    font-weight: 500;
    color: var(--cm-gold);
    margin-bottom: 28px;
  }

  .cm-combina__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .cm-combina__card {
    background: var(--cm-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(10,30,60,0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .cm-combina__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(10,30,60,0.12);
  }

  .cm-combina__card-link {
    display: block;
    text-decoration: none;
  }

  .cm-combina__card-img-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    background: linear-gradient(165deg, #f1f0ed 0%, #e6e4df 100%);
    overflow: hidden;
  }

  .cm-combina__card-img {
    position: absolute;
    inset: 12px;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease;
  }

  .cm-combina__card:hover .cm-combina__card-img { transform: scale(1.05); }

  .cm-combina__card-body {
    padding: 12px 14px 14px;
    background: var(--cm-navy);
  }

  .cm-combina__card-title {
    font-family: var(--cm-font-serif);
    font-size: 14px;
    color: var(--cm-white);
    font-weight: 400;
    line-height: 1.3;
    margin: 0 0 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;
    display: block;
  }

  .cm-combina__card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 10px;
  }

  .cm-combina__card-price {
    font-family: var(--cm-font-sans);
    font-size: 16px;
    font-weight: 500;
    color: var(--cm-white);
    margin: 0;
  }

  .cm-combina__card-plus {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--cm-gold);
    background: transparent;
    color: var(--cm-gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.2s ease;
  }

  .cm-combina__card-plus svg { width: 16px; height: 16px; display: block; }
  .cm-combina__card-plus:hover { background: var(--cm-gold); color: var(--cm-navy); }
  .cm-combina__card-plus:active { transform: scale(0.9); }
  .cm-combina__card-plus.is-added { background: #2a7a4b; border-color: #2a7a4b; color: var(--cm-white); }
  .cm-combina__card-plus[disabled] { opacity: 0.55; cursor: default; }

  @media (max-width: 900px) {
    .cm-combina-section { padding: 32px 24px 40px; margin: 40px auto 40px; }
  }

  @media (max-width: 600px) {
    .cm-combina__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }

  /* ── ACORDEONES ── */
  .cm-pdp__accordions {
    max-width: 1280px;
    margin: 56px auto 0;
    padding: 0 24px;
    border-top: 1px solid var(--border-color);
    background: var(--bg-primary);
  }

  .cm-accordion {
    border-bottom: 1px solid var(--border-color);
  }

  .cm-accordion__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
