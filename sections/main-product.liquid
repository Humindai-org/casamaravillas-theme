{% comment %}
  main-product.liquid — Sección de producto premium para Casa Maravillas
  Jamones, embutidos y productos ibéricos
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
{%- assign product_accent = '#00294B' -%}
{%- case product.type -%}
  {%- when 'Jamón' -%}           {%- assign product_accent = '#C4973A' -%}
  {%- when 'Carnes Ibéricas' -%} {%- assign product_accent = '#C05A38' -%}
  {%- when 'Embutidos' -%}       {%- assign product_accent = '#7A1F3C' -%}
  {%- when 'Packs & Regalos' -%} {%- assign product_accent = '#4A5B6B' -%}
{%- endcase -%}


{{ 'main-product.css' | asset_url | stylesheet_tag }}

{%- comment -%} Datos de variantes para JS {%- endcomment -%}
<script>
  (function() {
    try {
      const sectionId = '{{ section.id }}';
      const dataKey = 'cmPDP_' + sectionId;
      window[dataKey] = {
        variants: {{ product.variants | json }},
        moneyFormat: {{ shop.money_format | json }},
        tags: {{ product.tags | json }},
        productId: {{ product.id | json }},
        productHandle: {{ product.handle | json }},
        galFit: {{ section.settings.gallery_fit | default: 'contain' | json }},
        galZoomRaw: {{ section.settings.gallery_zoom | default: 100 | json }},
        galPosX: {{ section.settings.gallery_pos_x | default: 50 | json }},
        galPosY: {{ section.settings.gallery_pos_y | default: 50 | json }}
      };
      window.cmPDPSectionId = sectionId;
    } catch (e) {
      console.error('[PDP Data] Error assigning data:', e);
    }
  })();
</script>

{%- comment -%} ════════════════════════════════════ SECCIÓN PRINCIPAL ══ {%- endcomment -%}
<section
  id="cm-pdp-{{ section.id }}"
  class="cm-pdp"
  style="--pdp-accent: {{ product_accent }};"
  itemscope
  itemtype="https://schema.org/Product"
>

  {%- comment -%} ── GRID: GALERÍA + INFO ── {%- endcomment -%}
  <div class="cm-pdp__grid">

    {%- comment -%} ── COLUMNA IZQUIERDA: GALERÍA ── {%- endcomment -%}
    <div class="cm-pdp__gallery">

      {%- comment -%} Defaults de sección {%- endcomment -%}
      {%- assign gal_fit     = section.settings.gallery_fit   | default: 'contain' -%}
      {%- assign gal_zoom_raw = section.settings.gallery_zoom | default: 100 -%}
      {%- assign gal_pos_x   = section.settings.gallery_pos_x | default: 50 -%}
      {%- assign gal_pos_y   = section.settings.gallery_pos_y | default: 50 -%}

      {%- comment -%} Ajuste de imagen 1 desde el bloque 1 (si existe) {%- endcomment -%}
      {%- assign img1_fit   = gal_fit -%}
      {%- assign img1_zoom  = gal_zoom_raw | divided_by: 100.0 -%}
      {%- assign img1_pos_x = gal_pos_x -%}
      {%- assign img1_pos_y = gal_pos_y -%}
      {%- assign _adj_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'image_adjust' -%}
          {%- assign _adj_i = _adj_i | plus: 1 -%}
          {%- if _adj_i == 1 -%}
            {%- assign img1_fit   = block.settings.fit   | default: gal_fit -%}
            {%- assign img1_zoom  = block.settings.zoom  | default: gal_zoom_raw | divided_by: 100.0 -%}
            {%- assign img1_pos_x = block.settings.pos_x | default: gal_pos_x -%}
            {%- assign img1_pos_y = block.settings.pos_y | default: gal_pos_y -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="cm-pdp__main-img-wrap" style="--gal-fit:{{ img1_fit }};--gal-zoom:{{ img1_zoom }};--gal-pos-x:{{ img1_pos_x }}%;--gal-pos-y:{{ img1_pos_y }}%;">
        {%- if featured_image -%}
          <img
            id="cm-main-img-{{ section.id }}"
            class="cm-pdp__main-img"
            src="{{ featured_image | image_url: width: 900, format: 'webp' }}"
            alt="{{ featured_image.alt | escape | default: product.title }}"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
            loading="eager"
            itemprop="image"
          >
        {%- else -%}
          <div class="cm-pdp__main-img" style="background:var(--bg-secondary);"></div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="cm-pdp__thumbnails" role="list" aria-label="Miniaturas del producto">
          {%- for image in product.images limit: 8 -%}
            {%- comment -%} Buscar el bloque image_adjust correspondiente a esta imagen {%- endcomment -%}
            {%- assign _img_idx   = forloop.index -%}
            {%- assign _tbn_fit   = gal_fit -%}
            {%- assign _tbn_zoom  = gal_zoom_raw -%}
            {%- assign _tbn_pos_x = gal_pos_x -%}
            {%- assign _tbn_pos_y = gal_pos_y -%}
            {%- assign _tbn_block_id = '' -%}
            {%- assign _adj_j = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'image_adjust' -%}
                {%- assign _adj_j = _adj_j | plus: 1 -%}
                {%- if _adj_j == _img_idx -%}
                  {%- assign _tbn_fit      = block.settings.fit   | default: gal_fit -%}
                  {%- assign _tbn_zoom     = block.settings.zoom  | default: gal_zoom_raw -%}
                  {%- assign _tbn_pos_x    = block.settings.pos_x | default: gal_pos_x -%}
                  {%- assign _tbn_pos_y    = block.settings.pos_y | default: gal_pos_y -%}
                  {%- assign _tbn_block_id = block.id -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            <button
              class="cm-pdp__thumb-btn{% if forloop.first %} is-active{% endif %}"
              data-image-src="{{ image | image_url: width: 900, format: 'webp' }}"
              data-image-alt="{{ image.alt | escape | default: product.title }}"
              data-image-index="{{ forloop.index }}"
              data-block-id="{{ _tbn_block_id }}"
              data-img-fit="{{ _tbn_fit }}"
              data-img-zoom="{{ _tbn_zoom }}"
              data-img-pos-x="{{ _tbn_pos_x }}"
              data-img-pos-y="{{ _tbn_pos_y }}"
              aria-label="Ver imagen {{ forloop.index }}"
              role="listitem"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 120, format: 'webp' }}"
                alt="{{ image.alt | escape | default: product.title }}"
                width="76"
                height="76"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    {%- comment -%} fin galería {%- endcomment -%}

    {%- comment -%} ── COLUMNA DERECHA: INFO ── {%- endcomment -%}
    <div class="cm-pdp__info">

      {%- if product.type != blank or product.vendor != blank -%}
        <p class="cm-pdp__eyebrow">
          {{ product.vendor }}{% if product.vendor != blank and product.type != blank %} · {% endif %}{{ product.type }}
        </p>
      {%- endif -%}

      <h1 class="cm-pdp__title" itemprop="name">{{ product.title }}</h1>

      {%- comment -%} ── VALORACIONES ── {%- endcomment -%}
      {%- assign rev_rating = product.metafields.reviews.rating.value -%}
      {%- assign rev_count  = product.metafields.reviews.rating_count.value -%}
      {%- if rev_rating == blank -%}
        {%- assign rev_rating = product.metafields.judgeme.avg_rating -%}
        {%- assign rev_count  = product.metafields.judgeme.review_count -%}
      {%- endif -%}
      {%- if rev_rating != blank -%}
        {%- assign rating_rounded = rev_rating | round -%}
        <div class="cm-pdp__rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
          <meta itemprop="ratingValue" content="{{ rev_rating }}">
          <meta itemprop="reviewCount" content="{{ rev_count | default: 0 }}">
          <span class="cm-pdp__stars" aria-label="{{ rev_rating }} de 5 estrellas">
            {%- for i in (1..5) -%}
              {%- if i <= rating_rounded -%}
                <svg class="cm-star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- else -%}
                <svg class="cm-star cm-star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          {%- if rev_count != blank -%}
            <a href="#judgeme_product_reviews" class="cm-pdp__rating-count">{{ rev_count }} reseñas</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% render 'json-ld-product' %}

      {%- comment -%} ── TARJETAS DE DETALLES DEL PRODUCTO ── {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="cm-product-cards">
          {%- for block in section.blocks -%}
            {%- if block.type == 'detail_card' and block.settings.enabled -%}
              {%- assign icon_name = block.settings.card_icon | default: 'icon-raza.svg' -%}
              {%- assign field_type = block.settings.field_type | default: 'static' -%}
              {%- assign icon_type = block.settings.icon_type | default: 'static' -%}
              {%- assign static_value = block.settings.static_value -%}

              {%- comment -%} Obtener valor del producto según el tipo de campo {%- endcomment -%}
              {%- assign card_value = '' -%}
              {%- if field_type == 'raza' -%}
                {%- assign card_value = product.metafields.custom.breed.value | default: static_value -%}
              {%- elsif field_type == 'alimentacion' -%}
                {%- assign card_value = product.metafields.custom.feeding_type.value | default: static_value -%}
              {%- elsif field_type == 'origen' -%}
                {%- assign card_value = product.metafields.custom.origin.value | default: static_value -%}
              {%- elsif field_type == 'curacion' -%}
                {%- assign card_value = product.metafields.custom.tiempo_de_curacion.value | default: static_value -%}
              {%- elsif field_type == 'static' -%}
                {%- assign card_value = static_value -%}
              {%- endif -%}

              {%- comment -%} Determinar icono dinámico para alimentación {%- endcomment -%}
              {%- if icon_type == 'dynamic' and field_type == 'alimentacion' -%}
                {%- assign card_value_lower = card_value | downcase -%}
                {%- if card_value_lower contains 'bellota' -%}
                  {%- assign icon_name = 'icon-bellota.svg' -%}
                {%- elsif card_value_lower contains 'pasto' -%}
                  {%- assign icon_name = 'icon-pasto.svg' -%}
                {%- elsif card_value_lower contains 'cereales' -%}
                  {%- assign icon_name = 'icon-cereales.svg' -%}
                {%- else -%}
                  {%- assign icon_name = 'icon-cereales.svg' -%}
                {%- endif -%}
              {%- endif -%}

              {%- if card_value != blank -%}
                <div class="cm-product-card">
                  <div class="cm-product-card__icon"{% if field_type == 'alimentacion' %} data-icon-type="alimentacion"{% endif %}>
                    {%- render 'icon-selector', icon: icon_name, width: 80, height: 80, css_class: 'cm-product-card__icon-img' -%}
                  </div>
                  <div class="cm-product-card__label">{{ block.settings.label }}</div>
                  <div class="cm-product-card__value">{{ card_value }}</div>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ── PRECIO ── {%- endcomment -%}
      <div
        id="cm-price-wrap-{{ section.id }}"
        class="cm-pdp__price-row"
        itemprop="offers"
        itemscope
        itemtype="https://schema.org/Offer"
      >
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <meta itemprop="availability" content="{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price cm-pdp__price--sale"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
          <span id="cm-compare-price-{{ section.id }}" class="cm-pdp__price--compare">
            {{ current_variant.compare_at_price | money }}
          </span>
          <span id="cm-discount-badge-{{ section.id }}" class="cm-pdp__discount-badge">-{{ discount_pct }}%</span>
        {%- else -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} ── VOLUMEN DISCOUNT (solo para cortado a mano) ── {%- endcomment -%}
      <div id="cm-volume-discount-{{ section.id }}" class="cm-volume-discount" style="display: none;">
        <span class="cm-volume-discount__original" id="cm-volume-discount-original-{{ section.id }}"></span>
        <span class="cm-volume-discount__price" id="cm-volume-discount-price-{{ section.id }}"></span>
        <span class="cm-volume-discount__badge" id="cm-volume-discount-badge-{{ section.id }}"></span>
      </div>

      <p class="cm-pdp__tax-note">Impuestos añadidos &middot; <a href="/pages/envios" class="cm-pdp__shipping-link">Consulta nuestra política de envíos</a></p>

      {%- if product.metafields.custom.price_per_kg.value != blank -%}
        <p class="cm-pdp__price-kg">{{ product.metafields.custom.price_per_kg.value }}/kg</p>
      {%- endif -%}

      {%- comment -%} ── VARIANTES (Peso vinculado a Shopify) ── {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="cm-pdp__variants">
          {%- for option in product.options_with_values -%}
            <div class="cm-pdp__select-wrap">
              <label class="cm-pdp__select-label" for="cm-sel-{{ forloop.index }}-{{ section.id }}">
                {{ option.name }}
              </label>
              <select
                id="cm-sel-{{ forloop.index }}-{{ section.id }}"
                class="cm-pdp__select"
                data-option-index="{{ forloop.index }}"
                data-section="{{ section.id }}"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
              <span class="cm-pdp__select-arrow" aria-hidden="true">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%} ── SELECTOR DE PACK (Lonchado/Cortado a Mano) ── {%- endcomment -%}
      {%- if section.settings.pack_options != blank -%}
        <div class="cm-pdp__select-wrap" data-selector-type="cortado" style="display: none;">
          <label class="cm-pdp__select-label" for="cm-pack-sel-{{ section.id }}">Cortado a Mano - Pack</label>
          <select id="cm-pack-sel-{{ section.id }}" class="cm-pdp__select" data-pack-select>
            {%- assign pack_opts = section.settings.pack_options | split: ',' -%}
            {%- for opt in pack_opts -%}
              <option value="{{ opt | strip | escape }}">{{ opt | strip }}</option>
            {%- endfor -%}
          </select>
          <span class="cm-pdp__select-arrow" aria-hidden="true">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M19 9l-7 7-7-7"/>
            </svg>
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} ── SELECTOR DE CURACIÓN ── {%- endcomment -%}
      {%- if section.settings.show_curing_selector -%}
        <div class="cm-curing-selector" id="cm-curing-{{ section.id }}">
          <label class="cm-pdp__select-label" for="cm-curing-sel-{{ section.id }}">
            Punto de Curación
          </label>
          <div class="cm-pdp__select-wrap">
            <select id="cm-curing-sel-{{ section.id }}" class="cm-pdp__select" data-curing-select>
              <option value="tierno" data-desc="Textura suave, sabor delicado. Ideal para amantes de cortes más frescos.">Más tierno</option>
              <option value="equilibrado" selected data-desc="El punto perfecto entre textura y sabor. Nuestra selección recomendada.">Equilibrado</option>
              <option value="curado" data-desc="Sabor intenso y concentrado. Mayor tiempo de maduración.">Más curado</option>
            </select>
            <span class="cm-pdp__select-arrow" aria-hidden="true">
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </div>
          <p class="option-hint" id="cm-curing-hint-{{ section.id }}">El punto perfecto entre textura y sabor. Nuestra selección recomendada.</p>
        </div>
      {%- endif -%}

      {%- comment -%} ── FORMULARIO DE COMPRA ── {%- endcomment -%}
      {%- assign product_form_id = 'cm-form-' | append: section.id -%}
      {%- form 'product', product, id: product_form_id, novalidate: true -%}
        <input type="hidden" name="id" id="cm-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

        <div class="cm-pdp__purchase">
          <div class="cm-qty" role="group" aria-label="Selector de cantidad">
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-minus-{{ section.id }}"
              aria-label="Reducir cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M5 12h14"/>
              </svg>
            </button>
            <input
              type="number"
              id="cm-qty-{{ section.id }}"
              name="quantity"
              min="1"
              value="1"
              class="cm-qty__input"
              aria-label="Cantidad"
            >
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-plus-{{ section.id }}"
              aria-label="Aumentar cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
          </div>

          <button
            type="submit"
            name="add"
            id="cm-add-{{ section.id }}"
            class="cm-pdp__add-btn"
            {%- unless current_variant.available -%}disabled{%- endunless -%}
            aria-label="Añadir {{ product.title | escape }} a la cesta"
          >
            {%- if current_variant.available -%}
              <span id="cm-add-text-{{ section.id }}">Añadir a la cesta</span>
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
              </svg>
            {%- else -%}
              <span id="cm-add-text-{{ section.id }}">Agotado</span>
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} ── LISTA DE DESEOS ── {%- endcomment -%}
      <button
        type="button"
        class="cm-wishlist-btn"
        id="cm-wishlist-{{ section.id }}"
        aria-label="Añadir a la lista de deseos"
        aria-pressed="false"
      >
        <svg viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.6a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.07a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
        <span class="cm-wishlist-text">Añadir a la lista de deseos</span>
      </button>

      {%- comment -%} ── PRODUCTOS COMPLEMENTARIOS ── {%- endcomment -%}
      {%- if section.settings.show_complementary_products -%}
        <div
          class="cm-comp-products"
          id="cm-comp-{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-max="{{ section.settings.complementary_max | default: 3 }}"
          {%- if section.settings.complementary_collection != blank -%}
            data-fallback="{{ section.settings.complementary_collection }}"
          {%- endif -%}
        >
          <p class="cm-comp__eyebrow">
            {{- section.settings.complementary_title | default: 'Complementa tu pedido con' -}}
          </p>
          <div class="cm-comp__list" id="cm-comp-list-{{ section.id }}">
            {%- for i in (1..3) -%}
              <div class="cm-comp__skeleton"></div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ── DESCRIPCIÓN CORTA ── {%- endcomment -%}
      {%- if product.description != blank -%}
        <div class="cm-pdp__desc" id="cm-desc-{{ section.id }}">
          <div class="cm-pdp__desc-preview" id="cm-desc-preview-{{ section.id }}">
            {{ product.description }}
          </div>
        </div>
      {%- endif -%}

    </div>
    {%- comment -%} fin info {%- endcomment -%}

  </div>
  {%- comment -%} fin grid {%- endcomment -%}

</section>

{%- comment -%} ════════════════════════════════════ COMBINA (oculta por defecto) ══ {%- endcomment -%}
{%- liquid
  assign current_family = template.suffix
  assign all_families   = 'jamones,embutidos,carnes-ibericas,packs-regalo' | split: ','
  assign shown_handles  = product.handle | append: ','
  assign shown_count    = 0
-%}
<div class="cm-combina-section" id="cm-combina-section">
  <p class="cm-combina__title">Combina tu compra con</p>
  <div class="cm-combina__grid">

    {%- comment -%} PASADA 1: 1 producto de cada familia complementaria {%- endcomment -%}
    {%- for family in all_families -%}
      {%- if family != current_family and shown_count < 3 -%}
        {%- assign fam_col = collections[family] -%}
        {%- if fam_col != blank -%}
          {%- for cp in fam_col.products limit: 1 -%}
            {%- unless shown_handles contains cp.handle -%}
              {%- assign cp_variant = cp.first_available_variant | default: cp.variants.first -%}
              {% render 'combina-card', cp: cp, cp_variant: cp_variant %}
              {%- assign shown_count = shown_count | plus: 1 -%}
              {%- assign shown_handles = shown_handles | append: cp.handle | append: ',' -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} PASADA 2: si quedan huecos, rellenar con más productos de familias disponibles {%- endcomment -%}
    {%- if shown_count < 3 -%}
      {%- for family in all_families -%}
        {%- if family != current_family -%}
          {%- assign fam_col = collections[family] -%}
          {%- if fam_col != blank -%}
            {%- for cp in fam_col.products limit: 5 -%}
              {%- if shown_count >= 3 -%}{%- break -%}{%- endif -%}
              {%- unless shown_handles contains cp.handle -%}
                {%- assign cp_variant = cp.first_available_variant | default: cp.variants.first -%}
                {% render 'combina-card', cp: cp, cp_variant: cp_variant %}
                {%- assign shown_count = shown_count | plus: 1 -%}
                {%- assign shown_handles = shown_handles | append: cp.handle | append: ',' -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

  </div>
</div>

{%- comment -%} ════════════════════════════════════ STICKY ATC ══ {%- endcomment -%}
{%- if section.settings.show_sticky_atc -%}
  <div
    class="cm-sticky-atc"
    id="cm-sticky-atc-{{ section.id }}"
    aria-hidden="true"
    aria-label="Compra rápida"
  >
    <div class="cm-sticky-atc__inner">
      <div class="cm-sticky-atc__product">
        {%- if product.featured_image -%}
          <img
            class="cm-sticky-atc__img"
            src="{{ product.featured_image | image_url: width: 100, format: 'webp' }}"
            alt="{{ product.title | escape }}"
            width="44"
            height="44"
            loading="lazy"
          >
        {%- endif -%}
        <div>
          <span class="cm-sticky-atc__name">{{ product.title | truncate: 45 }}</span>
          <span class="cm-sticky-atc__price" id="cm-sticky-price-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
        </div>
      </div>
      <div class="cm-sticky-atc__right">
        <div class="cm-sticky-qty" role="group" aria-label="Cantidad">
          <button type="button" class="cm-sticky-qty__btn" id="cm-sticky-qty-minus-{{ section.id }}" aria-label="Reducir cantidad">−</button>
          <input type="number" class="cm-sticky-qty__val" id="cm-sticky-qty-val-{{ section.id }}" min="1" value="1" aria-label="Cantidad">
          <button type="button" class="cm-sticky-qty__btn" id="cm-sticky-qty-plus-{{ section.id }}" aria-label="Aumentar cantidad">+</button>
        </div>
        <button
          type="button"
          class="cm-sticky-atc__btn"
          id="cm-sticky-btn-{{ section.id }}"
          {%- unless current_variant.available -%}disabled{%- endunless -%}
          aria-label="Añadir a la cesta"
        >
          {%- if current_variant.available -%}Añadir a la cesta{%- else -%}Agotado{%- endif -%}
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ════════════════════════════════════ JAVASCRIPT ══ {%- endcomment -%}
<script src="{{ 'main-product.js' | asset_url }}" defer></script>

{% schema %}
