{% comment %}
  main-product.liquid — Sección de producto premium para Casa Maravillas
  Jamones, embutidos y productos ibéricos
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
{%- assign product_accent = '#00294B' -%}
{%- case product.type -%}
  {%- when 'Jamón' -%}           {%- assign product_accent = '#C4973A' -%}
  {%- when 'Carnes Ibéricas' -%} {%- assign product_accent = '#C05A38' -%}
  {%- when 'Embutidos' -%}       {%- assign product_accent = '#7A1F3C' -%}
  {%- when 'Packs & Regalos' -%} {%- assign product_accent = '#4A5B6B' -%}
{%- endcase -%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">

<style>
  /* ── VARIABLES DE COLOR — paleta crema clara ── */
  :root {
    --bg-primary:   #F5F0E8;
    --bg-secondary: #EDEAE2;
    --bg-card:      #FFFFFF;
    --text-primary: #1A1410;
    --text-secondary: #6B5E4E;
    --accent-gold:  #C9A84C;
    --border-color: #D6CFC4;
    --sticky-bg:    #1A1410;
  }

  /* ── LAYOUT PRINCIPAL ── */
.cm-pdp {
  --pdp-accent: {{ product_accent }};
  width: 100%;
  padding: 56px 48px 80px;
  background: var(--bg-primary);
  box-sizing: border-box;
}

.cm-pdp__grid {
  max-width: 1280px;
  margin: 0 auto;
}

  .cm-pdp__grid {
    display: grid;
    grid-template-columns: 55% 45%;
    gap: 64px;
    align-items: start;
  }

  /* ── GALERÍA ── */
  .cm-pdp__gallery {
    position: sticky;
    top: 100px;
  }

  .cm-pdp__gallery-inner {
    display: flex;
    gap: 14px;
    align-items: stretch;
  }

  .cm-pdp__main-img-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-secondary);
    position: relative;
  }

  .cm-pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }

  .cm-pdp__main-img.is-loading { opacity: 0; }

  /* Thumbnails */
  .cm-pdp__thumbnails {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    max-height: 100px;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) transparent;
    padding-bottom: 4px;
  }

  .cm-pdp__thumbnails::-webkit-scrollbar { height: 4px; }
  .cm-pdp__thumbnails::-webkit-scrollbar-track { background: transparent; }
  .cm-pdp__thumbnails::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 2px; }

  .cm-pdp__thumb-btn {
    flex-shrink: 0;
    width: 76px;
    height: 76px;
    border: 2px solid var(--border-color);
    background: var(--bg-card);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .cm-pdp__thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cm-pdp__thumb-btn.is-active { border-color: var(--accent-gold); }
  .cm-pdp__thumb-btn:hover:not(.is-active) { border-color: var(--text-secondary); }
  .cm-pdp__thumb-btn:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }

  /* ── INFO ── */
  .cm-pdp__eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .cm-pdp__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(28px, 3vw, 42px);
    color: var(--text-primary);
    line-height: 1.15;
    margin-bottom: 20px;
    font-weight: 400;
  }

  /* ── BARRA DE HECHOS RÁPIDOS ── */
  .cm-pdp__facts {
    display: flex;
    gap: 0;
    border: 1px solid var(--border-color);
    margin-bottom: 28px;
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--bg-card);
    border-radius: 4px;
  }

  .cm-pdp__facts::-webkit-scrollbar { display: none; }

  .cm-fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 14px 12px;
    flex: 1;
    min-width: 80px;
    max-width: 140px;
    border-right: 1px solid var(--border-color);
    text-align: center;
  }

  .cm-fact:last-child { border-right: none; }

  .cm-fact__icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    font-size: 22px;
    display: flex;
    justify-content: center;
  }

  .cm-fact__label {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    display: block;
    line-height: 1;
  }

  .cm-fact__value {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
    display: block;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  /* ── PRECIO ── */
  .cm-pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .cm-pdp__price {
    font-size: 28px;
    font-weight: 400;
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
  }

  .cm-pdp__price--sale { color: #8B1A1A; }

  .cm-pdp__price--compare {
    font-size: 17px;
    color: var(--text-secondary);
    text-decoration: line-through;
  }

  .cm-pdp__discount-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    background: #8B1A1A;
    color: #fff;
    padding: 3px 8px;
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  .cm-pdp__price-kg {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 24px;
  }

  /* ── VARIANTES (select dropdown) ── */
  .cm-pdp__variants { margin-bottom: 24px; }

  .cm-pdp__select-wrap {
    position: relative;
    margin-bottom: 16px;
  }

  .cm-pdp__select-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 10px;
    display: block;
  }

  .cm-pdp__select {
    width: 100%;
    padding: 14px 44px 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
    font-size: 14px;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .cm-pdp__select:hover { border-color: var(--text-primary); }
  .cm-pdp__select:focus { outline: 2px solid var(--accent-gold); outline-offset: 0; }

  .cm-pdp__select-arrow {
    position: absolute;
    right: 14px;
    bottom: 16px;
    pointer-events: none;
    color: var(--accent-gold);
    display: flex;
  }

  /* Nota de impuestos */
  .cm-pdp__tax-note {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin-bottom: 20px;
  }

  /* ── SELECTOR DE CURACIÓN ── */
  .cm-curing-selector { margin-bottom: 24px; }

  .option-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    margin: 0 0 8px;
    display: block;
  }

  .option-buttons { display: flex; gap: 8px; flex-wrap: wrap; margin: 0 0 8px; }

  .option-btn {
    padding: 10px 18px;
    border: 1.5px solid var(--border-color);
    background: var(--bg-card);
    color: var(--text-primary);
    font-family: var(--cm-font-sans);
    font-size: 13px;
    cursor: pointer;
    border-radius: 4px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .option-btn:hover { border-color: var(--accent-gold); }

  .option-btn.active {
    border-color: var(--accent-gold);
    background: var(--accent-gold);
    color: #1A1410;
    font-weight: 600;
  }

  .option-hint {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    font-style: italic;
    margin: 0;
    min-height: 18px;
  }

  /* ── COMPRA ── */
  .cm-pdp__purchase {
    display: flex;
    gap: 10px;
    align-items: stretch;
    margin-bottom: 24px;
  }

  .cm-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--border-color);
    flex-shrink: 0;
    background: var(--bg-card);
  }

  .cm-qty__btn {
    width: 44px;
    height: 52px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    font-family: var(--cm-font-sans);
  }

  .cm-qty__btn:hover { background: var(--bg-secondary); }

  .cm-qty__btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .cm-qty__input {
    width: 44px;
    height: 52px;
    border: none;
    border-left: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
    text-align: center;
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: var(--text-primary);
    background: transparent;
    -moz-appearance: textfield;
  }

  .cm-qty__input::-webkit-outer-spin-button,
  .cm-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .cm-pdp__add-btn {
    flex: 1;
    height: 52px;
    background: var(--accent-gold);
    color: #1A1410;
    border: 1px solid var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.18em;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }

  .cm-pdp__add-btn:hover:not(:disabled) {
    background: transparent;
    color: var(--accent-gold);
  }

  .cm-pdp__add-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .cm-pdp__add-btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  /* ── DESCRIPCIÓN CORTA ── */
  .cm-pdp__desc { margin-bottom: 24px; }

  .cm-pdp__desc-preview {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    transition: opacity 0.3s;
  }

  .cm-pdp__desc-full {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.4s ease;
    opacity: 0;
  }

  .cm-pdp__desc-full.is-open {
    max-height: 1200px !important;
    opacity: 1 !important;
  }

  .cm-pdp__desc-full.is-open + .cm-pdp__desc-preview { display: none; }

  .cm-desc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-top: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .cm-desc-toggle:hover { color: var(--text-primary); }

  .cm-desc-toggle:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .cm-desc-toggle__chevron {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .cm-desc-toggle[aria-expanded="true"] .cm-desc-toggle__chevron {
    transform: rotate(180deg);
  }

  /* ── TRUST BADGES ── */
  .cm-pdp__trust {
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 16px 24px;
  }

  .cm-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    white-space: nowrap;
  }

  .cm-trust-item__icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    display: flex;
  }

  /* ── SECCIÓN COMBINA ── */
  .cm-combina-section {
    display: none;
    max-width: 1280px;
    margin: 48px auto 0;
    padding: 40px 24px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    box-shadow: 0 4px 24px rgba(26,20,16,0.07);
  }

  .cm-combina-section.is-animating { display: block; }

  .cm-combina__title {
    font-family: var(--cm-font-serif);
    font-size: 24px;
    color: var(--text-primary);
    font-weight: 400;
    margin-bottom: 24px;
  }

  /* ── ACORDEONES ── */
  .cm-pdp__accordions {
    max-width: 1280px;
    margin: 64px auto 0;
    padding: 0 24px;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
    padding-top: 0;
  }

  .cm-accordion {
    border-bottom: 1px solid var(--border-color);
  }

  .cm-accordion__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--cm-font-sans);
    gap: 16px;
  }

  .cm-accordion__trigger:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .cm-accordion__trigger-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cm-accordion__trigger-icon {
    color: var(--accent-gold);
    flex-shrink: 0;
    display: flex;
    font-size: 20px;
  }

  .cm-accordion__trigger-title {
    font-family: var(--cm-font-serif);
    font-size: 18px;
    color: var(--text-primary);
    font-weight: 400;
  }

  .cm-accordion__chevron {
    flex-shrink: 0;
    color: var(--text-secondary);
    transition: transform 0.35s ease;
  }

  .cm-accordion__trigger[aria-expanded="true"] .cm-accordion__chevron {
    transform: rotate(180deg);
  }

  .cm-accordion__trigger[aria-expanded="true"] .cm-accordion__trigger-title {
    color: var(--accent-gold);
  }

  .cm-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease;
  }

  .cm-accordion__body {
    padding: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cm-accordion-block__title {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .cm-accordion-block p,
  .cm-accordion-block div {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    font-family: var(--cm-font-sans);
  }

  .cm-accordion-block__empty {
    font-size: 13px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    font-style: italic;
    padding: 4px 0 12px;
  }

  /* Tabla nutricional */
  .cm-nutritional-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    font-family: var(--cm-font-sans);
  }

  .cm-nutritional-table th,
  .cm-nutritional-table td {
    padding: 9px 12px;
    text-align: left;
    border-bottom: 1px solid var(--cm-border);
    color: var(--cm-text-mid);
  }

  .cm-nutritional-table th {
    font-weight: 500;
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  /* Lista de origen */
  .cm-origin-list { display: flex; flex-direction: column; gap: 0; }

  .cm-origin-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    padding: 11px 0;
    border-bottom: 1px solid var(--cm-border);
    gap: 16px;
    align-items: baseline;
  }

  .cm-origin-item:last-child { border-bottom: none; }

  .cm-origin-item dt {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  .cm-origin-item dd {
    font-size: 14px;
    color: var(--cm-text-mid);
    font-family: var(--cm-font-sans);
  }

  /* Grid de notas de cata */
  .cm-cata-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cm-cata-item {
    padding: 24px;
    background: var(--cm-off);
    text-align: center;
  }

  .cm-cata-item__icon {
    color: var(--cm-gold);
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  .cm-cata-item h4 {
    font-family: var(--cm-font-serif);
    font-size: 16px;
    color: var(--text-primary);
    font-weight: 400;
    margin-bottom: 8px;
  }

  .cm-cata-item p {
    font-size: 13px;
    color: var(--cm-text-mid);
    line-height: 1.7;
    font-family: var(--cm-font-sans);
  }

  /* ── STICKY ATC ── */
  .cm-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
    pointer-events: none;
    background: var(--sticky-bg);
    border-top: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 -8px 32px rgba(0,0,0,0.25);
  }

  .cm-sticky-atc.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .cm-sticky-atc__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cm-sticky-atc__product {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    flex: 1;
  }

  .cm-sticky-atc__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .cm-sticky-qty {
    display: flex;
    align-items: center;
    border: 1px solid rgba(255,255,255,0.2);
    height: 46px;
  }

  .cm-sticky-qty__btn {
    width: 38px;
    height: 100%;
    background: none;
    border: none;
    cursor: pointer;
    color: #F5EDDA;
    font-size: 18px;
    font-family: var(--cm-font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .cm-sticky-qty__btn:hover { background: rgba(255,255,255,0.08); }

  .cm-sticky-qty__btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .cm-sticky-qty__val {
    width: 36px;
    text-align: center;
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: #F5EDDA;
    border-left: 1px solid rgba(255,255,255,0.2);
    border-right: 1px solid rgba(255,255,255,0.2);
    line-height: 46px;
    display: block;
    flex-shrink: 0;
  }

  .cm-sticky-atc__img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .cm-sticky-atc__name {
    font-family: var(--cm-font-serif);
    font-size: 16px;
    color: #F5EDDA;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .cm-sticky-atc__price {
    font-size: 14px;
    font-weight: 500;
    color: #F5EDDA;
    font-family: var(--cm-font-sans);
    display: block;
  }

  .cm-sticky-atc__btn {
    flex-shrink: 0;
    height: 46px;
    padding: 0 32px;
    background: var(--accent-gold);
    color: #1A1410;
    border: 1px solid var(--accent-gold);
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .cm-sticky-atc__btn:hover:not(:disabled) {
    background: transparent;
    color: var(--accent-gold);
  }

  .cm-sticky-atc__btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .cm-sticky-atc__btn:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  /* ── VALORACIONES ── */
  .cm-pdp__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .cm-pdp__stars { display: flex; gap: 2px; align-items: center; }
  .cm-star { width: 16px; height: 16px; color: var(--accent-gold); flex-shrink: 0; }
  .cm-star--empty { color: var(--border-color); }
  .cm-pdp__rating-count {
    font-size: 12px;
    color: var(--text-secondary);
    font-family: var(--cm-font-sans);
    text-decoration: none;
  }
  a.cm-pdp__rating-count:hover { color: var(--accent-gold); }

  /* ── SCROLL REVEAL ── */
  .cm-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .cm-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Tabla nutricional ── */
  .cm-nutritional-table th,
  .cm-nutritional-table td  { border-bottom-color: var(--border-color); color: var(--text-secondary); }
  .cm-nutritional-table th  { background: var(--bg-secondary); color: var(--text-primary); }

  /* ── Lista de origen ── */
  .cm-origin-item    { border-bottom-color: var(--border-color); }
  .cm-origin-item dt { color: var(--text-secondary); }
  .cm-origin-item dd { color: var(--text-primary); }

  /* ── Notas de cata ── */
  .cm-cata-item    { background: var(--bg-secondary); }
  .cm-cata-item h4 { color: var(--text-primary); }
  .cm-cata-item p  { color: var(--text-secondary); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .cm-pdp__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .cm-pdp__gallery { position: static; }
    .cm-pdp { padding: 32px 20px 64px; }
    .cm-cata-grid { grid-template-columns: 1fr; gap: 16px; }
    .cm-pdp__facts { overflow-x: auto; }
    .cm-fact { min-width: 90px; }
  }

  @media (max-width: 600px) {
    .cm-pdp__purchase { flex-direction: column; }
    .cm-qty { width: 100%; justify-content: space-between; }
    .cm-pdp__add-btn { width: 100%; }
    .cm-origin-item { grid-template-columns: 1fr; gap: 4px; }
    .cm-sticky-atc__product { display: none; }
    .cm-sticky-qty { display: none; }
    .cm-sticky-atc__btn { width: 100%; }
    .cm-sticky-atc__inner { padding: 12px 20px; }
    .cm-pdp__accordions { padding: 0 20px; }
    .option-buttons { flex-direction: column; }
    .option-btn { width: 100%; text-align: center; }
  }
</style>

{%- comment -%} Datos de variantes para JS {%- endcomment -%}
<script>
  window.cmPDP_{{ section.id }} = {
    variants: {{ product.variants | json }},
    moneyFormat: {{ shop.money_format | json }}
  };
</script>

{%- comment -%} ════════════════════════════════════ SECCIÓN PRINCIPAL ══ {%- endcomment -%}
<section
  id="cm-pdp-{{ section.id }}"
  class="cm-pdp"
  itemscope
  itemtype="https://schema.org/Product"
>

  {%- comment -%} ── GRID: GALERÍA + INFO ── {%- endcomment -%}
  <div class="cm-pdp__grid">

    {%- comment -%} ── COLUMNA IZQUIERDA: GALERÍA ── {%- endcomment -%}
    <div class="cm-pdp__gallery">

      <div class="cm-pdp__main-img-wrap">
        {%- if featured_image -%}
          <img
            id="cm-main-img-{{ section.id }}"
            class="cm-pdp__main-img"
            src="{{ featured_image | image_url: width: 900 }}"
            alt="{{ featured_image.alt | escape | default: product.title }}"
            width="{{ featured_image.width }}"
            height="{{ featured_image.height }}"
            loading="eager"
            itemprop="image"
          >
        {%- else -%}
          <div class="cm-pdp__main-img" style="background:var(--bg-secondary);"></div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="cm-pdp__thumbnails" role="list" aria-label="Miniaturas del producto">
          {%- for image in product.images limit: 8 -%}
            <button
              class="cm-pdp__thumb-btn{% if forloop.first %} is-active{% endif %}"
              data-image-src="{{ image | image_url: width: 900 }}"
              data-image-alt="{{ image.alt | escape | default: product.title }}"
              aria-label="Ver imagen {{ forloop.index }}"
              role="listitem"
              type="button"
            >
              <img
                src="{{ image | image_url: width: 120 }}"
                alt="{{ image.alt | escape | default: product.title }}"
                width="76"
                height="76"
                loading="lazy"
              >
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    {%- comment -%} fin galería {%- endcomment -%}

    {%- comment -%} ── COLUMNA DERECHA: INFO ── {%- endcomment -%}
    <div class="cm-pdp__info">

      {%- if product.type != blank or product.vendor != blank -%}
        <p class="cm-pdp__eyebrow">
          {{ product.vendor }}{% if product.vendor != blank and product.type != blank %} · {% endif %}{{ product.type }}
        </p>
      {%- endif -%}

      <h1 class="cm-pdp__title" itemprop="name">{{ product.title }}</h1>

      {%- comment -%} ── VALORACIONES ── {%- endcomment -%}
      {%- assign rev_rating = product.metafields.reviews.rating.value -%}
      {%- assign rev_count  = product.metafields.reviews.rating_count.value -%}
      {%- if rev_rating != blank -%}
        {%- assign rating_rounded = rev_rating | round -%}
        <div class="cm-pdp__rating" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
          <meta itemprop="ratingValue" content="{{ rev_rating }}">
          <meta itemprop="reviewCount" content="{{ rev_count | default: 0 }}">
          <span class="cm-pdp__stars" aria-label="{{ rev_rating }} de 5 estrellas">
            {%- for i in (1..5) -%}
              {%- if i <= rating_rounded -%}
                <svg class="cm-star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- else -%}
                <svg class="cm-star cm-star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          {%- if rev_count != blank -%}
            <a href="#reviews" class="cm-pdp__rating-count">({{ rev_count }} valoraciones)</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ── BARRA DE HECHOS RÁPIDOS ── {%- endcomment -%}
      {%- if section.settings.show_quick_facts -%}
        {%- assign mf_curing  = product.metafields.custom.curing_time.value -%}
        {%- assign mf_breed   = product.metafields.custom.breed.value -%}
        {%- assign mf_feeding = product.metafields.custom.feeding_type.value -%}
        {%- assign mf_origin  = product.metafields.custom.origin.value -%}
        {%- assign mf_weight  = product.metafields.custom.weight_info.value -%}
        {%- if mf_curing or mf_breed or mf_feeding or mf_origin or mf_weight -%}
          <div class="cm-pdp__facts" aria-label="Características principales del producto">

            {%- if mf_curing != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <i class="ti ti-calendar"></i>
                </span>
                <div>
                  <span class="cm-fact__label">Curación</span>
                  <span class="cm-fact__value">{{ mf_curing }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_breed != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <i class="ti ti-paw"></i>
                </span>
                <div>
                  <span class="cm-fact__label">Raza</span>
                  <span class="cm-fact__value">{{ mf_breed }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_feeding != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <i class="ti ti-leaf"></i>
                </span>
                <div>
                  <span class="cm-fact__label">Alimentación</span>
                  <span class="cm-fact__value">{{ mf_feeding }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_origin != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <i class="ti ti-map-pin"></i>
                </span>
                <div>
                  <span class="cm-fact__label">Origen</span>
                  <span class="cm-fact__value">{{ mf_origin }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_weight != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <i class="ti ti-weight"></i>
                </span>
                <div>
                  <span class="cm-fact__label">Peso</span>
                  <span class="cm-fact__value">{{ mf_weight }}</span>
                </div>
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ── PRECIO ── {%- endcomment -%}
      <div
        id="cm-price-wrap-{{ section.id }}"
        class="cm-pdp__price-row"
        itemprop="offers"
        itemscope
        itemtype="https://schema.org/Offer"
      >
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <meta itemprop="availability" content="{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price cm-pdp__price--sale"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
          <span id="cm-compare-price-{{ section.id }}" class="cm-pdp__price--compare">
            {{ current_variant.compare_at_price | money }}
          </span>
          <span id="cm-discount-badge-{{ section.id }}" class="cm-pdp__discount-badge">-{{ discount_pct }}%</span>
        {%- else -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <p class="cm-pdp__tax-note">Impuestos incluidos</p>

      {%- if product.metafields.custom.price_per_kg.value != blank -%}
        <p class="cm-pdp__price-kg">{{ product.metafields.custom.price_per_kg.value }}/kg</p>
      {%- endif -%}

      {%- comment -%} ── VARIANTES ── {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="cm-pdp__variants">
          {%- for option in product.options_with_values -%}
            <div class="cm-pdp__select-wrap">
              <label class="cm-pdp__select-label" for="cm-sel-{{ forloop.index }}-{{ section.id }}">
                {{ option.name }}
              </label>
              <select
                id="cm-sel-{{ forloop.index }}-{{ section.id }}"
                class="cm-pdp__select"
                data-option-index="{{ forloop.index }}"
                data-section="{{ section.id }}"
              >
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
              <span class="cm-pdp__select-arrow" aria-hidden="true">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <path d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%} ── SELECTOR DE PESO APROXIMADO (configurable en Shopify) ── {%- endcomment -%}
      {%- if section.settings.show_weight_selector and section.settings.weight_options != blank -%}
        <div class="cm-pdp__select-wrap">
          <label class="cm-pdp__select-label" for="cm-weight-sel-{{ section.id }}">
            Peso Aproximado
          </label>
          <select id="cm-weight-sel-{{ section.id }}" class="cm-pdp__select" data-weight-select>
            {%- assign weight_opts = section.settings.weight_options | split: ',' -%}
            {%- for opt in weight_opts -%}
              <option value="{{ opt | strip | escape }}">{{ opt | strip }}</option>
            {%- endfor -%}
          </select>
          <span class="cm-pdp__select-arrow" aria-hidden="true">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M19 9l-7 7-7-7"/>
            </svg>
          </span>
        </div>
      {%- endif -%}

      {%- comment -%} ── SELECTOR DE CURACIÓN ── {%- endcomment -%}
      <div class="cm-curing-selector" id="cm-curing-{{ section.id }}">
        <label class="cm-pdp__select-label" for="cm-curing-sel-{{ section.id }}">
          Punto de Curación
        </label>
        <div class="cm-pdp__select-wrap">
          <select id="cm-curing-sel-{{ section.id }}" class="cm-pdp__select" data-curing-select>
            <option value="tierno" data-desc="Textura suave, sabor delicado. Ideal para amantes de cortes más frescos.">Más tierno</option>
            <option value="equilibrado" selected data-desc="El punto perfecto entre textura y sabor. Nuestra selección recomendada.">Equilibrado</option>
            <option value="curado" data-desc="Sabor intenso y concentrado. Mayor tiempo de maduración.">Más curado</option>
          </select>
          <span class="cm-pdp__select-arrow" aria-hidden="true">
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M19 9l-7 7-7-7"/>
            </svg>
          </span>
        </div>
        <p class="option-hint" id="cm-curing-hint-{{ section.id }}">El punto perfecto entre textura y sabor. Nuestra selección recomendada.</p>
      </div>

      {%- comment -%} ── FORMULARIO DE COMPRA ── {%- endcomment -%}
      {%- assign product_form_id = 'cm-form-' | append: section.id -%}
      {%- form 'product', product, id: product_form_id, novalidate: true -%}
        <input type="hidden" name="id" id="cm-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

        <div class="cm-pdp__purchase">
          <div class="cm-qty" role="group" aria-label="Selector de cantidad">
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-minus-{{ section.id }}"
              aria-label="Reducir cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M5 12h14"/>
              </svg>
            </button>
            <input
              type="number"
              id="cm-qty-{{ section.id }}"
              name="quantity"
              min="1"
              value="1"
              class="cm-qty__input"
              aria-label="Cantidad"
            >
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-plus-{{ section.id }}"
              aria-label="Aumentar cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
          </div>

          <button
            type="submit"
            name="add"
            id="cm-add-{{ section.id }}"
            class="cm-pdp__add-btn"
            {%- unless current_variant.available -%}disabled{%- endunless -%}
            aria-label="Añadir {{ product.title | escape }} a la cesta"
          >
            {%- if current_variant.available -%}
              <span id="cm-add-text-{{ section.id }}">Añadir a la cesta</span>
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
              </svg>
            {%- else -%}
              <span id="cm-add-text-{{ section.id }}">Agotado</span>
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} ── DESCRIPCIÓN CORTA ── {%- endcomment -%}
      {%- if product.description != blank -%}
        {%- assign desc_text = product.description | strip_html -%}
        <div class="cm-pdp__desc" id="cm-desc-{{ section.id }}">
          {%- if desc_text.size > 180 -%}
            <div class="cm-pdp__desc-full" id="cm-desc-full-{{ section.id }}" aria-hidden="true">
              {{ product.description }}
            </div>
            <p class="cm-pdp__desc-preview" id="cm-desc-preview-{{ section.id }}">
              {{ desc_text | truncate: 280 }}
            </p>
            <button
              class="cm-desc-toggle"
              id="cm-desc-toggle-{{ section.id }}"
              aria-expanded="false"
              aria-controls="cm-desc-full-{{ section.id }}"
              type="button"
            >
              <span class="cm-desc-toggle__more">Leer más</span>
              <span class="cm-desc-toggle__less" style="display:none">Leer menos</span>
              <svg class="cm-desc-toggle__chevron" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          {%- else -%}
            <div class="cm-pdp__desc-preview">{{ product.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ── TRUST BADGES ── {%- endcomment -%}
      {%- if section.settings.show_trust_badges -%}
        <div class="cm-pdp__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="cm-trust-item" {{ block.shopify_attributes }}>
                <span class="cm-trust-item__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
                      </svg>
                    {%- when 'leaf' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3C7 3 4 7 4 11c0 5 4 8 8 9 4-1 8-4 8-9 0-4-3-8-8-8z"/>
                        <path d="M12 21V12M8 15l4-3 4 3"/>
                      </svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    {%- comment -%} fin info {%- endcomment -%}

  </div>
  {%- comment -%} fin grid {%- endcomment -%}

  {%- comment -%} ════════════════════════════════════ ACORDEONES (bloques) ══ {%- endcomment -%}
  {%- assign accordion_blocks = section.blocks | where: 'type', 'accordion' -%}
  {%- if accordion_blocks.size > 0 -%}
  <div class="cm-pdp__accordions" id="cm-accordions-{{ section.id }}" aria-label="Información detallada del producto">

    {%- for block in section.blocks -%}
      {%- if block.type != 'accordion' -%}{%- continue -%}{%- endif -%}

      {%- comment -%} Leer metadato dinámicamente por clave {%- endcomment -%}
      {%- assign acc_mf_key = block.settings.metafield_key -%}
      {%- assign acc_mf_val = blank -%}
      {%- if acc_mf_key != blank -%}
        {%- assign acc_mf_obj = product.metafields.custom[acc_mf_key] -%}
          {%- if acc_mf_obj.type == 'rich_text' -%}
            {%- assign acc_mf_val = acc_mf_obj | metafield_tag -%}
          {%- else -%}
            {%- assign acc_mf_val = acc_mf_obj.value -%}
          {%- endif -%}
      {%- endif -%}
      {%- assign acc_content = acc_mf_val | default: block.settings.content_fallback -%}

      <div class="cm-accordion" data-accordion {{ block.shopify_attributes }}>
        <button
          class="cm-accordion__trigger"
          aria-expanded="false"
          aria-controls="cm-acc-{{ block.id }}"
          id="cm-acc-btn-{{ block.id }}"
          type="button"
        >
          <span class="cm-accordion__trigger-left">
            <span class="cm-accordion__trigger-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'conservation' -%}
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>
                  </svg>
                {%- when 'origin' -%}
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
                  </svg>
                {%- when 'fork' -%}
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 8.25v-1.5m0 1.5c-1.355 0-2.697.056-4.024.166C6.845 8.51 6 9.473 6 10.608v2.513m6-4.87c1.355 0 2.697.055 4.024.165C17.155 8.51 18 9.473 18 10.608v2.513m-3-4.87v-1.5m-6 4.5v7.5m12-7.5v7.5m-12 0h12"/>
                  </svg>
                {%- when 'sun' -%}
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
                  </svg>
                {%- else -%}
                  <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="cm-accordion__trigger-title">{{ block.settings.title }}</span>
          </span>
          <svg class="cm-accordion__chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div
          class="cm-accordion__content"
          id="cm-acc-{{ block.id }}"
          role="region"
          aria-labelledby="cm-acc-btn-{{ block.id }}"
        >
          <div class="cm-accordion__body">
            {%- if acc_content != blank -%}
              <div class="cm-accordion-block">{{ acc_content }}</div>
            {%- else -%}
              <p class="cm-accordion-block__empty">Información no añadida todavía para este producto.</p>
            {%- endif -%}
          </div>
        </div>
      </div>

    {%- endfor -%}
  </div>
  {%- endif -%}
  {%- comment -%} fin acordeones {%- endcomment -%}

</section>

{%- comment -%} ════════════════════════════════════ COMBINA (oculta por defecto) ══ {%- endcomment -%}
<div class="cm-combina-section" id="cm-combina-section">
  <h2 class="cm-combina__title">Combina tu compra con</h2>
  <p style="color:var(--text-secondary);font-size:14px;font-family:var(--cm-font-sans);">
    Descubre los productos que mejor maridan con tu selección.
  </p>
</div>

{%- comment -%} ════════════════════════════════════ STICKY ATC ══ {%- endcomment -%}
{%- if section.settings.show_sticky_atc -%}
  <div
    class="cm-sticky-atc"
    id="cm-sticky-atc-{{ section.id }}"
    aria-hidden="true"
    aria-label="Compra rápida"
  >
    <div class="cm-sticky-atc__inner">
      <div class="cm-sticky-atc__product">
        {%- if product.featured_image -%}
          <img
            class="cm-sticky-atc__img"
            src="{{ product.featured_image | image_url: width: 100 }}"
            alt="{{ product.title | escape }}"
            width="44"
            height="44"
            loading="lazy"
          >
        {%- endif -%}
        <div>
          <span class="cm-sticky-atc__name">{{ product.title | truncate: 45 }}</span>
          <span class="cm-sticky-atc__price" id="cm-sticky-price-{{ section.id }}">
            {{ current_variant.price | money }}
          </span>
        </div>
      </div>
      <div class="cm-sticky-atc__right">
        <div class="cm-sticky-qty" role="group" aria-label="Cantidad">
          <button type="button" class="cm-sticky-qty__btn" id="cm-sticky-qty-minus-{{ section.id }}" aria-label="Reducir cantidad">−</button>
          <span class="cm-sticky-qty__val" id="cm-sticky-qty-val-{{ section.id }}">1</span>
          <button type="button" class="cm-sticky-qty__btn" id="cm-sticky-qty-plus-{{ section.id }}" aria-label="Aumentar cantidad">+</button>
        </div>
        <button
          type="button"
          class="cm-sticky-atc__btn"
          id="cm-sticky-btn-{{ section.id }}"
          {%- unless current_variant.available -%}disabled{%- endunless -%}
          aria-label="Añadir a la cesta"
        >
          {%- if current_variant.available -%}Añadir a la cesta{%- else -%}Agotado{%- endif -%}
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} ════════════════════════════════════ JAVASCRIPT ══ {%- endcomment -%}
<script>
document.addEventListener('DOMContentLoaded', function() {
(function() {
  'use strict';

  const SID = '{{ section.id }}';
  const data = window['cmPDP_' + SID]; = {

  /* ── Utilidades ── */
  function $(id) { return document.getElementById(id); }
  function formatMoney(cents) {
    if (!data) return cents;
    const amount = (cents / 100).toFixed(2);
    return data.moneyFormat
      .replace('{' + '{amount}}', amount)
      .replace('{' + '{amount_with_comma_separator}}', amount.replace('.', ','))
      .replace('{' + '{amount_no_decimals}}', Math.round(cents / 100));
  }

  /* ── Galería — thumbnails ── */
  const mainImg = $('cm-main-img-' + SID);
  if (mainImg) {
    document.querySelectorAll('.cm-pdp__thumb-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        mainImg.classList.add('is-loading');
        const newSrc = btn.dataset.imageSrc;
        const tempImg = new Image();
        tempImg.onload = () => {
          mainImg.src = newSrc;
          mainImg.alt = btn.dataset.imageAlt || '';
          mainImg.classList.remove('is-loading');
        };
        tempImg.src = newSrc;
        document.querySelectorAll('.cm-pdp__thumb-btn').forEach(t => t.classList.remove('is-active'));
        btn.classList.add('is-active');
      });
    });
  }

  /* ── Selector de curación (dropdown) ── */
  const curingSelect = document.querySelector('#cm-curing-' + SID + ' [data-curing-select]');
  const curingHint   = $('cm-curing-hint-' + SID);
  if (curingSelect) {
    curingSelect.addEventListener('change', function() {
      const opt = this.options[this.selectedIndex];
      if (curingHint) curingHint.textContent = opt.dataset.desc || '';
    });
  }

  /* ── Selector de cantidad ── */
  const qtyInput = $('cm-qty-' + SID);
  const qtyMinus = $('cm-qty-minus-' + SID);
  const qtyPlus  = $('cm-qty-plus-' + SID);

  function getQty() { return qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1; }
  function setQty(v) {
    v = Math.max(1, v);
    if (qtyInput) qtyInput.value = v;
    const stickyVal = $('cm-sticky-qty-val-' + SID);
    if (stickyVal) stickyVal.textContent = v;
  }

  if (qtyInput) {
    qtyMinus?.addEventListener('click', () => setQty(getQty() - 1));
    qtyPlus?.addEventListener('click',  () => setQty(getQty() + 1));
    qtyInput.addEventListener('change', () => setQty(parseInt(qtyInput.value, 10)));
  }

  /* ── Qty sticky sincronizada ── */
  const stickyQtyMinus = $('cm-sticky-qty-minus-' + SID);
  const stickyQtyPlus  = $('cm-sticky-qty-plus-' + SID);
  stickyQtyMinus?.addEventListener('click', () => setQty(getQty() - 1));
  stickyQtyPlus?.addEventListener('click',  () => setQty(getQty() + 1));

  /* ── Selector de variantes ── */
  const selectedOptions = {};
  document.querySelectorAll('.cm-pdp__select[data-section="' + SID + '"]').forEach(sel => {
    selectedOptions[sel.dataset.optionIndex] = sel.value;
    sel.addEventListener('change', () => {
      selectedOptions[sel.dataset.optionIndex] = sel.value;
      updateVariant();
    });
  });

  function findVariant() {
    if (!data) return null;
    return data.variants.find(v => {
      const m1 = !v.option1 || v.option1 === selectedOptions[1];
      const m2 = !v.option2 || v.option2 === selectedOptions[2];
      const m3 = !v.option3 || v.option3 === selectedOptions[3];
      return m1 && m2 && m3;
    });
  }

  function updateVariant() {
    const variant = findVariant();
    if (!variant) return;

    /* ID oculto */
    const idInput = $('cm-variant-id-' + SID);
    if (idInput) idInput.value = variant.id;

    /* Precio */
    const priceEl  = $('cm-price-' + SID);
    const cmpEl    = $('cm-compare-price-' + SID);
    const badgeEl  = $('cm-discount-badge-' + SID);
    const stickyP  = $('cm-sticky-price-' + SID);

    if (priceEl) {
      priceEl.textContent = formatMoney(variant.price);
      priceEl.classList.toggle('cm-pdp__price--sale', variant.compare_at_price > variant.price);
    }
    if (cmpEl) {
      if (variant.compare_at_price > variant.price) {
        cmpEl.textContent = formatMoney(variant.compare_at_price);
        cmpEl.style.display = '';
      } else {
        cmpEl.style.display = 'none';
      }
    }
    if (badgeEl) {
      if (variant.compare_at_price > variant.price) {
        const pct = Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);
        badgeEl.textContent = '-' + pct + '%';
        badgeEl.style.display = '';
      } else {
        badgeEl.style.display = 'none';
      }
    }
    if (stickyP) stickyP.textContent = formatMoney(variant.price);

    /* Botón añadir */
    const addBtn  = $('cm-add-' + SID);
    const addText = $('cm-add-text-' + SID);
    const stickyBtn = $('cm-sticky-btn-' + SID);
    if (addBtn) {
      addBtn.disabled = !variant.available;
      if (addText) addText.textContent = variant.available ? 'Añadir a la cesta' : 'Agotado';
    }
    if (stickyBtn) {
      stickyBtn.disabled = !variant.available;
      stickyBtn.textContent = variant.available ? 'Añadir a la cesta' : 'Agotado';
    }

    /* Imagen de variante */
    if (variant.featured_image && mainImg) {
      mainImg.classList.add('is-loading');
      const tempImg = new Image();
      tempImg.onload = () => {
        mainImg.src = variant.featured_image.src;
        mainImg.classList.remove('is-loading');
      };
      tempImg.src = variant.featured_image.src;
    }
  }

  /* ── AJAX añadir al carrito ── */
  function revealCombina() {
    const el = document.getElementById('cm-combina-section');
    if (!el) return;
    el.style.display = 'block';
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        el.classList.add('is-animating');
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'start' }), 300);
      });
    });
  }

  function updateCartCount() {
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => {
        document.querySelectorAll('[data-cart-count], .cart-count, .header__cart-count, .js-cart-count').forEach(el => {
          el.textContent = cart.item_count;
          el.setAttribute('aria-label', cart.item_count + ' artículos en la cesta');
        });
      })
      .catch(() => {});
  }

  function setAddBtnState(state) {
    const addBtn    = $('cm-add-' + SID);
    const addText   = $('cm-add-text-' + SID);
    const stickyBtn = $('cm-sticky-btn-' + SID);
    const labels = { idle: 'Añadir a la cesta', loading: 'Añadiendo…', done: '✓ Añadido' };
    if (addBtn)    addBtn.disabled = (state !== 'idle');
    if (addText)   addText.textContent = labels[state] || labels.idle;
    if (stickyBtn) { stickyBtn.disabled = (state !== 'idle'); stickyBtn.textContent = labels[state] || labels.idle; }
  }

  const mainForm = $('cm-form-' + SID);
  if (mainForm) {
    mainForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const variantId = $('cm-variant-id-' + SID)?.value;
      if (!variantId) return;

      setAddBtnState('loading');

      try {
        const curingSelectEl = document.querySelector('#cm-curing-' + SID + ' [data-curing-select]');
        const curingVal = curingSelectEl ? curingSelectEl.value : '';
        const weightSelectEl = document.querySelector('[data-weight-select]');
        const weightVal = weightSelectEl ? weightSelectEl.value : '';
        const cartBody = {
          id: variantId,
          quantity: getQty(),
          properties: {}
        };
        if (curingVal) cartBody.properties['Punto de curación'] = curingVal;
        if (weightVal) cartBody.properties['Peso aproximado'] = weightVal;

        const res = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(cartBody)
        });
        if (!res.ok) throw new Error('add failed');
        setAddBtnState('done');
        updateCartCount();
        revealCombina();
        setTimeout(() => setAddBtnState('idle'), 2500);
      } catch {
        setAddBtnState('idle');
      }
    });
  }

  /* ── Toggle descripción ── */
  const descToggle = $('cm-desc-toggle-' + SID);
  if (descToggle) {
    const fullEl    = $('cm-desc-full-' + SID);
    const previewEl = $('cm-desc-preview-' + SID);
    const moreText  = descToggle.querySelector('.cm-desc-toggle__more');
    const lessText  = descToggle.querySelector('.cm-desc-toggle__less');

    descToggle.addEventListener('click', () => {
      const expanded = descToggle.getAttribute('aria-expanded') === 'true';
      descToggle.setAttribute('aria-expanded', String(!expanded));
      if (fullEl)    {
        fullEl.classList.toggle('is-open', !expanded);
        fullEl.setAttribute('aria-hidden', String(expanded));
      }
      if (previewEl) previewEl.style.display = expanded ? '' : 'none';
      if (moreText)  moreText.style.display  = expanded ? '' : 'none';
      if (lessText)  lessText.style.display  = expanded ? 'none' : '';
    });
  }

  /* ── Acordeones ── */
setTimeout(function() {
  var allAccordions = document.querySelectorAll('.cm-accordion');
  
  if (!allAccordions || allAccordions.length === 0) return;

  allAccordions.forEach(function(acc) {
    var trigger = acc.querySelector('.cm-accordion__trigger');
    var content = acc.querySelector('.cm-accordion__content');
    
    if (!trigger || !content) return;

    content.style.maxHeight = '0px';
    content.style.overflow = 'hidden';
    content.style.transition = 'max-height 0.4s ease';
    content.style.display = 'block';

    trigger.addEventListener('click', function() {
      var isOpen = trigger.getAttribute('aria-expanded') === 'true';

      allAccordions.forEach(function(a) {
        var t = a.querySelector('.cm-accordion__trigger');
        var c = a.querySelector('.cm-accordion__content');
        if (t) t.setAttribute('aria-expanded', 'false');
        if (c) c.style.maxHeight = '0p

  /* ── Sticky ATC ── */
  {%- if section.settings.show_sticky_atc -%}
  const addBtnEl  = $('cm-add-' + SID);
  const stickyAtc = $('cm-sticky-atc-' + SID);
  const stickyBtn = $('cm-sticky-btn-' + SID);

  if (addBtnEl && stickyAtc) {
    /* En el editor de Shopify siempre visible para poder diseñar */
    if (window.Shopify && Shopify.designMode) {
      stickyAtc.classList.add('is-visible');
      stickyAtc.setAttribute('aria-hidden', 'false');
    } else if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const visible = !entry.isIntersecting;
          stickyAtc.classList.toggle('is-visible', visible);
          stickyAtc.setAttribute('aria-hidden', String(!visible));
        });
      }, { threshold: 0, rootMargin: '0px 0px -60px 0px' });
      observer.observe(addBtnEl);
    }
  }

  if (stickyBtn) {
    stickyBtn.addEventListener('click', () => {
      if (mainForm) mainForm.requestSubmit ? mainForm.requestSubmit() : mainForm.submit();
    });
  }
  {%- endif -%}

  /* ── Scroll reveal ── */
  if ('IntersectionObserver' in window) {
    const revealObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          revealObs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.cm-reveal').forEach(el => revealObs.observe(el));
  } else {
    document.querySelectorAll('#cm-pdp-' + SID + ' .cm-reveal').forEach(el => el.classList.add('is-revealed'));
  }

})();
}); // DOMContentLoaded
</script>

{% schema %}
{
  "name": "Producto Gourmet",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Funcionalidades"
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Mostrar barra de compra fija (sticky)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_facts",
      "label": "Mostrar barra de características rápidas",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Mostrar sellos de confianza",
      "default": true
    },
    {
      "type": "header",
      "content": "Selector de peso"
    },
    {
      "type": "checkbox",
      "id": "show_weight_selector",
      "label": "Mostrar selector de peso aproximado",
      "default": true
    },
    {
      "type": "text",
      "id": "weight_options",
      "label": "Opciones de peso (separadas por comas)",
      "default": "6-7 kg, 8-9 kg",
      "info": "Ej: 6-7 kg, 8-9 kg, 10-11 kg. Cada opción separada por coma."
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Sello de confianza",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto del sello",
          "default": "Envío en 24-48h"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck",   "label": "Camión (envío)" },
            { "value": "shield",  "label": "Escudo (seguridad)" },
            { "value": "star",    "label": "Estrella (calidad)" },
            { "value": "leaf",    "label": "Hoja (natural)" }
          ],
          "default": "truck"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Sección de información",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "conservation", "label": "Conservación (termómetro)" },
