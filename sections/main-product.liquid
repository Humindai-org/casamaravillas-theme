          aria-labelledby="cm-acc-btn-info-{{ section.id }}"
        >
          <div class="cm-accordion__body">
            {%- if mf_allergens != blank -%}
              <div class="cm-accordion-block">
                <h3 class="cm-accordion-block__title">Alérgenos</h3>
                <p>{{ mf_allergens }}</p>
