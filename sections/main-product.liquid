{% comment %}
  main-product.liquid — Sección de producto premium para Casa Maravillas
  Jamones, embutidos y productos ibéricos
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}
{%- assign product_accent = '#00294B' -%}
{%- case product.type -%}
  {%- when 'Jamón' -%}           {%- assign product_accent = '#C4973A' -%}
  {%- when 'Carnes Ibéricas' -%} {%- assign product_accent = '#C05A38' -%}
  {%- when 'Embutidos' -%}       {%- assign product_accent = '#7A1F3C' -%}
  {%- when 'Packs & Regalos' -%} {%- assign product_accent = '#4A5B6B' -%}
{%- endcase -%}

<style>
  /* ── LAYOUT PRINCIPAL ── */
  .cm-pdp {
    --pdp-accent: {{ product_accent }};
    max-width: 1280px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }

  .cm-pdp__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* ── GALERÍA ── */
  .cm-pdp__gallery {
    position: sticky;
    top: 100px;
  }

  .cm-pdp__gallery-inner {
    display: flex;
    gap: 14px;
    align-items: stretch;
  }

  .cm-pdp__main-img-wrap {
    flex: 1;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--cm-light);
    position: relative;
  }

  .cm-pdp__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.25s ease;
  }

  .cm-pdp__main-img.is-loading { opacity: 0; }

  /* Navegación vertical */
  .cm-pdp__nav-vertical {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    gap: 0;
  }

  .cm-pdp__nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px 0;
  }

  .cm-pdp__nav-num {
    font-size: 9px;
    font-family: var(--cm-font-sans);
    color: var(--cm-text-light);
    letter-spacing: 0.05em;
    line-height: 1;
    transition: color 0.2s;
  }

  .cm-pdp__nav-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cm-border2);
    transition: background 0.25s, transform 0.25s;
  }

  .cm-pdp__nav-item.is-active .cm-pdp__nav-num { color: var(--pdp-accent); font-weight: 600; }
  .cm-pdp__nav-item.is-active .cm-pdp__nav-dot { background: var(--pdp-accent); transform: scale(1.6); }
  .cm-pdp__nav-item:hover:not(.is-active) .cm-pdp__nav-dot { background: var(--cm-text-light); }
  .cm-pdp__nav-item:focus-visible { outline: 2px solid var(--pdp-accent); outline-offset: 2px; }

  /* ── INFO ── */
  .cm-pdp__eyebrow {
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-bottom: 14px;
  }

  .cm-pdp__title {
    font-family: var(--cm-font-serif);
    font-size: clamp(28px, 3vw, 42px);
    color: var(--cm-navy);
    line-height: 1.15;
    margin-bottom: 20px;
    font-weight: 400;
  }

  /* ── BARRA DE HECHOS RÁPIDOS ── */
  .cm-pdp__facts {
    display: flex;
    gap: 0;
    border: 1px solid var(--cm-border);
    margin-bottom: 28px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .cm-pdp__facts::-webkit-scrollbar { display: none; }

  .cm-fact {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    flex: 1;
    min-width: 100px;
    border-right: 1px solid var(--cm-border);
    white-space: nowrap;
  }

  .cm-fact:last-child { border-right: none; }

  .cm-fact__icon {
    color: var(--cm-gold);
    flex-shrink: 0;
    display: flex;
  }

  .cm-fact__label {
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    font-family: var(--cm-font-sans);
    display: block;
    line-height: 1;
    margin-bottom: 3px;
  }

  .cm-fact__value {
    font-size: 12px;
    font-weight: 500;
    color: var(--cm-navy);
    font-family: var(--cm-font-sans);
    display: block;
    line-height: 1;
  }

  /* ── PRECIO ── */
  .cm-pdp__price-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }

  .cm-pdp__price {
    font-size: 28px;
    font-weight: 400;
    color: var(--cm-text);
    font-family: var(--cm-font-sans);
  }

  .cm-pdp__price--sale { color: #8B1A1A; }

  .cm-pdp__price--compare {
    font-size: 17px;
    color: var(--cm-text-light);
    text-decoration: line-through;
  }

  .cm-pdp__discount-badge {
    font-size: 10px;
    letter-spacing: 0.1em;
    background: #8B1A1A;
    color: #fff;
    padding: 3px 8px;
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  .cm-pdp__price-kg {
    font-size: 12px;
    color: var(--cm-text-light);
    font-family: var(--cm-font-sans);
    margin-bottom: 24px;
  }

  /* ── VARIANTES ── */
  .cm-pdp__variants { margin-bottom: 24px; }

  .cm-pdp__option-group { margin-bottom: 16px; }

  .cm-pdp__option-label {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    font-family: var(--cm-font-sans);
    margin-bottom: 10px;
    display: block;
  }

  .cm-pdp__option-values { display: flex; gap: 8px; flex-wrap: wrap; }

  .cm-variant-radio { position: absolute; opacity: 0; width: 0; height: 0; }

  .cm-variant-label {
    display: inline-block;
    padding: 8px 20px;
    border: 1px solid var(--cm-border);
    font-size: 13px;
    font-family: var(--cm-font-sans);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    user-select: none;
  }

  .cm-variant-radio:checked + .cm-variant-label {
    border-color: var(--cm-navy);
    background: var(--cm-navy);
    color: var(--cm-white);
  }

  .cm-variant-label:hover { border-color: var(--cm-navy); }

  .cm-variant-radio:focus-visible + .cm-variant-label {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  /* ── COMPRA ── */
  .cm-pdp__purchase {
    display: flex;
    gap: 10px;
    align-items: stretch;
    margin-bottom: 24px;
  }

  .cm-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--cm-border);
    flex-shrink: 0;
  }

  .cm-qty__btn {
    width: 44px;
    height: 52px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--cm-text);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    font-family: var(--cm-font-sans);
  }

  .cm-qty__btn:hover { background: var(--cm-light); }

  .cm-qty__btn:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: -2px;
  }

  .cm-qty__input {
    width: 44px;
    height: 52px;
    border: none;
    border-left: 1px solid var(--cm-border);
    border-right: 1px solid var(--cm-border);
    text-align: center;
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: var(--cm-text);
    background: transparent;
    -moz-appearance: textfield;
  }

  .cm-qty__input::-webkit-outer-spin-button,
  .cm-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .cm-pdp__add-btn {
    flex: 1;
    height: 52px;
    background: var(--cm-navy);
    color: var(--cm-white);
    border: 1px solid var(--cm-navy);
    font-family: var(--cm-font-sans);
    font-size: 11px;
    letter-spacing: 0.18em;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }

  .cm-pdp__add-btn:hover:not(:disabled) {
    background: transparent;
    color: var(--cm-navy);
  }

  .cm-pdp__add-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .cm-pdp__add-btn:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  /* ── DESCRIPCIÓN CORTA ── */
  .cm-pdp__desc { margin-bottom: 24px; }

  .cm-pdp__desc-preview {
    font-size: 14px;
    color: var(--cm-text-mid);
    line-height: 1.8;
    transition: opacity 0.3s;
  }

  .cm-pdp__desc-full {
    font-size: 14px;
    color: var(--cm-text-mid);
    line-height: 1.8;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s ease, opacity 0.4s ease;
    opacity: 0;
  }

  .cm-pdp__desc-full.is-open {
    max-height: 800px;
    opacity: 1;
  }

  .cm-pdp__desc-full.is-open + .cm-pdp__desc-preview { display: none; }

  .cm-desc-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-top: 10px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .cm-desc-toggle:hover { color: var(--cm-navy); }

  .cm-desc-toggle:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .cm-desc-toggle__chevron {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .cm-desc-toggle[aria-expanded="true"] .cm-desc-toggle__chevron {
    transform: rotate(180deg);
  }

  /* ── TRUST BADGES ── */
  .cm-pdp__trust {
    padding-top: 24px;
    border-top: 1px solid var(--cm-border);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .cm-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--cm-text-mid);
    font-family: var(--cm-font-sans);
  }

  .cm-trust-item__icon {
    color: var(--cm-gold);
    flex-shrink: 0;
    display: flex;
  }

  /* ── ACORDEONES ── */
  .cm-pdp__accordions {
    max-width: 1280px;
    margin: 64px auto 0;
    padding: 0 24px;
    border-top: 1px solid var(--cm-border);
  }

  .cm-accordion {
    border-bottom: 1px solid var(--cm-border);
  }

  .cm-accordion__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--cm-font-sans);
    gap: 16px;
  }

  .cm-accordion__trigger:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .cm-accordion__trigger-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .cm-accordion__trigger-icon {
    color: var(--cm-gold);
    flex-shrink: 0;
    display: flex;
  }

  .cm-accordion__trigger-title {
    font-family: var(--cm-font-serif);
    font-size: 18px;
    color: var(--cm-navy);
    font-weight: 400;
  }

  .cm-accordion__chevron {
    flex-shrink: 0;
    color: var(--cm-text-light);
    transition: transform 0.35s ease;
  }

  .cm-accordion__trigger[aria-expanded="true"] .cm-accordion__chevron {
    transform: rotate(180deg);
  }

  .cm-accordion__trigger[aria-expanded="true"] .cm-accordion__trigger-title {
    color: var(--cm-gold);
  }

  .cm-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.45s ease;
  }

  .cm-accordion__body {
    padding: 0 0 28px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cm-accordion-block__title {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-family: var(--cm-font-sans);
    font-weight: 500;
    margin-bottom: 10px;
  }

  .cm-accordion-block p,
  .cm-accordion-block div {
    font-size: 14px;
    color: var(--cm-text-mid);
    line-height: 1.8;
    font-family: var(--cm-font-sans);
  }

  /* Tabla nutricional */
  .cm-nutritional-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    font-family: var(--cm-font-sans);
  }

  .cm-nutritional-table th,
  .cm-nutritional-table td {
    padding: 9px 12px;
    text-align: left;
    border-bottom: 1px solid var(--cm-border);
    color: var(--cm-text-mid);
  }

  .cm-nutritional-table th {
    font-weight: 500;
    color: var(--cm-navy);
    background: var(--cm-off);
  }

  /* Lista de origen */
  .cm-origin-list { display: flex; flex-direction: column; gap: 0; }

  .cm-origin-item {
    display: grid;
    grid-template-columns: 160px 1fr;
    padding: 11px 0;
    border-bottom: 1px solid var(--cm-border);
    gap: 16px;
    align-items: baseline;
  }

  .cm-origin-item:last-child { border-bottom: none; }

  .cm-origin-item dt {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cm-text-light);
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  .cm-origin-item dd {
    font-size: 14px;
    color: var(--cm-text-mid);
    font-family: var(--cm-font-sans);
  }

  /* Grid de notas de cata */
  .cm-cata-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cm-cata-item {
    padding: 24px;
    background: var(--cm-off);
    text-align: center;
  }

  .cm-cata-item__icon {
    color: var(--cm-gold);
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  .cm-cata-item h4 {
    font-family: var(--cm-font-serif);
    font-size: 16px;
    color: var(--cm-navy);
    font-weight: 400;
    margin-bottom: 8px;
  }

  .cm-cata-item p {
    font-size: 13px;
    color: var(--cm-text-mid);
    line-height: 1.7;
    font-family: var(--cm-font-sans);
  }

  /* ── STICKY ATC ── */
  .cm-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
    pointer-events: none;
    background: var(--cm-white);
    border-top: 1px solid var(--cm-border);
    box-shadow: 0 -8px 32px rgba(0, 41, 75, 0.08);
  }

  .cm-sticky-atc.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .cm-sticky-atc__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cm-sticky-atc__product {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    flex: 1;
  }

  .cm-sticky-atc__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .cm-sticky-qty {
    display: flex;
    align-items: center;
    border: 1px solid var(--cm-border);
    height: 46px;
  }

  .cm-sticky-qty__btn {
    width: 38px;
    height: 100%;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--cm-text);
    font-size: 18px;
    font-family: var(--cm-font-sans);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .cm-sticky-qty__btn:hover { background: var(--cm-light); }

  .cm-sticky-qty__btn:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: -2px;
  }

  .cm-sticky-qty__val {
    width: 36px;
    text-align: center;
    font-size: 14px;
    font-family: var(--cm-font-sans);
    color: var(--cm-text);
    border-left: 1px solid var(--cm-border);
    border-right: 1px solid var(--cm-border);
    line-height: 46px;
    display: block;
    flex-shrink: 0;
  }

  .cm-sticky-atc__img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .cm-sticky-atc__name {
    font-family: var(--cm-font-serif);
    font-size: 16px;
    color: var(--cm-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .cm-sticky-atc__price {
    font-size: 14px;
    font-weight: 500;
    color: var(--cm-text);
    font-family: var(--cm-font-sans);
    display: block;
  }

  .cm-sticky-atc__btn {
    flex-shrink: 0;
    height: 46px;
    padding: 0 32px;
    background: var(--cm-navy);
    color: var(--cm-white);
    border: 1px solid var(--cm-navy);
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    font-weight: 500;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s, color 0.3s;
  }

  .cm-sticky-atc__btn:hover:not(:disabled) {
    background: transparent;
    color: var(--cm-navy);
  }

  .cm-sticky-atc__btn:disabled { opacity: 0.45; cursor: not-allowed; }

  .cm-sticky-atc__btn:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  /* ── SCROLL REVEAL ── */
  .cm-reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .cm-reveal.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .cm-pdp__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .cm-pdp__gallery { position: static; }
    .cm-pdp { padding: 32px 20px 64px; }
    .cm-cata-grid { grid-template-columns: 1fr; gap: 16px; }
    .cm-pdp__facts { overflow-x: auto; }
    .cm-fact { min-width: 90px; }
  }

  @media (max-width: 600px) {
    .cm-pdp__gallery-inner { flex-direction: column-reverse; }
    .cm-pdp__nav-vertical { flex-direction: row; width: 100%; justify-content: center; padding: 8px 0; }
    .cm-pdp__nav-item { flex-direction: column; padding: 0 8px; }
    .cm-pdp__purchase { flex-direction: column; }
    .cm-qty { width: 100%; justify-content: space-between; }
    .cm-pdp__add-btn { width: 100%; }
    .cm-origin-item { grid-template-columns: 1fr; gap: 4px; }
    .cm-sticky-atc__product { display: none; }
    .cm-sticky-qty { display: none; }
    .cm-sticky-atc__btn { width: 100%; }
    .cm-sticky-atc__inner { padding: 12px 20px; }
    .cm-pdp__accordions { padding: 0 20px; }
  }
</style>

{%- comment -%} Datos de variantes para JS {%- endcomment -%}
<script>
  window.cmPDP_{{ section.id }} = {
    variants: {{ product.variants | json }},
    moneyFormat: {{ shop.money_format | json }}
  };
</script>

{%- comment -%} ════════════════════════════════════ SECCIÓN PRINCIPAL ══ {%- endcomment -%}
<section
  id="cm-pdp-{{ section.id }}"
  class="cm-pdp"
  itemscope
  itemtype="https://schema.org/Product"
>

  {%- comment -%} ── GRID: GALERÍA + INFO ── {%- endcomment -%}
  <div class="cm-pdp__grid">

    {%- comment -%} ── COLUMNA IZQUIERDA: GALERÍA ── {%- endcomment -%}
    <div class="cm-pdp__gallery">
      <div class="cm-pdp__gallery-inner">

        {%- if product.images.size > 1 -%}
          <div class="cm-pdp__nav-vertical" role="list" aria-label="Imágenes del producto">
            {%- for image in product.images limit: 6 -%}
              <button
                class="cm-pdp__nav-item{% if forloop.first %} is-active{% endif %}"
                data-image-src="{{ image | image_url: width: 900 }}"
                data-image-alt="{{ image.alt | escape | default: product.title }}"
                aria-label="Ver imagen {{ forloop.index }}"
                role="listitem"
                type="button"
              >
                <span class="cm-pdp__nav-num">0{{ forloop.index }}</span>
                <span class="cm-pdp__nav-dot"></span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="cm-pdp__main-img-wrap">
          {%- if featured_image -%}
            <img
              id="cm-main-img-{{ section.id }}"
              class="cm-pdp__main-img"
              src="{{ featured_image | image_url: width: 900 }}"
              alt="{{ featured_image.alt | escape | default: product.title }}"
              width="{{ featured_image.width }}"
              height="{{ featured_image.height }}"
              loading="eager"
              itemprop="image"
            >
          {%- else -%}
            <div class="cm-pdp__main-img" style="background:var(--cm-light);"></div>
          {%- endif -%}
        </div>

      </div>
    </div>
    {%- comment -%} fin galería {%- endcomment -%}

    {%- comment -%} ── COLUMNA DERECHA: INFO ── {%- endcomment -%}
    <div class="cm-pdp__info">

      {%- if product.type != blank or product.vendor != blank -%}
        <p class="cm-pdp__eyebrow">
          {{ product.vendor }}{% if product.vendor != blank and product.type != blank %} · {% endif %}{{ product.type }}
        </p>
      {%- endif -%}

      <h1 class="cm-pdp__title" itemprop="name">{{ product.title }}</h1>

      {%- comment -%} ── BARRA DE HECHOS RÁPIDOS ── {%- endcomment -%}
      {%- if section.settings.show_quick_facts -%}
        {%- assign mf_curing  = product.metafields.custom.curing_time.value -%}
        {%- assign mf_breed   = product.metafields.custom.breed.value -%}
        {%- assign mf_feeding = product.metafields.custom.feeding_type.value -%}
        {%- assign mf_origin  = product.metafields.custom.origin.value -%}
        {%- assign mf_weight  = product.metafields.custom.weight_info.value -%}
        {%- if mf_curing or mf_breed or mf_feeding or mf_origin or mf_weight -%}
          <div class="cm-pdp__facts" aria-label="Características principales del producto">

            {%- if mf_curing != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                  </svg>
                </span>
                <div>
                  <span class="cm-fact__label">Curación</span>
                  <span class="cm-fact__value">{{ mf_curing }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_breed != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/>
                    <circle cx="6" cy="6" r=".5" fill="currentColor"/>
                  </svg>
                </span>
                <div>
                  <span class="cm-fact__label">Raza</span>
                  <span class="cm-fact__value">{{ mf_breed }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_feeding != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2C10 7 6 9.5 6 14a6 6 0 0012 0c0-4.5-4-7-6-12z"/>
                    <path d="M12 2c0 0 2.5-1.5 5 0"/>
                  </svg>
                </span>
                <div>
                  <span class="cm-fact__label">Alimentación</span>
                  <span class="cm-fact__value">{{ mf_feeding }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_origin != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                  </svg>
                </span>
                <div>
                  <span class="cm-fact__label">Origen</span>
                  <span class="cm-fact__value">{{ mf_origin }}</span>
                </div>
              </div>
            {%- endif -%}

            {%- if mf_weight != blank -%}
              <div class="cm-fact">
                <span class="cm-fact__icon" aria-hidden="true">
                  <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3a2 2 0 100 4 2 2 0 000-4z"/>
                    <path d="M6.343 7.343A8 8 0 1020 12H4a8 8 0 002.343-4.657z"/>
                  </svg>
                </span>
                <div>
                  <span class="cm-fact__label">Peso</span>
                  <span class="cm-fact__value">{{ mf_weight }}</span>
                </div>
              </div>
            {%- endif -%}

          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} ── PRECIO ── {%- endcomment -%}
      <div
        id="cm-price-wrap-{{ section.id }}"
        class="cm-pdp__price-row"
        itemprop="offers"
        itemscope
        itemtype="https://schema.org/Offer"
      >
        <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
        <meta itemprop="availability" content="{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign discount_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price cm-pdp__price--sale"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
          <span id="cm-compare-price-{{ section.id }}" class="cm-pdp__price--compare">
            {{ current_variant.compare_at_price | money }}
          </span>
          <span id="cm-discount-badge-{{ section.id }}" class="cm-pdp__discount-badge">-{{ discount_pct }}%</span>
        {%- else -%}
          <span
            id="cm-price-{{ section.id }}"
            class="cm-pdp__price"
            itemprop="price"
            content="{{ current_variant.price | divided_by: 100.0 }}"
          >{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- if product.metafields.custom.price_per_kg.value != blank -%}
        <p class="cm-pdp__price-kg">{{ product.metafields.custom.price_per_kg.value }}/kg</p>
      {%- endif -%}

      {%- comment -%} ── VARIANTES ── {%- endcomment -%}
      {%- unless product.has_only_default_variant -%}
        <div class="cm-pdp__variants">
          {%- for option in product.options_with_values -%}
            <div class="cm-pdp__option-group">
              <span class="cm-pdp__option-label" id="label-opt{{ forloop.index }}-{{ section.id }}">{{ option.name }}</span>
              <div class="cm-pdp__option-values" role="radiogroup" aria-labelledby="label-opt{{ forloop.index }}-{{ section.id }}">
                {%- for value in option.values -%}
                  {%- assign opt_id = section.id | append: '-opt' | append: forloop.parentloop.index | append: '-' | append: forloop.index -%}
                  <input
                    type="radio"
                    id="radio-{{ opt_id }}"
                    name="cm-option-{{ forloop.parentloop.index }}-{{ section.id }}"
                    value="{{ value | escape }}"
                    data-option-index="{{ forloop.parentloop.index }}"
                    data-section="{{ section.id }}"
                    class="cm-variant-radio"
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <label for="radio-{{ opt_id }}" class="cm-variant-label">{{ value }}</label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- comment -%} ── FORMULARIO DE COMPRA ── {%- endcomment -%}
      {%- form 'product', product, id: 'cm-form-' | append: section.id, novalidate: true -%}
        <input type="hidden" name="id" id="cm-variant-id-{{ section.id }}" value="{{ current_variant.id }}">

        <div class="cm-pdp__purchase">
          <div class="cm-qty" role="group" aria-label="Selector de cantidad">
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-minus-{{ section.id }}"
              aria-label="Reducir cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M5 12h14"/>
              </svg>
            </button>
            <input
              type="number"
              id="cm-qty-{{ section.id }}"
              name="quantity"
              min="1"
              value="1"
              class="cm-qty__input"
              aria-label="Cantidad"
            >
            <button
              type="button"
              class="cm-qty__btn"
              id="cm-qty-plus-{{ section.id }}"
              aria-label="Aumentar cantidad"
            >
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
          </div>

          <button
            type="submit"
            name="add"
            id="cm-add-{{ section.id }}"
            class="cm-pdp__add-btn"
            {%- unless current_variant.available -%}disabled{%- endunless -%}
            aria-label="Añadir {{ product.title | escape }} a la cesta"
          >
            {%- if current_variant.available -%}
              <span id="cm-add-text-{{ section.id }}">Añadir a la cesta</span>
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
              </svg>
            {%- else -%}
              <span id="cm-add-text-{{ section.id }}">Agotado</span>
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} ── DESCRIPCIÓN CORTA ── {%- endcomment -%}
      {%- if product.description != blank -%}
        {%- assign desc_text = product.description | strip_html -%}
        <div class="cm-pdp__desc" id="cm-desc-{{ section.id }}">
          {%- if desc_text.size > 280 -%}
            <div class="cm-pdp__desc-full" id="cm-desc-full-{{ section.id }}" aria-hidden="true">
              {{ product.description }}
            </div>
            <p class="cm-pdp__desc-preview" id="cm-desc-preview-{{ section.id }}">
              {{ desc_text | truncate: 280 }}
            </p>
            <button
              class="cm-desc-toggle"
              id="cm-desc-toggle-{{ section.id }}"
              aria-expanded="false"
              aria-controls="cm-desc-full-{{ section.id }}"
              type="button"
            >
              <span class="cm-desc-toggle__more">Leer más</span>
              <span class="cm-desc-toggle__less" style="display:none">Leer menos</span>
              <svg class="cm-desc-toggle__chevron" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
          {%- else -%}
            <div class="cm-pdp__desc-preview">{{ product.description }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} ── TRUST BADGES ── {%- endcomment -%}
      {%- if section.settings.show_trust_badges -%}
        <div class="cm-pdp__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="cm-trust-item" {{ block.shopify_attributes }}>
                <span class="cm-trust-item__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                      </svg>
                    {%- when 'star' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>
                      </svg>
                    {%- when 'leaf' -%}
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3C7 3 4 7 4 11c0 5 4 8 8 9 4-1 8-4 8-9 0-4-3-8-8-8z"/>
                        <path d="M12 21V12M8 15l4-3 4 3"/>
                      </svg>
                  {%- endcase -%}
                </span>
                <span>{{ block.settings.text }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    {%- comment -%} fin info {%- endcomment -%}

  </div>
  {%- comment -%} fin grid {%- endcomment -%}

  {%- comment -%} ════════════════════════════════════ ACORDEONES ══ {%- endcomment -%}
  <div class="cm-pdp__accordions" id="cm-accordions-{{ section.id }}" aria-label="Información detallada del producto">

    {%- comment -%} 1. Conservación e información nutricional {%- endcomment -%}
    {%- assign mf_stor_before  = product.metafields.custom.storage_before.value -%}
    {%- assign mf_stor_after   = product.metafields.custom.storage_after.value -%}
    {%- assign mf_nutritional  = product.metafields.custom.nutritional_info.value -%}
    <div class="cm-accordion cm-reveal" data-accordion>
        <button
          class="cm-accordion__trigger"
          aria-expanded="false"
          aria-controls="cm-acc-conservacion-{{ section.id }}"
          id="cm-acc-btn-conservacion-{{ section.id }}"
          type="button"
        >
          <span class="cm-accordion__trigger-left">
            <span class="cm-accordion__trigger-icon" aria-hidden="true">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5"/>
              </svg>
            </span>
            <span class="cm-accordion__trigger-title">Conservación e información nutricional</span>
          </span>
          <svg class="cm-accordion__chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div
          class="cm-accordion__content"
          id="cm-acc-conservacion-{{ section.id }}"
          role="region"
          aria-labelledby="cm-acc-btn-conservacion-{{ section.id }}"
        >
          <div class="cm-accordion__body">
            {%- if mf_stor_before != blank -%}
              <div class="cm-accordion-block">
                <h3 class="cm-accordion-block__title">Antes de abrir</h3>
                <p>{{ mf_stor_before }}</p>
              </div>
            {%- endif -%}
            {%- if mf_stor_after != blank -%}
              <div class="cm-accordion-block">
                <h3 class="cm-accordion-block__title">Una vez abierto</h3>
                <p>{{ mf_stor_after }}</p>
              </div>
            {%- endif -%}
            {%- if mf_nutritional != blank -%}
              <div class="cm-accordion-block">
                <h3 class="cm-accordion-block__title">Información nutricional</h3>
                <div class="cm-nutritional-table">{{ mf_nutritional }}</div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

    {%- comment -%} 2. Origen y producción {%- endcomment -%}
    {%- assign mf_geo_origin = product.metafields.custom.geographic_origin.value -%}
    <div class="cm-accordion cm-reveal" data-accordion>
        <button
          class="cm-accordion__trigger"
          aria-expanded="false"
          aria-controls="cm-acc-origen-{{ section.id }}"
          id="cm-acc-btn-origen-{{ section.id }}"
          type="button"
        >
          <span class="cm-accordion__trigger-left">
            <span class="cm-accordion__trigger-icon" aria-hidden="true">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 6.75V15m6-6v8.25m.503 3.498l4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 00-1.006 0L3.622 5.689C3.24 5.88 3 6.27 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0z"/>
              </svg>
            </span>
            <span class="cm-accordion__trigger-title">Origen y producción</span>
          </span>
          <svg class="cm-accordion__chevron" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div
          class="cm-accordion__content"
          id="cm-acc-origen-{{ section.id }}"
          role="region"
          aria-labelledby="cm-acc-btn-origen-{{ section.id }}"
        >
          <div class="cm-accordion__body">
            <dl class="cm-origin-list">
              {%- if mf_geo_origin != blank -%}
                <div class="cm-origin-item">
                  <dt>Origen geográfico</dt><dd>{{ mf_geo_origin }}</dd>
                </div>
              {%- endif -%}
              {%- if mf_breed != blank -%}
                <div class="cm-origin-item">
                  <dt>Raza</dt><dd>{{ mf_breed }}</dd>
                </div>
              {%- endif -%}
              {%- if mf_feeding != blank -%}
                <div class="cm-origin-item">
                  <dt>Alimentación</dt><dd>{{ mf_feeding }}</dd>
                </div>
              {%- endif -%}
              {%- if mf_curing != blank -%}
                <div class="cm-origin-item">
                  <dt>Tiempo de curación</dt><dd>{{ mf_curing }}</dd>
                </div>
              {%- endif -%}
            </dl>
          </div>
        </div>
      </div>

    {%- comment -%} 3. Consumo y recomendaciones {%- endcomment -%}
    {%- assign mf_serving  = product.metafields.custom.serving_suggestions.value -%}
    {%- assign mf_pairing  = product.metafields.custom.pairing_ideas.value -%}
    {%- assign mf_cutting  = product.metafields.custom.cutting_tips.value -%}
    <div class="cm-accordion cm-reveal" data-accordion>
        <button
          class="cm-accordion__trigger"
          aria-expanded="false"
          aria-controls="cm-acc-consumo-{{ section.id }}"
          id="cm-acc-btn-consumo-{{ section.id }}"
          type="button"
        >
          <span class="cm-accordion__trigger-left">
            <span class="cm-accordion__trigger-icon" aria-hidden="true">
              <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
