<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@400;500;600&display=swap');

  :root {
    --cm-navy:     #1b2540;
    --cm-cream:    #f4ede0;
    --cm-cream-3:  #faf6ec;
    --cm-gold:     #b89149;
    --cm-muted:    #6a6655;
    --serif:   'Cormorant Garamond', 'EB Garamond', Georgia, serif;
    --sans:    'Jost', system-ui, sans-serif;
  }

  .cm-hero-split {
    position: relative;
    width: 100%;
    min-height: 82vh;
    overflow: hidden;
    background: var(--cm-cream);
  }

  .cm-hero-split__img-col {
    position: absolute;
    inset: 0;
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect fill="%23e8dec7" width="100" height="100"/></svg>');
    background-size: cover;
    background-position: left center;
    background-repeat: no-repeat;
    background-color: #e8dec7;
  }

  .cm-hero-split__img-track {
    display: flex;
    height: 100%;
    width: 100%;
    transition: transform 0.9s cubic-bezier(0.77, 0, 0.18, 1);
  }

  .cm-hero-split__img-slide {
    flex: 0 0 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .cm-hero-split__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
    transform: scale(1.06);
  }

  .cm-hero-split__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(244, 236, 226, 0) 0%,
      rgba(244, 236, 226, 0) 35%,
      rgba(244, 236, 226, 0.4) 65%,
      rgba(244, 236, 226, 1) 100%
    );
    pointer-events: none;
    z-index: 3;
  }

  .cm-hero-split__header {
    position: absolute;
    top: 40px;
    left: 96px;
    right: 96px;
    display: flex;
    align-items: center;
    gap: 18px;
    z-index: 10;
  }

  .cm-hero-split__header-rule {
    flex: 1;
    height: 1px;
    background: var(--cm-gold);
    opacity: 0.55;
  }

  .cm-hero-split__wordmark {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--cm-navy);
    white-space: nowrap;
    font-weight: 500;
    display: flex;
    align-items: center;
  }

  .cm-hero-split__wordmark-casa {
    opacity: 0.6;
    font-weight: 400;
  }

  .cm-hero-split__wordmark-brand {
    font-weight: 600;
    letter-spacing: 0.42em;
    margin-left: 0.42em;
  }

  .cm-hero-split__wordmark-dot {
    opacity: 0.35;
    margin: 0 14px;
  }

  .cm-hero-split__wordmark-meta {
    opacity: 0.55;
    margin-left: 14px;
  }

  .cm-hero-split__content-col {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    padding: 0 96px;
    color: var(--cm-navy);
    text-align: right;
    z-index: 5;
  }

  .cm-hero-split__content-col > div {
    width: min(100%, 640px);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .cm-hero-split__eyebrow {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--cm-gold);
    margin: 0 0 22px 0;
  }

  .cm-hero-split__h1 {
    margin: 0;
    font-family: var(--serif);
    font-style: normal;
    font-weight: 400;
    letter-spacing: -0.02em;
    font-size: clamp(64px, 7vw, 108px);
    line-height: 0.88;
  }

  .cm-hero-split__year {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    color: var(--cm-gold);
    margin: 12px 0 0 0;
  }

  .cm-hero-split__divider {
    width: 56px;
    height: 1px;
    background: var(--cm-gold);
    margin-top: 28px;
    margin-bottom: 0;
  }

  .cm-hero-split__tagline {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(16px, 1.5vw, 22px);
    color: var(--cm-muted);
    width: 100%;
    margin: 22px 0 0 0;
    line-height: 1.35;
    text-align: right;
    align-self: flex-end;
  }

  .cm-hero-split__cta-group {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
  }

  .cm-hero-split__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--sans);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    padding: 16px 30px;
    border: 1px solid rgba(48, 38, 30, 0.35);
    color: var(--cm-navy);
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    margin-top: 40px;
    min-height: 54px;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .cm-hero-split__cta:hover {
    background: var(--cm-navy);
    color: var(--cm-cream-3);
    border-color: var(--cm-navy);
  }

  .cm-hero-split__cta:hover .cm-hero-split__cta-arrow path {
    stroke: var(--cm-cream-3);
  }

  .cm-hero-split__cta-arrow {
    width: 18px;
    height: 10px;
  }

  .cm-hero-split__nav {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 32px;
  }

  .cm-hero-split__nav-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(48, 38, 30, 0.35);
    background: transparent;
    color: var(--cm-navy);
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .cm-hero-split__nav-btn:hover {
    background: rgba(48, 38, 30, 0.04);
    border-color: rgba(48, 38, 30, 0.55);
  }

  .cm-hero-split__nav-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.5;
  }

  .cm-hero-split__nav-dots {
    display: flex;
    gap: 10px;
    margin-left: 20px;
    align-items: center;
  }

  .cm-hero-split__nav-dot {
    width: 22px;
    height: 1px;
    background: rgba(48, 38, 30, 0.28);
    cursor: pointer;
    transition: background 0.2s ease;
    border: none;
    padding: 0;
  }

  .cm-hero-split__nav-dot.is-active {
    background: rgba(48, 38, 30, 0.88);
  }

  .cm-hero-split__nav-dot:hover {
    background: rgba(48, 38, 30, 0.55);
  }

  @media (max-width: 900px) {
    .cm-hero-split__header {
      top: 24px;
      left: 32px;
      right: 32px;
    }
    .cm-hero-split__content-col {
      padding: 0 32px;
    }
  }

  @media (max-width: 640px) {
    .cm-hero-split {
      min-height: 64vh;
    }

    .cm-hero-split__img-overlay {
      background: linear-gradient(
        180deg,
        rgba(244, 236, 226, 0) 0%,
        rgba(244, 236, 226, 0) 25%,
        rgba(244, 236, 226, 0.35) 60%,
        rgba(244, 236, 226, 0.95) 100%
      );
    }

    .cm-hero-split__content-col {
      align-items: center;
      text-align: center;
      padding: 0 24px;
    }

    .cm-hero-split__content-col > div {
      width: 100%;
      align-items: center;
    }

    .cm-hero-split__h1 {
      font-size: clamp(36px, 9vw, 58px);
      line-height: 1.02;
    }

    .cm-hero-split__tagline {
      text-align: center;
    }

    .cm-hero-split__cta-group {
      align-items: center;
    }

    .cm-hero-split__nav {
      justify-content: center;
    }
  }
</style>

<section
  class="cm-hero-split"
  id="cm-hero-split-{{ section.id }}"
  aria-label="Hero — {{ shop.name }}"
  aria-roledescription="carousel"
>

  <!-- Header with brand and establishment year -->
  <div class="cm-hero-split__header">
    <div class="cm-hero-split__header-rule"></div>
    <div class="cm-hero-split__wordmark">
      <span class="cm-hero-split__wordmark-casa">Casa</span>
      <span class="cm-hero-split__wordmark-brand">Maravillas</span>
      <span class="cm-hero-split__wordmark-dot">·</span>
      <span class="cm-hero-split__wordmark-meta">Est. 1919</span>
    </div>
  </div>

  <!-- Left: Image carousel -->
  <div class="cm-hero-split__img-col">
    <div class="cm-hero-split__img-track" id="cm-hero-split-track-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div
          class="cm-hero-split__img-slide{% if forloop.first %} is-active{% endif %}"
          role="group"
          aria-label="Slide {{ forloop.index }} de {{ section.blocks.size }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 900
              | image_tag:
                  class: 'cm-hero-split__img',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: block.settings.image.alt | escape
            }}
          {%- else -%}
            {% # theme-check-disable-next-line RemoteAsset %}
            <img
              src="https://placehold.co/900x1100/1A1814/F4F2EE?text=Jamón+Ibérico"
              alt="Jamón ibérico de bellota"
              width="900"
              height="1100"
              loading="eager"
              class="cm-hero-split__img"
            >
          {%- endif -%}
          <div class="cm-hero-split__img-overlay"></div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Right: Content -->
  <div class="cm-hero-split__content-col">
    <div id="cm-hero-split-content-{{ section.id }}">
      <!-- Slide content will be populated by JS -->
    </div>
  </div>

</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var hero = document.getElementById('cm-hero-split-' + sectionId);
  if (!hero) return;

  var track = document.getElementById('cm-hero-split-track-' + sectionId);
  var contentContainer = document.getElementById('cm-hero-split-content-' + sectionId);
  var imgSlides = hero.querySelectorAll('.cm-hero-split__img-slide');
  var current = 0;
  var autoTimer;
  var DURATION = 5000;

  var slides = [
    {%- for block in section.blocks -%}
      {
        eyebrow: '{{ block.settings.eyebrow | escape }}',
        heading: '{{ block.settings.heading | escape }}',
        year: '{{ block.settings.year | escape }}',
        tagline: '{{ block.settings.tagline | escape }}',
        cta_label: '{{ block.settings.cta_label | escape }}',
        cta_url: '{{ block.settings.cta_url | escape }}'
      }{%- unless forloop.last %},{%- endunless %}
    {%- endfor -%}
  ];

  function renderContent(index) {
    var slide = slides[index];
    if (!slide) return;

    var dotsHTML = '';
    for (var i = 0; i < slides.length; i++) {
      dotsHTML += '<button class="cm-hero-split__nav-dot' + (i === index ? ' is-active' : '') + '" data-slide="' + i + '" aria-label="Ir a slide ' + (i + 1) + '"></button>';
    }

    contentContainer.innerHTML =
      '<div class="is-active" data-slide-index="' + index + '">' +
      (slide.eyebrow ? '<p class="cm-hero-split__eyebrow">' + slide.eyebrow + '</p>' : '') +
      '<h1 class="cm-hero-split__h1">' + slide.heading + '</h1>' +
      (slide.year ? '<p class="cm-hero-split__year">' + slide.year + '</p>' : '') +
      (slide.tagline ? '<p class="cm-hero-split__tagline">' + slide.tagline + '</p>' : '') +
      '<div class="cm-hero-split__cta-group">' +
      (slide.cta_label ? '<a href="' + (slide.cta_url || '/collections/jamones') + '" class="cm-hero-split__cta">' + slide.cta_label + ' <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></a>' : '') +
      '<div class="cm-hero-split__nav">' +
      '<button class="cm-hero-split__nav-btn" id="cm-hero-split-prev-' + sectionId + '" aria-label="Slide anterior" type="button"><svg viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></button>' +
      '<button class="cm-hero-split__nav-btn" id="cm-hero-split-next-' + sectionId + '" aria-label="Siguiente slide" type="button"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" fill="none" stroke-width="1.5"/></svg></button>' +
      '<div class="cm-hero-split__nav-dots">' + dotsHTML + '</div>' +
      '</div>' +
      '</div>' +
      '</div>';

    // Rebind button listeners
    var prevBtn = document.getElementById('cm-hero-split-prev-' + sectionId);
    var nextBtn = document.getElementById('cm-hero-split-next-' + sectionId);
    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); });

    // Rebind dot listeners
    var dots = contentContainer.querySelectorAll('.cm-hero-split__nav-dot');
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(dot.dataset.slide));
      });
    });
  }

  function goTo(index) {
    if (imgSlides.length === 0) return;

    current = (index + imgSlides.length) % imgSlides.length;

    // Update image slides
    Array.from(imgSlides).forEach(function(slide) {
      slide.classList.remove('is-active');
    });
    imgSlides[current].classList.add('is-active');
    track.style.transform = 'translateX(-' + (current * 100) + '%)';

    // Update content
    renderContent(current);

    startAuto();
  }

  function startAuto() {
    clearInterval(autoTimer);
    autoTimer = setInterval(function() { goTo(current + 1); }, DURATION);
  }

  // Touch swipe
  var touchStartX = 0;
  hero.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  hero.addEventListener('touchend', function(e) {
    var diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); }
  }, { passive: true });

  // Keyboard
  hero.setAttribute('tabindex', '0');
  hero.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowRight') { goTo(current + 1); }
    if (e.key === 'ArrowLeft') { goTo(current - 1); }
  });

  // Init
  goTo(0);
})();
</script>

{% schema %}
{
  "name": "Hero Carousel Split",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de fondo"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Etiqueta superior (dorada)",
          "default": "CASA MARAVILLAS · TRADICIÓN ARTESANAL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título principal",
          "default": "El arte del jamón"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Año/etiqueta (cursiva dorada)",
          "default": "Founded co. 1919"
        },
        {
          "type": "textarea",
          "id": "tagline",
          "label": "Tagline (cursiva)",
          "default": "Tres generaciones dedicadas al sector ibérico"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texto del botón",
          "default": "COLECCIÓN DE JAMONES"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Enlace del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Carousel Split",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "CASA MARAVILLAS · TRADICIÓN ARTESANAL",
            "heading": "El arte del jamón",
            "year": "Founded co. 1919",
            "tagline": "Tres generaciones dedicadas al sector ibérico",
            "cta_label": "COLECCIÓN DE JAMONES",
            "cta_url": "/collections/jamones"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "SELECTA IBÉRICA",
            "heading": "Pata negra de bellota",
            "year": "Premium Selection",
            "tagline": "Los mejores jamones de la dehesa española",
            "cta_label": "DESCUBRIR JAMONES",
            "cta_url": "/collections/jamones-pata-negra"
          }
        },
        {
          "type": "slide",
          "settings": {
            "eyebrow": "REGALOS GOURMET",
            "heading": "Packs especiales",
            "year": "Gift Collections",
            "tagline": "El regalo perfecto para quien aprecia lo auténtico",
            "cta_label": "VER PACKS REGALO",
            "cta_url": "/collections/packs-y-regalos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
