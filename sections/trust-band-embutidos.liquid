{% comment %}
  trust-band-embutidos.liquid
  Banda de confianza EXCLUSIVA de la página de producto Embutidos.
  Es una copia independiente de trust-band.liquid con clases CSS propias
  (.tbe*) para que cualquier cambio aquí NO afecte a las demás bandas.
  Mantiene los IDs cm-trust-formato* porque main-product.liquid los usa
  para actualizar el formato al cambiar de variante.
{% endcomment %}

<style>
  .tbe {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-top: 2px solid var(--cm-gold);
    border-bottom: 1px solid var(--cm-border);
    background: var(--cm-off);
  }

  .tbe__cell {
    padding: 40px 28px;
    border-right: 1px solid var(--cm-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }

  .tbe__cell:last-child { border-right: none; }

  .tbe__icon {
    width: 48px;
    height: 48px;
    color: var(--cm-gold);
    flex-shrink: 0;
  }

  .tbe__title {
    font-size: 12px;
    font-weight: 500;
    color: var(--cm-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--cm-font-sans);
    line-height: 1.3;
  }

  .tbe__desc {
    font-size: 12px;
    color: var(--cm-text-mid);
    line-height: 1.55;
    font-family: var(--cm-font-sans);
  }

  @media (max-width: 767px) {
    .tbe {
      grid-template-columns: 1fr 1fr;
    }
    .tbe__cell:nth-child(2) { border-right: none; }
    .tbe__cell:nth-child(3) {
      border-right: 1px solid var(--cm-border);
      border-top: 1px solid var(--cm-border);
    }
    .tbe__cell:nth-child(4) {
      border-top: 1px solid var(--cm-border);
    }
    .tbe__cell:nth-child(5) {
      border-right: none;
      border-top: 1px solid var(--cm-border);
    }
    .tbe__cell { padding: 20px 14px; gap: 8px; }
    .tbe__icon { width: 36px; height: 36px; }
    .tbe__desc { font-size: 11px; }
  }
</style>

<div class="tbe" id="cm-trust-band">
  {%- for block in section.blocks -%}
    {%- assign icon_name = block.settings.icon -%}
    <div class="tbe__cell" {{ block.shopify_attributes }} {%- if icon_name == 'formato.svg' %} id="cm-trust-formato" data-is-formato="true"{% endif %}>
      <div class="tbe__icon">
        {%- render 'icon-selector', icon: icon_name, width: 48, height: 48, css_class: 'tbe__icon-img' -%}
      </div>
      <div>
        <p class="tbe__title" {%- if icon_name == 'formato.svg' %} id="cm-trust-formato-title"{% endif %}>{{ block.settings.title }}</p>
        <p class="tbe__desc" {%- if icon_name == 'formato.svg' %} id="cm-trust-formato-desc"{% endif %}>
          {%- if icon_name == 'formato.svg' -%}
            {%- if product.tags contains 'loncheado' -%}
              Loncheado
            {%- elsif product.tags contains 'pieza' -%}
              Pieza entera
            {%- else -%}
              {{ block.settings.description }}
            {%- endif -%}
          {%- else -%}
            {{ block.settings.description }}
          {%- endif -%}
        </p>
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
