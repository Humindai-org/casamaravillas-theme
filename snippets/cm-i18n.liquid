{%- assign ph_n = '{' | append: 'n' | append: '}' -%}
{%- assign ph_amount = '{' | append: 'amount' | append: '}' -%}
{%- comment -%}
  cm-i18n.liquid — textos de la tienda para los JS (window.CM_I18N), en el idioma activo.
  Las claves viven en locales/*.json bajo "cm". Los marcadores {n} / {amount} los sustituye el JS.
  Cada JS lleva el texto en español como respaldo por si esta tabla no existe.
{%- endcomment -%}
<script>
  window.CM_I18N = {
    add_to_cart: {{ 'cm.pdp.add_to_cart' | t | json }},
    sold_out: {{ 'cm.pdp.sold_out' | t | json }},
    adding: {{ 'cm.pdp.adding' | t | json }},
    added: {{ 'cm.pdp.added' | t | json }},
    added_short: {{ 'cm.pdp.added_short' | t | json }},
    keep_shopping: {{ 'cm.cart.keep_shopping' | t | json }},
    add_to_my_cart: {{ 'cm.pdp.add_to_my_cart' | t | json }},
    wishlist_add: {{ 'cm.pdp.add_to_wishlist' | t | json }},
    wishlist_saved: {{ 'cm.pdp.wishlist_saved' | t | json }},
    cart_items_aria: {{ 'cm.pdp.cart_items_aria' | t: n: ph_n | json }},
    shipbar_free_html: {{ 'cm.shipbar.free_html' | t | json }},
    shipbar_remaining_html: {{ 'cm.shipbar.remaining_html' | t: amount: ph_amount | json }},
    pack_min_title: {{ 'cm.pack.min_title' | t: min: '{min}' | json }},
    pack_remove_text: {{ 'cm.pack.remove_text' | t: min: '{min}' | json }},
    pack_remove_confirm: {{ 'cm.pack.remove_confirm' | t | json }},
    pack_keep: {{ 'cm.pack.keep' | t | json }},
    pack_missing_title: {{ 'cm.pack.missing_title' | t | json }},
    pack_missing_text: {{ 'cm.pack.missing_text' | t: min: '{min}' | json }},
    pack_ok: {{ 'cm.pack.ok' | t | json }},
    pack_eyebrow: {{ 'cm.pack.eyebrow' | t | json }},
    pack_box_eyebrow: {{ 'cm.pack.box_eyebrow' | t | json }},
    pack_box_title: {{ 'cm.pack.box_title' | t | json }},
    pack_box_remove_aria: {{ 'cm.pack.box_remove_aria' | t | json }},
    pack_box_remove: {{ 'cm.pack.box_remove' | t | json }},
    pack_remove_aria: {{ 'cm.pack.remove_aria' | t | json }},
    no_results: {{ 'cm.info.no_results' | t | json }},
    cb_milestone_disc: {{ 'cm.cb.milestone_disc' | t: pct: '{pct}' | json }},
    pdp_curing_tender: {{ 'cm.pdp.curing_tender' | t | json }},
    pdp_curing_balanced: {{ 'cm.pdp.curing_balanced' | t | json }},
    pdp_curing_cured: {{ 'cm.pdp.curing_cured' | t | json }},
    pdp_curing_label: {{ 'cm.pdp.curing_label' | t | json }},
    pdp_qty: {{ 'cm.pdp.qty' | t | json }},
    cb_cat_sliced_ham: {{ 'cm.cb.cat_sliced_ham' | t | json }},
    cb_cat_ham: {{ 'cm.cb.cat_ham' | t | json }},
    cb_cat_cured: {{ 'cm.cb.cat_cured' | t | json }},
    cb_cat_sliced_cured: {{ 'cm.cb.cat_sliced_cured' | t | json }},
    cb_cat_all: {{ 'cm.cb.cat_all' | t | json }},
    cb_no_match: {{ 'cm.cb.no_match' | t | json }},
    cb_add_to_pack: {{ 'cm.cb.add_to_pack' | t | json }},
    cb_remove_one: {{ 'cm.cb.remove_one' | t | json }},
    cb_add_one: {{ 'cm.cb.add_one' | t | json }},
    cb_count_one: {{ 'cm.cb.count_one' | t: n: '{n}' | json }},
    cb_count_many: {{ 'cm.cb.count_many' | t: n: '{n}' | json }},
    cb_save_auto: {{ 'cm.cb.save_auto' | t: auto: '{auto}', pct: '{pct}' | json }},
    cb_save_cart: {{ 'cm.cb.save_cart' | t: pct: '{pct}' | json }},
    cb_you_save: {{ 'cm.cb.you_save' | t: amount: '{amount}' | json }},
    cb_all_gifts: {{ 'cm.cb.all_gifts' | t | json }},
    cb_what_pack: {{ 'cm.cb.what_pack' | t | json }},
    cb_what_for: {{ 'cm.cb.what_for' | t: label: '{label}' | json }},
    cb_add_more: {{ 'cm.cb.add_more' | t: n: '{n}', what: '{what}' | json }},
    cb_ship_free: {{ 'cm.cb.ship_free' | t | json }},
    cb_ship_remaining: {{ 'cm.cb.ship_remaining' | t: goal: '{goal}', amount: '{amount}' | json }},
    cb_add_error: {{ 'cm.cb.add_error' | t | json }},
    cb_add_fail: {{ 'cm.cb.add_fail' | t | json }},
    cb_load_fail: {{ 'cm.cb.load_fail' | t | json }},
    cart_empty: {{ 'cm.cart.empty' | t | json }},
    cart_items_count_aria: {{ 'cm.cart.items_aria' | t: n: ph_n | json }},
    wishlist_empty: {{ 'cm.wishlist.empty' | t | json }}
  };
  window.cmT = function (key, fallback, vars) {
    var s = (window.CM_I18N && window.CM_I18N[key]) || fallback;
    if (vars) Object.keys(vars).forEach(function (k) { s = s.split('{' + k + '}').join(vars[k]); });
    return s;
  };
</script>
