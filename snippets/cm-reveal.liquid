{%- comment -%}
  Sistema de aparición al hacer scroll, compartido por las secciones de Nosotros.

  El contenido es visible por defecto: solo se oculta si el JS ha corrido y ha
  marcado la etiqueta html con la clase cm-js. Así una carga sin JS (o un fallo
  del observer) muestra la página entera en vez de dejar huecos en blanco.

  Uso: {% render 'cm-reveal' %} en cualquier punto de la sección (el orden no
  importa: el escaneo espera a que el documento entero esté listo), y
  data-cm-reveal en los elementos que deban aparecer. data-cm-delay="1|2|3"
  escalona la entrada.

  Nota: `render` en Liquid aísla el scope entre llamadas, así que una variable
  asignada aquí no sobrevive a la siguiente sección — no sirve como guarda
  "solo una vez". Por eso el script de abajo añade la clase de forma
  idempotente en cada llamada en vez de depender de esa variable.
{%- endcomment -%}

<script>document.documentElement.classList.add('cm-js');</script>

<style>
  html.cm-js [data-cm-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s cubic-bezier(0.22, 1, 0.36, 1),
                transform 1s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }
  html.cm-js [data-cm-reveal].cm-in {
    opacity: 1;
    transform: none;
  }
  html.cm-js [data-cm-delay="1"] { transition-delay: 0.10s; }
  html.cm-js [data-cm-delay="2"] { transition-delay: 0.20s; }
  html.cm-js [data-cm-delay="3"] { transition-delay: 0.30s; }
  html.cm-js [data-cm-delay="4"] { transition-delay: 0.40s; }

  @media (prefers-reduced-motion: reduce) {
    html.cm-js [data-cm-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
(function () {
  if (window.__cmReveal) { window.__cmReveal.scan(); return; }

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function show(el) { el.classList.add('cm-in'); }

  // Cada sección coloca `{% render 'cm-reveal' %}` en un punto distinto de su
  // propio HTML (algunas antes del elemento section, otras después), así que este
  // script puede ejecutarse ANTES de que los elementos que debe vigilar
  // existan todavía en el DOM — el navegador ejecuta cada script en cuanto
  // lo parsea, no espera al resto de la página. Por eso el primer escaneo se
  // aplaza a que el documento entero termine de parsearse: en ese punto todas
  // las secciones ya están en el DOM, sin importar el orden de cada una.
  function ready(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn, { once: true });
    } else {
      fn();
    }
  }

  if (reduce || !('IntersectionObserver' in window)) {
    window.__cmReveal = {
      scan: function () {
        document.querySelectorAll('[data-cm-reveal]').forEach(show);
      }
    };
    ready(window.__cmReveal.scan);
    return;
  }

  // rootMargin generoso por abajo: el elemento aparece antes de entrar del todo,
  // así a velocidad de scroll normal nunca se percibe como espacio vacío.
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      show(e.target);
      io.unobserve(e.target);
    });
  }, { rootMargin: '0px 0px -8% 0px', threshold: 0.01 });

  window.__cmReveal = {
    scan: function () {
      document.querySelectorAll('[data-cm-reveal]:not(.cm-in)').forEach(function (el) {
        // Lo que ya está en pantalla al cargar se muestra sin esperar al scroll.
        if (el.getBoundingClientRect().top < window.innerHeight) { show(el); return; }
        io.observe(el);
      });
    }
  };

  ready(window.__cmReveal.scan);

  // El editor de temas inyecta secciones sin recargar la página.
  document.addEventListener('shopify:section:load', function () { window.__cmReveal.scan(); });
})();
</script>
