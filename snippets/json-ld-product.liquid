{% comment %}
  json-ld-product.liquid
  Datos estructurados schema.org/Product. Render solo desde main-product.liquid,
  reutiliza las variables (current_variant, featured_image, rev_rating...) que esa
  sección ya calcula más arriba. No produce salida visible.

  Offers: una por variante (necesario para jamones de pieza entera, que tienen
  dos pesos con precios distintos) con shippingDetails y hasMerchantReturnPolicy,
  campos que Google exige para que las fichas salgan en la pestaña gratuita de
  Shopping (Merchant Center).
{% endcomment %}

{%- assign ld_breed = product.metafields.custom.breed.value -%}
{%- assign ld_feeding = product.metafields.custom.feeding_type.value -%}
{%- assign ld_origin = product.metafields.custom.origin.value -%}
{%- assign ld_curing = product.metafields.custom.tiempo_de_curacion.value -%}
{%- assign ld_brand = product.vendor | default: 'Casa Maravillas' -%}

{%- comment -%}
  Tarifas reales de envío a España peninsular (TABLA ENVÍOS, IVA incluido,
  confirmada por el cliente 2026-09-22). Gratis desde 80 €; por debajo, la
  caja de jamón entero/deshuesado cuesta 11,20 €, la de cortado a
  mano/embutidos/carnes 8,94 €. Solo cubre España peninsular: es el mercado
  que declara el resto del tema (envios-content.liquid).
{%- endcomment -%}
{%- assign ld_free_shipping_threshold_cents = 8000 -%}
{%- assign ld_product_type_lower = product.type | downcase -%}
{%- if ld_product_type_lower == 'embutidos' or product.tags contains 'cortado a mano' or product.tags contains 'loncheado' -%}
  {%- assign ld_shipping_rate_below_threshold = '8.94' -%}
{%- else -%}
  {%- assign ld_shipping_rate_below_threshold = '11.20' -%}
{%- endif -%}

{%- comment -%}
  Política de devoluciones real (devoluciones-content.liquid): 14 días
  naturales de desistimiento para curados no perecederos, gastos de
  devolución a cargo del cliente. Las carnes frescas ibéricas (perecederas)
  no admiten devolución.
{%- endcomment -%}
{%- if ld_product_type_lower == 'carnes ibéricas' -%}
  {%- assign ld_is_fresh_meat = true -%}
{%- else -%}
  {%- assign ld_is_fresh_meat = false -%}
{%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 500 | json }},
  "sku": {{ current_variant.sku | json }},
  "url": {{ request.origin | append: product.url | json }},
  "image": [
    {{- featured_image | image_url: width: 1200, format: 'webp' | prepend: 'https:' | json -}}
    {%- assign ld_extra_count = 0 -%}
    {%- for image in product.images -%}
      {%- if ld_extra_count < 4 and image != featured_image -%}
        ,{{ image | image_url: width: 1200, format: 'webp' | prepend: 'https:' | json }}
        {%- assign ld_extra_count = ld_extra_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "brand": {
    "@type": "Brand",
    "name": {{ ld_brand | json }}
  }
  {%- if rev_rating != blank -%},
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rev_rating | json }},
    "reviewCount": {{ rev_count | default: 1 | json }}
  }
  {%- endif -%}
  {%- unless ld_breed == blank and ld_feeding == blank and ld_origin == blank and ld_curing == blank -%},
  "additionalProperty": [
    {%- capture ld_props -%}
      {%- unless ld_breed == blank -%}{"@type":"PropertyValue","name":"Raza","value":{{ ld_breed | json }}},{%- endunless -%}
      {%- unless ld_feeding == blank -%}{"@type":"PropertyValue","name":"Alimentación","value":{{ ld_feeding | json }}},{%- endunless -%}
      {%- unless ld_origin == blank -%}{"@type":"PropertyValue","name":"Origen","value":{{ ld_origin | json }}},{%- endunless -%}
      {%- unless ld_curing == blank -%}{"@type":"PropertyValue","name":"Curación","value":{{ ld_curing | json }}},{%- endunless -%}
    {%- endcapture -%}
    {{ ld_props | remove_last: ',' }}
  ]
  {%- endunless -%},
  "offers": [
    {%- for variant in product.variants -%}
      {%- if variant.price >= ld_free_shipping_threshold_cents -%}
        {%- assign ld_shipping_rate = '0.00' -%}
      {%- else -%}
        {%- assign ld_shipping_rate = ld_shipping_rate_below_threshold -%}
      {%- endif -%}
      {
        "@type": "Offer",
        "url": {{ request.origin | append: product.url | append: '?variant=' | append: variant.id | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceValidUntil": {{ 'now' | date: '%s' | plus: 7776000 | date: '%Y-%m-%d' | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "mpn": {{ variant.sku | json }},
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": {{ ld_shipping_rate | json }},
            "currency": {{ cart.currency.iso_code | json }}
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "ES"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": {
              "@type": "QuantitativeValue",
              "minValue": 0,
              "maxValue": 1,
              "unitCode": "DAY"
            },
            "transitTime": {
              "@type": "QuantitativeValue",
              "minValue": 1,
              "maxValue": 2,
              "unitCode": "DAY"
            }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "ES",
          {%- if ld_is_fresh_meat -%}
          "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted"
          {%- else -%}
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 14,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
          {%- endif -%}
        }
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
