{% comment %}
  product-card.liquid
  Variables esperadas:
  - card_product: objeto product de Shopify
  - card_collection: slug de la colección para la etiqueta (optional)
{% endcomment %}

<style>
  .product-card {
    background: var(--cm-white);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    cursor: pointer;
    transition: box-shadow 0.4s ease;
  }

  .product-card:hover {
    box-shadow: 0 16px 48px rgba(26,24,20,0.1), 0 2px 8px rgba(26,24,20,0.05);
    position: relative;
    z-index: 2;
  }

  .product-card__img-box {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--cm-off);
    position: relative;
    border-radius: 10px;
  }

  .product-card__img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--card-pos-x, 50%) var(--card-pos-y, 50%);
    filter: saturate(0.8) brightness(0.85);
    transform: scale(var(--card-zoom, 1));
    transform-origin: var(--card-pos-x, 50%) var(--card-pos-y, 50%);
    transition: transform 0.5s ease;
    display: block;
  }

  .product-card:hover .product-card__img-box img {
    transform: scale(calc(var(--card-zoom, 1) * 1.05));
  }

  /* Hover image swap — shows the product's 2nd image on hover */
  .product-card__img-box .product-card__img--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease, transform 0.5s ease;
  }

  .product-card:hover .product-card__img-box .product-card__img--secondary {
    opacity: 1;
  }

  .product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--cm-navy);
    color: var(--cm-white);
    font-size: 8.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 5px 10px;
    font-family: var(--cm-font-sans);
    font-weight: 500;
  }

  /* Quality tier badge — bottom-right of image */
  .product-card__quality {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .product-card__quality-label {
    font-size: 7.5px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    font-family: var(--cm-font-sans);
    font-weight: 400;
  }

  .product-card__quality-icon {
    width: 32px;
    height: 32px;
  }

  .product-card__quality-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-card__body {
    padding: 22px 24px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 220px;
  }

  .product-card__cat {
    font-size: 9px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--cm-gold);
    font-weight: 500;
    margin-bottom: 8px;
    font-family: var(--cm-font-sans);
  }

  .product-card__name {
    font-family: var(--cm-font-serif);
    font-size: 17px;
    font-weight: 400;
    color: var(--cm-navy);
    line-height: 1.35;
    margin-bottom: 4px;
    text-decoration: none;
  }

  .product-card__name:hover { color: var(--cm-gold); }

  .product-card__name-sub {
    font-size: 12px;
    font-style: italic;
    color: var(--cm-text-light);
    margin-bottom: 16px;
    line-height: 1.4;
    font-family: var(--cm-font-sans);
  }

  .product-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--cm-border);
  }

  .product-card__price {
    font-size: 18px;
    font-weight: 500;
    color: var(--cm-text);
    font-family: var(--cm-font-sans);
  }

  .product-card__price-compare {
    font-size: 13px;
    color: var(--cm-text-light);
    text-decoration: line-through;
    margin-left: 6px;
  }

  .product-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cm-navy);
    font-weight: 500;
    font-family: var(--cm-font-sans);
    transition: color 0.3s;
    text-decoration: none;
  }

  .product-card__cta:hover { color: var(--cm-gold); }
  .product-card__cta::after { content: '→'; font-size: 13px; }
  .product-card__cta:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  /* Circular add-to-cart button in the footer */
  .product-card__plus {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--cm-gold);
    background: transparent;
    color: var(--cm-gold);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }

  .product-card__plus svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  .product-card__plus:hover { background: var(--cm-gold); color: var(--cm-white); }
  .product-card__plus:active { transform: scale(0.9); }
  .product-card__plus:focus-visible {
    outline: 2px solid var(--cm-gold);
    outline-offset: 2px;
  }

  .product-card__plus[disabled] { opacity: 0.55; cursor: default; }

  .product-card__plus.is-added {
    background: #2a7a4b;
    border-color: #2a7a4b;
    color: var(--cm-white);
  }

  .product-card__add-btn {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: var(--cm-navy);
    color: var(--cm-white);
    font-family: var(--cm-font-sans);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, transform 0.3s ease, opacity 0.3s ease;
    transform: translateY(100%);
    opacity: 0;
  }

  .product-card:hover .product-card__add-btn,
  .product-card__add-btn:focus-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .product-card__add-btn:hover { background: var(--cm-gold); }

  .product-card__add-btn.is-added { background: #2a7a4b; }

  @media (max-width: 767px) {
    .product-card__add-btn {
      transform: translateY(0);
      opacity: 1;
      padding: 10px;
      font-size: 9px;
    }
  }
</style>

{%- assign product = card_product -%}
{%- if product != blank -%}
  <article class="product-card">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {%- comment -%}Ajuste fino: 1º el control del editor (bloque, en %), si no el metafield del producto{%- endcomment -%}
      {%- if block_zoom != blank -%}
        {%- assign card_zoom = block_zoom | divided_by: 100.0 -%}
      {%- else -%}
        {%- assign card_zoom = product.metafields.custom.card_zoom | default: 1 -%}
      {%- endif -%}
      {%- if block_offset_x != blank -%}
        {%- assign card_offset_x = block_offset_x -%}
      {%- elsif product.metafields.custom.card_offset_x != blank -%}
        {%- assign card_offset_x = product.metafields.custom.card_offset_x -%}
      {%- else -%}
        {%- assign card_offset_x = 50 -%}
      {%- endif -%}
      {%- if block_offset != blank -%}
        {%- assign card_offset_y = block_offset -%}
      {%- elsif product.metafields.custom.card_offset != blank -%}
        {%- assign card_offset_y = product.metafields.custom.card_offset -%}
      {%- else -%}
        {%- assign card_offset_y = 50 -%}
      {%- endif -%}
      <div class="product-card__img-box" style="--card-zoom: {{ card_zoom }}; --card-pos-x: {{ card_offset_x }}%; --card-pos-y: {{ card_offset_y }}%;">
        {%- comment -%}Imagen principal: 1º la del bloque del editor, si no la destacada del producto{%- endcomment -%}
        {%- assign primary_image = card_image | default: product.featured_image -%}
        {%- if primary_image != blank -%}
          {{ primary_image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              class: 'product-card__img product-card__img--primary',
              alt: primary_image.alt | default: product.title | escape
          }}
          {%- comment -%}Imagen de hover: bloque del editor > metafield > 2ª imagen de la galería{%- endcomment -%}
          {%- assign hover_image = card_hover_image -%}
          {%- if hover_image == blank -%}
            {%- assign hover_image = product.metafields.custom.card_hover_image.value -%}
          {%- endif -%}
          {%- if hover_image == blank and product.images.size > 1 -%}
            {%- assign hover_image = product.images[1] -%}
          {%- endif -%}
          {%- if hover_image != blank -%}
            {{ hover_image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                class: 'product-card__img product-card__img--secondary',
                alt: product.title | escape
            }}
          {%- endif -%}
        {%- else -%}
          {% # theme-check-disable-next-line RemoteAsset %}
          <img src="https://placehold.co/450x600/F4F2EE/A09890?text={{ product.title | url_encode }}" alt="{{ product.title | escape }}" width="450" height="600" loading="lazy" class="product-card__img product-card__img--primary">
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__badge">Oferta</span>
        {%- endif -%}

        {%- comment -%}Quality tier badge — visible only on products with precinto tags{%- endcomment -%}
        {%- assign quality_label = '' -%}
        {%- assign quality_icon_url = '' -%}
        {%- for tag in product.tags -%}
          {%- if tag == 'precinto negro' -%}
            {%- assign quality_label = 'Bellota 100%' -%}
            {%- if tier_icons and tier_icons.tier_icons_bellota_100 != blank -%}
              {%- assign quality_icon_url = tier_icons.tier_icons_bellota_100 | image_url: width: 64 -%}
            {%- endif -%}
          {%- elsif tag == 'precinto rojo' -%}
            {%- assign quality_label = 'Bellota 75%' -%}
            {%- if tier_icons and tier_icons.tier_icons_bellota_75 != blank -%}
              {%- assign quality_icon_url = tier_icons.tier_icons_bellota_75 | image_url: width: 64 -%}
            {%- endif -%}
          {%- elsif tag == 'precinto verde' -%}
            {%- assign quality_label = 'Cebo de Campo' -%}
            {%- if tier_icons and tier_icons.tier_icons_cebo_campo != blank -%}
              {%- assign quality_icon_url = tier_icons.tier_icons_cebo_campo | image_url: width: 64 -%}
            {%- endif -%}
          {%- elsif tag == 'precinto blanco' -%}
            {%- assign quality_label = 'Cebo' -%}
            {%- if tier_icons and tier_icons.tier_icons_cebo != blank -%}
              {%- assign quality_icon_url = tier_icons.tier_icons_cebo | image_url: width: 64 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if quality_label != blank and quality_icon_url != blank -%}
          <div class="product-card__quality" aria-label="Calidad: {{ quality_label }}">
            <span class="product-card__quality-label">{{ quality_label }}</span>
            <div class="product-card__quality-icon">
              <img src="{{ quality_icon_url }}" alt="{{ quality_label }}" loading="lazy" width="64" height="64">
            </div>
          </div>
        {%- endif -%}
        {%- if product.variants.size == 1 -%}
          <button
            class="product-card__add-btn"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            aria-label="Añadir {{ product.title | escape }} a la cesta"
            type="button"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            <span>Añadir</span>
          </button>
        {%- else -%}
          <a
            class="product-card__add-btn"
            href="{{ product.url }}"
            aria-label="Ver opciones de {{ product.title | escape }}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 01-8 0"/>
            </svg>
            <span>Opciones</span>
          </a>
        {%- endif -%}
      </div>
    </a>

    <div class="product-card__body">
      {%- assign cat = product.type | default: card_collection -%}
      {%- if cat != blank -%}
        <p class="product-card__cat">{{ cat }}</p>
      {%- endif -%}

      <a class="product-card__name" href="{{ product.url }}">{{ product.title }}</a>

      {%- if product.metafields.custom.subtitle != blank -%}
        <p class="product-card__name-sub">{{ product.metafields.custom.subtitle }}</p>
      {%- endif -%}

      <div class="product-card__foot">
        <div>
          <span class="product-card__price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="product-card__price-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        {%- if product.variants.size == 1 -%}
          <button
            class="product-card__plus"
            data-variant-id="{{ product.selected_or_first_available_variant.id }}"
            aria-label="Añadir {{ product.title | escape }} a la cesta"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>
        {%- else -%}
          <a
            class="product-card__plus"
            href="{{ product.url }}"
            aria-label="Ver opciones de {{ product.title | escape }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </article>

  <script>
  if (!window.cmCardAddInit) {
    window.cmCardAddInit = true;
    var CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>';
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.product-card__add-btn[data-variant-id], .product-card__plus[data-variant-id]');
      if (!btn) return;
      e.preventDefault();
      var isPlus = btn.classList.contains('product-card__plus');
      var variantId = btn.dataset.variantId;
      var originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = isPlus ? '<span>·</span>' : '<span>...</span>';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId), quantity: 1 })
      })
      .then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      })
      .then(function() {
        btn.innerHTML = isPlus ? CHECK_SVG : '<span>Añadido ✓</span>';
        btn.classList.add('is-added');
        var doOpen = function() {
          if (typeof window.openCart === 'function') window.openCart(true);
        };
        if (typeof window.fetchAndRenderCart === 'function') {
          window.fetchAndRenderCart().then(doOpen).catch(doOpen);
        } else {
          doOpen();
        }
        setTimeout(function() {
          btn.innerHTML = originalHTML;
          btn.classList.remove('is-added');
          btn.disabled = false;
        }, 2000);
      })
      .catch(function() {
        btn.innerHTML = originalHTML;
        btn.disabled = false;
      });
    });
  }
  </script>
{%- else -%}
  <!-- Placeholder card -->
  <article class="product-card">
    <div class="product-card__img-box">
      {% # theme-check-disable-next-line RemoteAsset %}
      <img src="https://placehold.co/450x600/F4F2EE/A09890?text=Producto" alt="Producto" width="450" height="600" loading="lazy">
    </div>
    <div class="product-card__body">
      <p class="product-card__cat">Jamones</p>
      <span class="product-card__name">Jamón Ibérico de Bellota</span>
      <p class="product-card__name-sub">Iberian Acorn-Fed Ham</p>
      <div class="product-card__foot">
        <span class="product-card__price">€89,00</span>
        <a class="product-card__plus" href="#" aria-label="Ver producto">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </a>
      </div>
    </div>
  </article>
{%- endif -%}
