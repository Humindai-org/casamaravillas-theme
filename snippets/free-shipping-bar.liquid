{%- comment -%}
  free-shipping-bar.liquid — barra "te faltan X € para el envío gratis".
  Solo para España y Portugal (el envío gratis es el descuento automático "Envío gratis desde 80 €").
  Umbral en céntimos: debe coincidir con el mínimo de ese descuento (Admin > Descuentos).
  El carrito lateral la actualiza por JS (assets/cart-drawer.js > updateShippingBar).
  Con pdp: true se pinta en la ficha de producto con el mismo criterio que el carrito: lo que falta
  según lo que YA hay en el carrito (no suma el producto de la ficha).
  assets/main-product.js > updatePdpShipbar la recalcula cuando el carrito cambia.
{%- endcomment -%}
{%- assign fs_threshold = 8000 -%}
{%- assign fs_country = localization.country.iso_code -%}
{%- assign fs_eligible = false -%}
{%- if fs_country == 'ES' or fs_country == 'PT' -%}
  {%- assign fs_eligible = true -%}
{%- endif -%}
{%- assign fs_remaining = fs_threshold | minus: cart.total_price -%}
{%- if fs_remaining < 0 -%}{%- assign fs_remaining = 0 -%}{%- endif -%}
{%- assign fs_percent = cart.total_price | times: 100 | divided_by: fs_threshold -%}
{%- if fs_percent > 100 -%}{%- assign fs_percent = 100 -%}{%- endif -%}

{%- if pdp -%}
  <div
    class="cm-shipbar cm-shipbar--pdp{% if fs_remaining == 0 %} is-complete{% endif %}"
    data-cm-shipbar-pdp
    data-threshold="{{ fs_threshold }}"
    data-eligible="{{ fs_eligible }}"
    data-cart-total="{{ cart.total_price }}"
    {% unless fs_eligible %}hidden{% endunless %}
  >
    <p class="cm-shipbar__text" data-cm-shipbar-text>
      {%- if fs_remaining == 0 -%}
        {{ 'cm.shipbar.free_html' | t }}
      {%- else -%}
        {%- assign _fs_rem = fs_remaining | money -%}{{ 'cm.shipbar.remaining_html' | t: amount: _fs_rem }}
      {%- endif -%}
    </p>
    <div class="cm-shipbar__track" role="progressbar" aria-label="{{ 'cm.shipbar.progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_percent }}">
      <div class="cm-shipbar__fill" data-cm-shipbar-fill style="width: {{ fs_percent }}%"></div>
    </div>
    <p class="cm-shipbar__goal">{%- assign _fs_goal = fs_threshold | money_without_trailing_zeros -%}{{ 'cm.shipbar.goal' | t: amount: _fs_goal }}</p>
  </div>
{%- else -%}
<div
  class="cm-shipbar{% if fs_remaining == 0 %} is-complete{% endif %}"
  data-cm-shipbar
  data-threshold="{{ fs_threshold }}"
  data-eligible="{{ fs_eligible }}"
  {% unless fs_eligible and cart.item_count > 0 %}hidden{% endunless %}
>
  <p class="cm-shipbar__text" data-cm-shipbar-text>
    {%- if fs_remaining == 0 -%}
      {{ 'cm.shipbar.free_html' | t }}
    {%- else -%}
      {%- assign _fs_rem = fs_remaining | money -%}{{ 'cm.shipbar.remaining_html' | t: amount: _fs_rem }}
    {%- endif -%}
  </p>
  <div class="cm-shipbar__track" role="progressbar" aria-label="{{ 'cm.shipbar.progress' | t }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ fs_percent }}">
    <div class="cm-shipbar__fill" data-cm-shipbar-fill style="width: {{ fs_percent }}%"></div>
  </div>
</div>
{%- endif -%}
