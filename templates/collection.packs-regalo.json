            "tagline": "Envío gratis desde 99 € a la Península",
            "cta_label": "VER LOS PACKS",
            "cta_url": "#packs",
            "image_pos_x": 25,
            "image_pos_y": 50
          }
        }
      },
      "block_order": [
        "slide_packs"
      ],
      "settings": {
        "overlay_style": "navy"
      }
    },
    "packs": {
      "type": "rejilla-coleccion",
      "settings": {
        "exclude_tag": "con-alcohol",
